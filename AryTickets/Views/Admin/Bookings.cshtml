@using AryTickets.Models
@model List<AryTickets.Models.Booking>
@{
    ViewData["Title"] = "Admin - Bookings";
    Layout = "_Layout";
    var totalRevenue = Model?.Sum(b => b.TotalPrice) ?? 0;
    var totalBookings = Model?.Count ?? 0;
}

<style>
    .admin-sidebar {
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        width: 240px;
        background: #141416;
        border-right: 1px solid rgba(255,255,255,0.06);
        padding-top: 32px;
        z-index: 40;
        font-family: 'Outfit', sans-serif;
    }

    .admin-sidebar .sidebar-brand {
        padding: 0 24px 32px 24px;
        font-size: 20px;
        font-weight: 700;
        color: #e11d48;
        letter-spacing: -0.5px;
    }

    .admin-sidebar a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 24px;
        color: #a1a1aa;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.2s ease;
        border-left: 3px solid transparent;
    }

    .admin-sidebar a:hover {
        color: #fff;
        background: rgba(225,29,72,0.06);
    }

    .admin-sidebar a.active {
        color: #e11d48;
        background: rgba(225,29,72,0.08);
        border-left-color: #e11d48;
    }

    .admin-sidebar a svg {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
    }

    .admin-main {
        margin-left: 240px;
        min-height: 100vh;
        background: #09090b;
        padding: 40px 48px;
        font-family: 'Outfit', sans-serif;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 32px;
    }

    .stat-card {
        background: #141416;
        border-radius: 12px;
        padding: 24px;
        border-top: 2px solid #e11d48;
    }

    .stat-card .stat-value {
        font-size: 32px;
        font-weight: 700;
        color: #fff;
        font-family: 'Outfit', sans-serif;
    }

    .stat-card .stat-label {
        font-size: 13px;
        color: #71717a;
        margin-top: 4px;
        font-family: 'Outfit', sans-serif;
    }

    .bookings-panel {
        background: #141416;
        border-radius: 16px;
        overflow: hidden;
    }

    .bookings-table {
        width: 100%;
        border-collapse: collapse;
        font-family: 'Outfit', sans-serif;
    }

    .bookings-table thead th {
        padding: 14px 20px;
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        color: #71717a;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        background: rgba(9,9,11,0.4);
    }

    .bookings-table tbody tr {
        transition: background 0.15s ease;
    }

    .bookings-table tbody tr:hover {
        background: rgba(225,29,72,0.04);
    }

    .bookings-table tbody td {
        padding: 14px 20px;
        font-size: 14px;
        color: #d4d4d8;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        vertical-align: middle;
    }

    .bookings-table .user-cell .user-name {
        font-weight: 600;
        color: #fff;
        font-size: 14px;
    }

    .bookings-table .user-cell .user-email {
        font-size: 12px;
        color: #71717a;
        margin-top: 2px;
    }

    .bookings-table .price-accent {
        color: #e11d48;
        font-weight: 700;
    }

    .bookings-table .id-cell {
        color: #52525b;
        font-size: 13px;
        font-weight: 500;
    }

    .btn-delete {
        background: transparent;
        border: 1px solid rgba(225,29,72,0.3);
        color: #e11d48;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        font-family: 'Outfit', sans-serif;
        transition: all 0.2s ease;
    }

    .btn-delete:hover {
        background: rgba(225,29,72,0.12);
        border-color: #e11d48;
    }

    .badge-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(225,29,72,0.15);
        color: #e11d48;
        font-size: 13px;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 999px;
        margin-left: 12px;
    }

    .empty-state {
        text-align: center;
        padding: 64px 24px;
        color: #52525b;
        font-size: 15px;
        font-family: 'Outfit', sans-serif;
    }

    .empty-state svg {
        width: 48px;
        height: 48px;
        margin: 0 auto 16px;
        color: #3f3f46;
    }

    @@media (max-width: 1024px) {
        .admin-sidebar {
            width: 200px;
        }
        .admin-main {
            margin-left: 200px;
            padding: 24px;
        }
    }

    @@media (max-width: 768px) {
        .admin-sidebar {
            position: relative;
            width: 100%;
            padding-top: 16px;
            padding-bottom: 8px;
        }
        .admin-sidebar a {
            display: inline-flex;
            padding: 8px 16px;
        }
        .admin-main {
            margin-left: 0;
            padding: 20px 16px;
        }
        .stats-row {
            grid-template-columns: 1fr;
        }
        .bookings-panel {
            overflow-x: auto;
        }
        .bookings-table {
            min-width: 700px;
        }
    }
</style>

<!-- Admin Sidebar -->
<nav class="admin-sidebar">
    <div class="sidebar-brand">AryTickets Admin</div>

    <a href="/Admin">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1" />
        </svg>
        Dashboard
    </a>

    <a href="/Admin/Users">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m9.12 0a4 4 0 10-5.24 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Users
    </a>

    <a href="/Admin/Bookings" class="active">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
        </svg>
        Bookings
    </a>

    <a href="/Admin/Applications">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15a2.25 2.25 0 012.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" />
        </svg>
        Applications
    </a>
</nav>

<!-- Main Content -->
<div class="admin-main">
    <div style="display: flex; align-items: center; margin-bottom: 32px;">
        <h1 style="font-size: 28px; font-weight: 700; color: #fff; font-family: 'Outfit', sans-serif; margin: 0;">
            Bookings
        </h1>
        <span class="badge-count">@totalBookings</span>
    </div>

    <!-- Stats Row -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-value">@totalBookings</div>
            <div class="stat-label">Total Bookings</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@totalRevenue.ToString("C2")</div>
            <div class="stat-label">Total Revenue</div>
        </div>
    </div>

    <!-- Bookings Table -->
    <div class="bookings-panel">
        @if (Model != null && Model.Count > 0)
        {
            <table class="bookings-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>User</th>
                        <th>Movie</th>
                        <th>Showtime</th>
                        <th>Seats</th>
                        <th>Total</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td class="id-cell">#@booking.Id</td>
                            <td>
                                <div class="user-cell">
                                    <div class="user-name">@booking.UserName</div>
                                    <div class="user-email">@booking.UserEmail</div>
                                </div>
                            </td>
                            <td>@booking.MovieTitle</td>
                            <td>@booking.Showtime</td>
                            <td>@booking.Seats</td>
                            <td class="price-accent">@booking.TotalPrice.ToString("C2")</td>
                            <td>@booking.BookedAt.ToString("MMM dd, yyyy — HH:mm")</td>
                            <td>
                                <form asp-action="DeleteBooking" asp-controller="Admin" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@booking.Id" />
                                    <button type="submit" class="btn-delete" onclick="return confirm('Are you sure you want to delete this booking?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                </svg>
                <p style="font-weight: 600; color: #71717a; margin-bottom: 4px;">No bookings yet</p>
                <p style="font-size: 13px;">Bookings will appear here once customers start purchasing tickets.</p>
            </div>
        }
    </div>
</div>
