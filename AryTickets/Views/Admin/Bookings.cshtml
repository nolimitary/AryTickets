@using AryTickets.Models
@model List<AryTickets.Models.Booking>
@{
    ViewData["Title"] = "Резервации";
    Layout = "_Layout";
    var totalRevenue = Model?.Sum(b => b.TotalPrice) ?? 0;
    var totalBookings = Model?.Count ?? 0;
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
}

@await Html.PartialAsync("_AdminSidebar")

<div class="admin-main">
    <div class="flex items-end justify-between mb-10 flex-wrap gap-3">
        <div>
            <span class="text-[11px] font-sans tracking-[0.3em] uppercase text-gold-400">Каса</span>
            <h1 class="font-serif text-4xl font-semibold text-ivory-100 mt-1">Резервации</h1>
            <p class="font-garamond italic text-ivory-300/70 mt-1">Всички издадени театрални билети</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-10">
        <div class="stat-card">
            <p class="text-[10px] font-sans tracking-[0.2em] uppercase text-gold-400">Резервации общо</p>
            <p class="font-serif text-4xl font-semibold text-ivory-100 mt-2">@totalBookings.ToString("N0")</p>
        </div>
        <div class="stat-card">
            <p class="text-[10px] font-sans tracking-[0.2em] uppercase text-gold-400">Общи приходи</p>
            <p class="font-serif text-4xl font-semibold text-gold-400 mt-2">@totalRevenue.ToString("N2") лв.</p>
        </div>
    </div>

    <div class="panel overflow-hidden">
        @if (Model != null && Model.Count > 0)
        {
            <div class="overflow-x-auto">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>№</th>
                            <th>Зрител</th>
                            <th>Пиеса</th>
                            <th>Представление</th>
                            <th>Места</th>
                            <th>Сума</th>
                            <th>Дата</th>
                            <th class="text-right">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td class="text-gold-500/60 font-mono text-sm">#@b.Id</td>
                                <td>
                                    <p class="font-serif text-ivory-100">@b.UserName</p>
                                    <p class="text-[11px] font-sans text-gold-500/60 mt-0.5">@b.UserEmail</p>
                                </td>
                                <td class="font-serif">@b.ProductionTitle</td>
                                <td class="font-garamond italic">@b.PerformanceDateTime</td>
                                <td><span class="inline-flex px-2 py-0.5 rounded-sm bg-burgundy-800/40 text-[12px] font-mono text-gold-300">@b.Seats</span></td>
                                <td class="font-serif text-gold-400">@b.TotalPrice.ToString("N2") лв.</td>
                                <td class="text-[12px] text-gold-500/70">@b.BookedAt.ToString("dd MMM yyyy · HH:mm")</td>
                                <td class="text-right">
                                    <form asp-action="DeleteBooking" asp-controller="Admin" method="post" class="inline" onsubmit="return confirm('Сигурни ли сте, че искате да изтриете тази резервация?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <button type="submit" class="admin-btn-danger">Изтрий</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-16">
                <p class="font-serif text-xl text-ivory-100 mb-2">Все още няма резервации</p>
                <p class="font-garamond italic text-ivory-300/60">Резервациите ще се появят тук след първите продажби.</p>
            </div>
        }
    </div>
</div>
