@model AryTickets.Models.AnalyticsViewModel
@{
    ViewData["Title"] = "Analytics";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .admin-sidebar {
            position: fixed;
            top: 72px;
            left: 0;
            bottom: 0;
            width: 240px;
            background: #141416;
            border-right: 1px solid rgba(255,255,255,0.06);
            z-index: 40;
            padding: 28px 0;
            overflow-y: auto;
        }
        .admin-main {
            margin-left: 240px;
            padding: 104px 40px 60px 40px;
            min-height: 100vh;
        }
        .admin-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 24px;
            font-size: 14px;
            color: #a1a1aa;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        .admin-nav-link:hover { color: #fff; background: rgba(255,255,255,0.03); }
        .admin-nav-link.active { color: #fff; background: rgba(225,29,72,0.06); border-left-color: #e11d48; }
        .admin-nav-link.active svg { color: #e11d48; }

        .stat-card {
            background: #141416;
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 16px;
            padding: 24px;
            transition: all 0.25s ease;
        }
        .stat-card:hover {
            border-color: rgba(225,29,72,0.15);
            transform: translateY(-2px);
        }

        .chart-card {
            background: #141416;
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 16px;
            padding: 24px;
        }
        .chart-card h3 {
            font-size: 14px;
            font-weight: 600;
            color: #fff;
            margin-bottom: 4px;
        }
        .chart-card p {
            font-size: 11px;
            color: #71717a;
            margin-bottom: 20px;
        }

        @@media (max-width: 768px) {
            .admin-sidebar { display: none; }
            .admin-main { margin-left: 0; padding: 100px 16px 40px 16px; }
        }
    </style>
}

<!-- Admin Sidebar -->
<aside class="admin-sidebar">
    <div class="px-6 mb-8">
        <div class="flex items-center gap-2.5">
            <div class="w-2 h-2 rounded-full bg-accent-500 animate-pulse"></div>
            <span class="text-[15px] font-semibold text-white tracking-tight">Admin Panel</span>
        </div>
        <p class="text-[11px] text-zinc-600 mt-1 pl-[18px]">Management Console</p>
    </div>
    <nav class="flex flex-col gap-1">
        <a href="/Admin" class="admin-nav-link">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
            Dashboard
        </a>
        <a href="/Admin/Showtimes" class="admin-nav-link">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            Showtimes
        </a>
        <a href="/Admin/Users" class="admin-nav-link">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
            Users
        </a>
        <a href="/Admin/Bookings" class="admin-nav-link">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" /></svg>
            Bookings
        </a>
        <a href="/Admin/Applications" class="admin-nav-link">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15a2.25 2.25 0 012.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" /></svg>
            Applications
        </a>
        <a href="/Admin/Analytics" class="admin-nav-link active">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
            Analytics
        </a>
    </nav>
    <div class="mt-auto px-6 pt-8">
        <div class="border-t border-white/[0.06] pt-5">
            <a href="/" class="flex items-center gap-2 text-xs text-zinc-600 hover:text-zinc-400 transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" /></svg>
                Back to Site
            </a>
        </div>
    </div>
</aside>

<div class="admin-main">
    <div class="mb-10">
        <h1 class="text-[28px] font-bold text-white tracking-tight">Analytics</h1>
        <p class="text-sm text-zinc-500 mt-1">Revenue and booking insights</p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
        <div class="stat-card">
            <p class="text-[11px] font-medium text-zinc-500 uppercase tracking-wider">Total Revenue</p>
            <p class="text-[32px] font-bold text-white mt-1 leading-none">$@Model.TotalRevenue.ToString("N2")</p>
            <p class="text-[11px] text-zinc-600 mt-3">Lifetime earnings</p>
        </div>
        <div class="stat-card">
            <p class="text-[11px] font-medium text-zinc-500 uppercase tracking-wider">Total Bookings</p>
            <p class="text-[32px] font-bold text-white mt-1 leading-none">@Model.TotalBookings.ToString("N0")</p>
            <p class="text-[11px] text-zinc-600 mt-3">All time</p>
        </div>
        <div class="stat-card">
            <p class="text-[11px] font-medium text-zinc-500 uppercase tracking-wider">Avg. Order Value</p>
            <p class="text-[32px] font-bold text-white mt-1 leading-none">$@Model.AverageOrderValue.ToString("N2")</p>
            <p class="text-[11px] text-zinc-600 mt-3">Per booking</p>
        </div>
        <div class="stat-card">
            <p class="text-[11px] font-medium text-zinc-500 uppercase tracking-wider">Today's Revenue</p>
            <p class="text-[32px] font-bold text-accent-400 mt-1 leading-none">$@Model.TodayRevenue.ToString("N2")</p>
            <p class="text-[11px] text-zinc-600 mt-3">Current day</p>
        </div>
    </div>

    <!-- Charts -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-10">
        <div class="chart-card">
            <h3>Revenue Over Time</h3>
            <p>Last 30 days</p>
            <canvas id="revenueChart" height="200"></canvas>
        </div>
        <div class="chart-card">
            <h3>Bookings by Movie</h3>
            <p>Top movies by ticket count</p>
            <canvas id="moviesChart" height="200"></canvas>
        </div>
        <div class="chart-card">
            <h3>Peak Days</h3>
            <p>Bookings by day of week</p>
            <canvas id="daysChart" height="200"></canvas>
        </div>
        <div class="chart-card">
            <h3>Revenue by Movie</h3>
            <p>Top grossing movies</p>
            <canvas id="revenueMoviesChart" height="200"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        Chart.defaults.color = '#71717a';
        Chart.defaults.borderColor = 'rgba(255,255,255,0.04)';
        Chart.defaults.font.family = "'Outfit', sans-serif";

        const accentColor = '#e11d48';
        const accentLight = '#fb7185';
        const chartColors = ['#e11d48', '#fb7185', '#f43f5e', '#fda4af', '#fecdd3', '#9f1239', '#be123c', '#881337'];

        // Revenue over time
        new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueDates)),
                datasets: [{
                    label: 'Revenue ($)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueValues)),
                    borderColor: accentColor,
                    backgroundColor: 'rgba(225,29,72,0.1)',
                    fill: true,
                    tension: 0.4,
                    pointRadius: 0,
                    pointHoverRadius: 5,
                    pointHoverBackgroundColor: accentColor,
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { maxTicksLimit: 8, font: { size: 10 } } },
                    y: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { font: { size: 10 }, callback: v => '$' + v } }
                }
            }
        });

        // Bookings by movie
        new Chart(document.getElementById('moviesChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopMovieNames)),
                datasets: [{
                    label: 'Bookings',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopMovieBookings)),
                    backgroundColor: accentColor,
                    borderRadius: 6,
                    barThickness: 28
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { font: { size: 10 } } },
                    y: { grid: { display: false }, ticks: { font: { size: 11 } } }
                }
            }
        });

        // Peak days
        new Chart(document.getElementById('daysChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DayNames)),
                datasets: [{
                    label: 'Bookings',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DayCounts)),
                    backgroundColor: chartColors.slice(0, 7),
                    borderRadius: 8,
                    barThickness: 36
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { size: 11 } } },
                    y: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { font: { size: 10 }, stepSize: 1 } }
                }
            }
        });

        // Revenue by movie (doughnut)
        new Chart(document.getElementById('revenueMoviesChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueMovieNames)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueMovieValues)),
                    backgroundColor: chartColors,
                    borderWidth: 0,
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true,
                cutout: '65%',
                plugins: {
                    legend: {
                        position: 'right',
                        labels: { padding: 12, usePointStyle: true, pointStyle: 'circle', font: { size: 11 } }
                    }
                }
            }
        });
    </script>
}
