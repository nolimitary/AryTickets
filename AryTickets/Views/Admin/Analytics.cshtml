@model AryTickets.Models.AnalyticsViewModel
@{
    ViewData["Title"] = "Анализи";
    Layout = "_Layout";
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    <style>
        .chart-card {
            background: rgba(43, 10, 10, 0.5);
            border: 1px solid rgba(212, 175, 55, 0.15);
            border-radius: 4px;
            padding: 24px;
        }
        .chart-card h3 {
            font-family: 'Playfair Display', serif;
            font-size: 18px;
            font-weight: 600;
            color: #f5e6d3;
            margin-bottom: 4px;
        }
        .chart-card p {
            font-family: 'Cormorant Garamond', serif;
            font-style: italic;
            font-size: 13px;
            color: rgba(212, 175, 55, 0.7);
            margin-bottom: 20px;
        }
    </style>
}

@await Html.PartialAsync("_AdminSidebar")

<div class="admin-main">
    <div class="mb-10">
        <span class="text-[11px] font-sans tracking-[0.3em] uppercase text-gold-400">Преглед</span>
        <h1 class="font-serif text-4xl font-semibold text-ivory-100 mt-1">Анализи</h1>
        <p class="font-garamond italic text-ivory-300/70 mt-1">Приходи, посещаемост и закономерности</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
        <div class="stat-card">
            <p class="text-[10px] font-sans tracking-[0.2em] uppercase text-gold-400">Общи приходи</p>
            <p class="font-serif text-3xl font-semibold text-ivory-100 mt-2">@Model.TotalRevenue.ToString("N2") лв.</p>
            <p class="text-[11px] font-garamond italic text-gold-500/60 mt-3">За цялото време</p>
        </div>
        <div class="stat-card">
            <p class="text-[10px] font-sans tracking-[0.2em] uppercase text-gold-400">Резервации</p>
            <p class="font-serif text-3xl font-semibold text-ivory-100 mt-2">@Model.TotalBookings.ToString("N0")</p>
            <p class="text-[11px] font-garamond italic text-gold-500/60 mt-3">Общо</p>
        </div>
        <div class="stat-card">
            <p class="text-[10px] font-sans tracking-[0.2em] uppercase text-gold-400">Средна стойност</p>
            <p class="font-serif text-3xl font-semibold text-ivory-100 mt-2">@Model.AverageOrderValue.ToString("N2") лв.</p>
            <p class="text-[11px] font-garamond italic text-gold-500/60 mt-3">На резервация</p>
        </div>
        <div class="stat-card">
            <p class="text-[10px] font-sans tracking-[0.2em] uppercase text-gold-400">Дневни приходи</p>
            <p class="font-serif text-3xl font-semibold text-gold-400 mt-2">@Model.TodayRevenue.ToString("N2") лв.</p>
            <p class="text-[11px] font-garamond italic text-gold-500/60 mt-3">Днес</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-10">
        <div class="chart-card">
            <h3>Приходи във времето</h3>
            <p>Последните 30 дни</p>
            <canvas id="revenueChart" height="200"></canvas>
        </div>
        <div class="chart-card">
            <h3>Резервации по постановки</h3>
            <p>Най-посещавани пиеси</p>
            <canvas id="productionsChart" height="200"></canvas>
        </div>
        <div class="chart-card">
            <h3>Пикови дни</h3>
            <p>Резервации по дни от седмицата</p>
            <canvas id="daysChart" height="200"></canvas>
        </div>
        <div class="chart-card">
            <h3>Приходи по постановки</h3>
            <p>Топ касови пиеси</p>
            <canvas id="revenueProductionsChart" height="200"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        Chart.defaults.color = '#c9a961';
        Chart.defaults.borderColor = 'rgba(212,175,55,0.08)';
        Chart.defaults.font.family = "'Cormorant Garamond', Georgia, serif";

        const goldColor = '#d4af37';
        const goldLight = '#e6c45a';
        const chartColors = ['#d4af37', '#c9a961', '#b8860b', '#e6c45a', '#8b6914', '#a83838', '#722f37', '#8b1a1a'];

        new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueDates)),
                datasets: [{
                    label: 'Приходи (лв.)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueValues)),
                    borderColor: goldColor,
                    backgroundColor: 'rgba(212,175,55,0.12)',
                    fill: true,
                    tension: 0.4,
                    pointRadius: 0,
                    pointHoverRadius: 5,
                    pointHoverBackgroundColor: goldColor,
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { maxTicksLimit: 8, font: { size: 11 } } },
                    y: { grid: { color: 'rgba(212,175,55,0.05)' }, ticks: { font: { size: 11 }, callback: v => v + ' лв.' } }
                }
            }
        });

        new Chart(document.getElementById('productionsChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopProductionNames)),
                datasets: [{
                    label: 'Резервации',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopProductionBookings)),
                    backgroundColor: goldColor,
                    borderRadius: 2,
                    barThickness: 28
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: 'rgba(212,175,55,0.05)' }, ticks: { font: { size: 11 } } },
                    y: { grid: { display: false }, ticks: { font: { size: 12 } } }
                }
            }
        });

        new Chart(document.getElementById('daysChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DayNames)),
                datasets: [{
                    label: 'Резервации',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DayCounts)),
                    backgroundColor: chartColors.slice(0, 7),
                    borderRadius: 4,
                    barThickness: 36
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { size: 12 } } },
                    y: { grid: { color: 'rgba(212,175,55,0.05)' }, ticks: { font: { size: 11 }, stepSize: 1 } }
                }
            }
        });

        new Chart(document.getElementById('revenueProductionsChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueProductionNames)),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueProductionValues)),
                    backgroundColor: chartColors,
                    borderWidth: 0,
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true,
                cutout: '65%',
                plugins: {
                    legend: {
                        position: 'right',
                        labels: { padding: 12, usePointStyle: true, pointStyle: 'circle', font: { size: 12 } }
                    }
                }
            }
        });
    </script>
}
