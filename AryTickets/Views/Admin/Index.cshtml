@using AryTickets.Models
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";

    var totalUsers = (int)(ViewData["TotalUsers"] ?? 0);
    var totalBookings = (int)(ViewData["TotalBookings"] ?? 0);
    var totalRevenue = Convert.ToDecimal(ViewData["TotalRevenue"] ?? 0);
    var totalFavorites = (int)(ViewData["TotalFavorites"] ?? 0);
    var recentBookings = ViewData["RecentBookings"] as List<Booking> ?? new List<Booking>();
    var recentUsers = ViewData["RecentUsers"] as List<ApplicationUser> ?? new List<ApplicationUser>();
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
}

@await Html.PartialAsync("_AdminSidebar")

<div class="admin-main">
    <div class="mb-10">
        <span class="text-[11px] font-sans tracking-[0.3em] uppercase text-gold-400">Overview</span>
        <h1 class="font-serif text-4xl font-semibold text-ivory-100 mt-1">Dashboard</h1>
        <p class="font-garamond italic text-ivory-300/70 mt-1">Summary of theatre activity</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-12">
        <div class="stat-card">
            <p class="text-[10px] font-sans tracking-[0.2em] uppercase text-gold-400">Users</p>
            <p class="font-serif text-4xl font-semibold text-ivory-100 mt-2">@totalUsers.ToString("N0")</p>
            <p class="text-[12px] font-garamond italic text-gold-500/60 mt-3">Registered viewers</p>
        </div>
        <div class="stat-card">
            <p class="text-[10px] font-sans tracking-[0.2em] uppercase text-gold-400">Bookings</p>
            <p class="font-serif text-4xl font-semibold text-ivory-100 mt-2">@totalBookings.ToString("N0")</p>
            <p class="text-[12px] font-garamond italic text-gold-500/60 mt-3">Tickets issued</p>
        </div>
        <div class="stat-card">
            <p class="text-[10px] font-sans tracking-[0.2em] uppercase text-gold-400">Revenue</p>
            <p class="font-serif text-4xl font-semibold text-gold-400 mt-2">@totalRevenue.ToString("N2") EUR</p>
            <p class="text-[12px] font-garamond italic text-gold-500/60 mt-3">Total revenue</p>
        </div>
        <div class="stat-card">
            <p class="text-[10px] font-sans tracking-[0.2em] uppercase text-gold-400">Favorites</p>
            <p class="font-serif text-4xl font-semibold text-ivory-100 mt-2">@totalFavorites.ToString("N0")</p>
            <p class="text-[12px] font-garamond italic text-gold-500/60 mt-3">Saved productions</p>
        </div>
    </div>

    <div class="panel mb-10 overflow-hidden">
        <div class="px-6 py-5 border-b border-gold-500/15 flex items-center justify-between">
            <div>
                <h2 class="font-serif text-xl text-ivory-100">Latest bookings</h2>
                <p class="text-[11px] font-sans tracking-wider uppercase text-gold-500/70 mt-0.5">Recent purchases</p>
            </div>
            <a href="/Admin/Bookings" class="text-[11px] font-sans tracking-wider uppercase text-gold-400 hover:text-gold-300">View all</a>
        </div>
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Viewer</th>
                        <th>Production</th>
                        <th>Performance</th>
                        <th>Seats</th>
                        <th>Total</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentBookings.Any())
                    {
                        @foreach (var b in recentBookings.Take(10))
                        {
                            <tr>
                                <td>
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-gold-400/15 border border-gold-400/30 flex items-center justify-center flex-shrink-0">
                                            <span class="text-[11px] font-serif font-semibold text-gold-400">@(b.UserName?.Length > 0 ? b.UserName[0].ToString().ToUpper() : "?")</span>
                                        </div>
                                        <div>
                                            <p class="text-sm font-serif text-ivory-100 leading-tight">@b.UserName</p>
                                            <p class="text-[11px] font-sans text-gold-500/60">@b.UserEmail</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="font-serif text-ivory-100">@b.ProductionTitle</td>
                                <td class="font-garamond italic">@b.PerformanceDateTime</td>
                                <td><span class="inline-flex px-2 py-0.5 rounded-sm bg-burgundy-800/40 text-[12px] font-mono text-gold-300">@b.Seats</span></td>
                                <td class="font-serif text-gold-400">@b.TotalPrice.ToString("N2") EUR</td>
                                <td class="text-[12px] text-gold-500/70">@b.BookedAt.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center py-10 font-garamond italic text-ivory-300/50">No bookings yet</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div>
        <div class="flex items-center justify-between mb-5">
            <div>
                <h2 class="font-serif text-xl text-ivory-100">New viewers</h2>
                <p class="text-[11px] font-sans tracking-wider uppercase text-gold-500/70 mt-0.5">Recently registered</p>
            </div>
            <a href="/Admin/Users" class="text-[11px] font-sans tracking-wider uppercase text-gold-400 hover:text-gold-300">View all</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @if (recentUsers.Any())
            {
                @foreach (var u in recentUsers)
                {
                    <div class="panel p-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-gold-400/15 border border-gold-400/40 flex items-center justify-center flex-shrink-0">
                                <span class="text-[14px] font-serif font-semibold text-gold-400">@(u.UserName?.Length > 0 ? u.UserName[0].ToString().ToUpper() : "?")</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="font-serif text-ivory-100 truncate">@u.UserName</p>
                                <p class="text-[11px] font-sans text-gold-500/60 truncate">@u.Email</p>
                            </div>
                            @if (u.EmailConfirmed)
                            {
                                <span class="badge-confirmed">Confirmed</span>
                            }
                            else
                            {
                                <span class="badge-pending">Pending</span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-span-full text-center py-10 font-garamond italic text-ivory-300/50">No users yet</div>
            }
        </div>
    </div>
</div>
