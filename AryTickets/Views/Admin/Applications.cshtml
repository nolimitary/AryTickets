@using AryTickets.Models
@model List<AryTickets.Models.CriticApplication>
@{
    ViewData["Title"] = "Critic applications";
    Layout = "_Layout";
    var currentFilter = ViewData["CurrentFilter"] as string ?? "pending";
    var pendingCount = (int)(ViewData["PendingCount"] ?? 0);
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
    <style>
        .filter-tab {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 0.55rem 1.2rem;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: rgba(245, 230, 211, 0.6);
            border: 1px solid rgba(212, 175, 55, 0.15);
            border-radius: 2px;
            transition: all 0.25s ease;
            text-decoration: none;
        }
        .filter-tab:hover {
            color: #f5e6d3;
            border-color: rgba(212, 175, 55, 0.35);
            background: rgba(212, 175, 55, 0.03);
        }
        .filter-tab.active {
            color: #1a0606;
            background: linear-gradient(135deg, #d4af37 0%, #b8860b 100%);
            border-color: #d4af37;
        }
        .filter-tab .count-badge {
            font-size: 10px;
            padding: 1px 6px;
            border-radius: 999px;
            background: rgba(212, 175, 55, 0.15);
            color: #d4af37;
        }
        .filter-tab.active .count-badge {
            background: rgba(26, 6, 6, 0.25);
            color: #1a0606;
        }
        .badge-approved {
            display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px;
            font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 500;
            letter-spacing: 0.1em; text-transform: uppercase;
            background: rgba(212, 175, 55, 0.15); color: #d4af37;
            border: 1px solid rgba(212, 175, 55, 0.3); border-radius: 2px;
        }
        .badge-denied {
            display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px;
            font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 500;
            letter-spacing: 0.1em; text-transform: uppercase;
            background: rgba(139, 26, 26, 0.25); color: #d36b6b;
            border: 1px solid rgba(168, 56, 56, 0.4); border-radius: 2px;
        }
    </style>
}

@await Html.PartialAsync("_AdminSidebar")

<div class="admin-main">
    <div class="mb-10">
        <span class="text-[11px] font-sans tracking-[0.3em] uppercase text-gold-400">Audience</span>
        <h1 class="font-serif text-4xl font-semibold text-ivory-100 mt-1">Critic applications</h1>
        <p class="font-garamond italic text-ivory-300/70 mt-1">Review applications for critic status</p>
    </div>

    <div class="flex items-center gap-3 mb-8 flex-wrap">
        <a href="/Admin/Applications?filter=pending" class="filter-tab @(currentFilter == "pending" ? "active" : "")">
            Pending <span class="count-badge">@pendingCount</span>
        </a>
        <a href="/Admin/Applications?filter=approved" class="filter-tab @(currentFilter == "approved" ? "active" : "")">Approved</a>
        <a href="/Admin/Applications?filter=denied" class="filter-tab @(currentFilter == "denied" ? "active" : "")">Denied</a>
        <a href="/Admin/Applications?filter=all" class="filter-tab @(currentFilter == "all" ? "active" : "")">All</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="flex flex-col gap-5">
            @foreach (var app in Model)
            {
                <div class="panel p-6">
                    <div class="flex items-start justify-between mb-5 flex-wrap gap-3">
                        <div class="flex items-center gap-3">
                            <div class="w-11 h-11 rounded-full bg-gold-400/12 border border-gold-400/35 flex items-center justify-center flex-shrink-0">
                                <span class="font-serif font-semibold text-gold-400">@(app.FullName?.Length > 0 ? app.FullName[0].ToString().ToUpper() : "?")</span>
                            </div>
                            <div>
                                <p class="font-serif text-lg text-ivory-100">@app.FullName</p>
                                <div class="flex items-center gap-2 mt-0.5 flex-wrap">
                                    <span class="text-[12px] font-sans text-gold-500/70">@@@app.User?.UserName</span>
                                    <span class="text-gold-500/30">•</span>
                                    <span class="text-[12px] font-sans text-gold-500/70">@app.User?.Email</span>
                                    <span class="text-gold-500/30">•</span>
                                    <span class="text-[12px] font-sans text-gold-500/60 italic">submitted on @app.AppliedAt.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                        </div>
                        <div>
                            @if (app.Status == ApplicationStatus.Pending) { <span class="badge-pending">Pending</span> }
                            else if (app.Status == ApplicationStatus.Approved) { <span class="badge-approved">Approved</span> }
                            else { <span class="badge-denied">Denied</span> }
                        </div>
                    </div>

                    <div class="mb-4">
                        <p class="text-[10px] font-sans tracking-[0.22em] uppercase text-gold-400 mb-1.5">Bio</p>
                        <p class="font-garamond text-ivory-200/85 text-[15px] leading-relaxed">@app.Bio</p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                        <div>
                            <p class="text-[10px] font-sans tracking-[0.22em] uppercase text-gold-400 mb-1.5">Experience</p>
                            <p class="font-garamond text-ivory-200/85">@app.YearsOfExperience year@(app.YearsOfExperience == 1 ? "" : "s")</p>
                        </div>
                        <div>
                            <p class="text-[10px] font-sans tracking-[0.22em] uppercase text-gold-400 mb-1.5">Past employers</p>
                            <p class="font-garamond text-ivory-200/85">@app.PastEmployers</p>
                        </div>
                    </div>

                    @if (app.ReviewLinks != null && app.ReviewLinks.Any())
                    {
                        <div class="mb-4">
                            <p class="text-[10px] font-sans tracking-[0.22em] uppercase text-gold-400 mb-1.5">Published links</p>
                            <div class="flex flex-wrap gap-3">
                                @for (var i = 0; i < app.ReviewLinks.Count; i++)
                                {
                                    <a href="@app.ReviewLinks[i]" target="_blank" rel="noopener noreferrer" class="text-[13px] font-garamond italic text-gold-400 hover:text-gold-300 underline-offset-2 hover:underline">Review @(i + 1) ↗</a>
                                }
                            </div>
                        </div>
                    }

                    <div class="mb-5">
                        <p class="text-[10px] font-sans tracking-[0.22em] uppercase text-gold-400 mb-1.5">Motivation</p>
                        <p class="font-garamond text-ivory-200/85 text-[15px] leading-relaxed">@app.Motivation</p>
                    </div>

                    @if (app.Status == ApplicationStatus.Pending)
                    {
                        <div class="flex items-center gap-3 pt-4 border-t border-gold-500/15">
                            <form asp-action="ApproveApplication" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@app.Id" />
                                <button type="submit" class="admin-btn-primary" onclick="return confirm('Approve this application?');">Approve</button>
                            </form>
                            <form asp-action="DenyApplication" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@app.Id" />
                                <button type="submit" class="admin-btn-danger" onclick="return confirm('Deny this application?');">Deny</button>
                            </form>
                        </div>
                    }

                    @if (app.ReviewedAt.HasValue)
                    {
                        <div class="pt-3 mt-3 border-t border-gold-500/15">
                            <p class="text-[11px] font-sans text-gold-500/60 italic">Reviewed on @app.ReviewedAt.Value.ToString("dd MMM yyyy 'at' HH:mm")</p>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="panel p-16 text-center">
            <p class="font-serif text-xl text-ivory-100 mb-2">No applications</p>
            @{
                var emptyMsg = currentFilter switch
                {
                    "pending" => "There are no applications to review.",
                    "approved" => "No applications have been approved yet.",
                    "denied" => "No applications have been denied.",
                    _ => "No critic applications submitted yet."
                };
            }
            <p class="font-garamond italic text-ivory-300/60">@emptyMsg</p>
        </div>
    }
</div>
