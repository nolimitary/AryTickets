@model List<AryTickets.Models.Showtime>
@{
    ViewData["Title"] = "Showtime Management";
    Layout = "_Layout";
    var grouped = Model.GroupBy(s => new { s.TmdbMovieId, s.MovieTitle, s.PosterPath }).OrderBy(g => g.Key.MovieTitle).ToList();
}

@section Styles {
    <style>
        .admin-sidebar {
            position: fixed;
            top: 72px;
            left: 0;
            bottom: 0;
            width: 240px;
            background: #141416;
            border-right: 1px solid rgba(255,255,255,0.06);
            z-index: 40;
            padding: 28px 0;
            overflow-y: auto;
        }
        .admin-main {
            margin-left: 240px;
            padding: 104px 40px 60px 40px;
            min-height: 100vh;
        }
        .admin-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 24px;
            font-size: 14px;
            color: #a1a1aa;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        .admin-nav-link:hover { color: #fff; background: rgba(255,255,255,0.03); }
        .admin-nav-link.active { color: #fff; background: rgba(225,29,72,0.06); border-left-color: #e11d48; }
        .admin-nav-link.active svg { color: #e11d48; }

        /* Search */
        .search-box {
            background: #0c0c0e;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 14px 18px;
            color: #fff;
            font-size: 15px;
            width: 100%;
            outline: none;
            transition: all 0.25s;
        }
        .search-box:focus {
            border-color: rgba(225,29,72,0.4);
            box-shadow: 0 0 0 3px rgba(225,29,72,0.08);
        }
        .search-box::placeholder { color: #3f3f46; }

        .search-results {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 12px;
            margin-top: 16px;
        }
        .search-card {
            background: #141416;
            border: 2px solid rgba(255,255,255,0.04);
            border-radius: 12px;
            overflow: hidden;
            cursor: pointer;
            transition: all 0.25s;
        }
        .search-card:hover {
            border-color: rgba(225,29,72,0.3);
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(0,0,0,0.4);
        }
        .search-card.selected {
            border-color: #e11d48;
            box-shadow: 0 0 20px rgba(225,29,72,0.2);
        }
        .search-card img {
            width: 100%;
            aspect-ratio: 2/3;
            object-fit: cover;
        }
        .search-card-info {
            padding: 8px 10px;
        }
        .search-card-info h4 {
            font-size: 12px;
            font-weight: 600;
            color: #fff;
            line-height: 1.3;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .search-card-info span {
            font-size: 11px;
            color: #52525b;
        }

        /* Schedule form */
        .schedule-panel {
            background: #141416;
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 16px;
            padding: 28px;
            margin-top: 20px;
        }
        .schedule-panel.hidden { display: none; }

        .time-slot {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #0c0c0e;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 8px;
            padding: 6px 12px;
            font-size: 13px;
            color: #fff;
        }
        .time-slot .remove-slot {
            cursor: pointer;
            color: #71717a;
            transition: color 0.2s;
        }
        .time-slot .remove-slot:hover { color: #e11d48; }

        .field-label {
            display: block;
            font-size: 12px;
            color: #71717a;
            margin-bottom: 6px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }
        .field-input {
            width: 100%;
            background: #0c0c0e;
            border: 1px solid rgba(255,255,255,0.08);
            color: #fff;
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .field-input:focus {
            border-color: rgba(225,29,72,0.4);
            box-shadow: 0 0 0 3px rgba(225,29,72,0.08);
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 24px;
            background: #e11d48;
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-primary:hover { background: #be123c; transform: translateY(-1px); box-shadow: 0 8px 20px rgba(225,29,72,0.25); }
        .btn-primary:disabled { opacity: 0.4; cursor: not-allowed; transform: none; box-shadow: none; }

        /* Movie showtime cards */
        .movie-showtime-card {
            background: #141416;
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.25s;
        }
        .movie-showtime-card:hover {
            border-color: rgba(225,29,72,0.12);
        }

        .showtime-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #0c0c0e;
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 8px;
            padding: 8px 14px;
            font-size: 13px;
            color: #d4d4d8;
            transition: all 0.2s;
        }
        .showtime-chip:hover { border-color: rgba(225,29,72,0.2); }

        .delete-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            border-radius: 6px;
            background: rgba(239,68,68,0.1);
            color: #ef4444;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            flex-shrink: 0;
        }
        .delete-btn:hover { background: rgba(239,68,68,0.2); }

        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: #141416;
            border-radius: 16px;
            border: 1px dashed rgba(255,255,255,0.08);
        }

        @@media (max-width: 768px) {
            .admin-sidebar { display: none; }
            .admin-main { margin-left: 0; padding: 100px 16px 40px 16px; }
        }
    </style>
}

<!-- Admin Sidebar -->
<aside class="admin-sidebar">
    <div class="px-6 mb-8">
        <div class="flex items-center gap-2.5">
            <div class="w-2 h-2 rounded-full bg-accent-500 animate-pulse"></div>
            <span class="text-[15px] font-semibold text-white tracking-tight">Admin Panel</span>
        </div>
        <p class="text-[11px] text-zinc-600 mt-1 pl-[18px]">Management Console</p>
    </div>
    <nav class="flex flex-col gap-1">
        <a href="/Admin" class="admin-nav-link">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
            Dashboard
        </a>
        <a href="/Admin/Showtimes" class="admin-nav-link active">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            Showtimes
        </a>
        <a href="/Admin/Users" class="admin-nav-link">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
            Users
        </a>
        <a href="/Admin/Bookings" class="admin-nav-link">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" /></svg>
            Bookings
        </a>
        <a href="/Admin/Applications" class="admin-nav-link">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15a2.25 2.25 0 012.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" /></svg>
            Applications
        </a>
        <a href="/Admin/Analytics" class="admin-nav-link">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
            Analytics
        </a>
    </nav>
    <div class="mt-auto px-6 pt-8">
        <div class="border-t border-white/[0.06] pt-5">
            <a href="/" class="flex items-center gap-2 text-xs text-zinc-600 hover:text-zinc-400 transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" /></svg>
                Back to Site
            </a>
        </div>
    </div>
</aside>

<div class="admin-main">
    <!-- Header -->
    <div class="mb-10">
        <h1 class="text-[28px] font-bold text-white tracking-tight">Showtime Management</h1>
        <p class="text-sm text-zinc-500 mt-1">Search for movies and schedule showtimes</p>
    </div>

    <!-- ═══ ADD SHOWTIME ═══ -->
    <div class="mb-12">
        <div class="flex items-center gap-3 mb-5">
            <div class="w-8 h-8 rounded-lg bg-accent-500/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-accent-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            </div>
            <h2 class="text-lg font-semibold text-white">Add New Showtime</h2>
        </div>

        <div class="relative">
            <svg class="w-5 h-5 text-zinc-600 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
            <input id="movieSearch" type="text" class="search-box" style="padding-left: 44px;" placeholder="Search for a movie to add showtimes..." autocomplete="off" />
            <div id="searchSpinner" class="absolute right-4 top-1/2 -translate-y-1/2 hidden">
                <svg class="w-5 h-5 text-accent-500 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            </div>
        </div>

        <div id="searchResults" class="search-results"></div>

        <!-- Schedule form (hidden until movie selected) -->
        <div id="schedulePanel" class="schedule-panel hidden">
            <form asp-action="CreateShowtime" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="selectedMovieId" name="tmdbMovieId" />
                <input type="hidden" id="selectedMovieTitle" name="movieTitle" />
                <input type="hidden" id="selectedPosterPath" name="posterPath" />
                <input type="hidden" id="showtimesInput" name="showtimes" />

                <div class="flex items-center gap-4 mb-6">
                    <img id="selectedPoster" src="" class="w-16 h-24 object-cover rounded-lg" />
                    <div>
                        <h3 id="selectedTitle" class="text-lg font-semibold text-white"></h3>
                        <p class="text-xs text-zinc-500 mt-1">Configure showtimes below</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-5">
                    <div>
                        <label class="field-label">Date & Time</label>
                        <input id="datetimeInput" type="datetime-local" class="field-input" />
                    </div>
                    <div>
                        <label class="field-label">Hall / Screen</label>
                        <select name="hall" class="field-input">
                            <option value="Hall 1">Hall 1</option>
                            <option value="Hall 2">Hall 2</option>
                            <option value="Hall 3">Hall 3</option>
                            <option value="IMAX">IMAX</option>
                            <option value="VIP Screen">VIP Screen</option>
                        </select>
                    </div>
                    <div>
                        <label class="field-label">Ticket Price ($)</label>
                        <input type="number" name="price" value="12.50" step="0.50" min="1" class="field-input" />
                    </div>
                </div>

                <div class="flex items-center gap-3 mb-5">
                    <button type="button" id="addSlotBtn" class="inline-flex items-center gap-2 px-4 py-2 bg-white/[0.04] border border-white/[0.08] text-white text-sm font-medium rounded-lg hover:bg-white/[0.08] transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                        Add Time Slot
                    </button>
                </div>

                <div id="timeSlots" class="flex flex-wrap gap-2 mb-6"></div>

                <button type="submit" id="submitShowtimes" class="btn-primary" disabled>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                    Save Showtimes
                </button>
            </form>
        </div>
    </div>

    <!-- ═══ EXISTING SHOWTIMES ═══ -->
    <div>
        <div class="flex items-center gap-3 mb-5">
            <div class="w-8 h-8 rounded-lg bg-accent-500/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-accent-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h2 class="text-lg font-semibold text-white">Scheduled Showtimes</h2>
            <span class="text-xs px-2.5 py-1 rounded-full bg-accent-500/10 text-accent-400 border border-accent-500/20 font-medium">@Model.Count total</span>
        </div>

        @if (grouped.Any())
        {
            <div class="space-y-5">
                @foreach (var group in grouped)
                {
                    <div class="movie-showtime-card">
                        <div class="flex gap-5 p-5">
                            <img src="@(group.Key.PosterPath != null ? $"https://image.tmdb.org/t/p/w200{group.Key.PosterPath}" : "https://placehold.co/200x300/111827/FFFFFF?text=No+Image")"
                                 alt="@group.Key.MovieTitle" class="w-20 h-30 object-cover rounded-lg flex-shrink-0" />
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-3 mb-1">
                                    <a href="/Movie/Details/@group.Key.TmdbMovieId" class="text-[15px] font-semibold text-white hover:text-accent-400 transition-colors">@group.Key.MovieTitle</a>
                                    <span class="text-xs px-2 py-0.5 rounded-full bg-white/[0.04] text-zinc-500">@group.Count() showtimes</span>
                                </div>
                                <div class="flex flex-wrap gap-2 mt-3">
                                    @foreach (var st in group.OrderBy(s => s.ShowDateTime))
                                    {
                                        <div class="showtime-chip">
                                            <div>
                                                <span class="text-white font-medium">@st.FormattedTime</span>
                                                <span class="text-zinc-500 text-xs ml-1">@st.FormattedDate</span>
                                                <span class="text-zinc-600 text-xs ml-1">@st.Hall</span>
                                                <span class="text-accent-400 text-xs ml-1">$@st.Price.ToString("F2")</span>
                                            </div>
                                            <form asp-action="DeleteShowtime" method="post" class="inline" onsubmit="return confirm('Remove this showtime?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@st.Id" />
                                                <button type="submit" class="delete-btn">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <svg class="w-12 h-12 text-zinc-700 mx-auto mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <h3 class="text-lg font-semibold text-white mb-2">No Showtimes Yet</h3>
                <p class="text-zinc-500 text-sm">Search for a movie above to start scheduling showtimes.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('movieSearch');
        const searchResults = document.getElementById('searchResults');
        const searchSpinner = document.getElementById('searchSpinner');
        const schedulePanel = document.getElementById('schedulePanel');
        let searchTimeout;

        // Movie search with debounce
        searchInput.addEventListener('input', () => {
            clearTimeout(searchTimeout);
            const query = searchInput.value.trim();
            if (query.length < 2) { searchResults.innerHTML = ''; return; }
            searchSpinner.classList.remove('hidden');
            searchTimeout = setTimeout(async () => {
                const res = await fetch(`/Admin/SearchMoviesApi?query=${encodeURIComponent(query)}`);
                const movies = await res.json();
                searchSpinner.classList.add('hidden');
                searchResults.innerHTML = movies.map(m => `
                    <div class="search-card" data-id="${m.id}" data-title="${m.title}" data-poster="${m.posterPath || ''}" data-fullposter="${m.fullPosterPath}">
                        <img src="${m.fullPosterPath}" alt="${m.title}" loading="lazy" />
                        <div class="search-card-info">
                            <h4>${m.title}</h4>
                            <span>${m.releaseDate || 'N/A'}</span>
                        </div>
                    </div>
                `).join('');
            }, 350);
        });

        // Select movie
        searchResults.addEventListener('click', (e) => {
            const card = e.target.closest('.search-card');
            if (!card) return;

            document.querySelectorAll('.search-card').forEach(c => c.classList.remove('selected'));
            card.classList.add('selected');

            document.getElementById('selectedMovieId').value = card.dataset.id;
            document.getElementById('selectedMovieTitle').value = card.dataset.title;
            document.getElementById('selectedPosterPath').value = card.dataset.poster;
            document.getElementById('selectedPoster').src = card.dataset.fullposter;
            document.getElementById('selectedTitle').textContent = card.dataset.title;

            schedulePanel.classList.remove('hidden');
            timeSlots = [];
            renderSlots();
        });

        // Time slots
        let timeSlots = [];
        const slotsContainer = document.getElementById('timeSlots');
        const submitBtn = document.getElementById('submitShowtimes');
        const showtimesInput = document.getElementById('showtimesInput');

        document.getElementById('addSlotBtn').addEventListener('click', () => {
            const dt = document.getElementById('datetimeInput').value;
            if (!dt) { alert('Pick a date and time first.'); return; }
            if (timeSlots.includes(dt)) return;
            timeSlots.push(dt);
            renderSlots();
        });

        function renderSlots() {
            slotsContainer.innerHTML = timeSlots.map((dt, i) => {
                const d = new Date(dt);
                const label = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ' - ' + d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
                return `<div class="time-slot">${label}<span class="remove-slot" data-idx="${i}">&times;</span></div>`;
            }).join('');
            showtimesInput.value = timeSlots.join(',');
            submitBtn.disabled = timeSlots.length === 0;
        }

        slotsContainer.addEventListener('click', (e) => {
            if (e.target.classList.contains('remove-slot')) {
                timeSlots.splice(parseInt(e.target.dataset.idx), 1);
                renderSlots();
            }
        });
    </script>
}
