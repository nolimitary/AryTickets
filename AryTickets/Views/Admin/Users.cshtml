@model List<AryTickets.Controllers.AdminUserViewModel>
@using Microsoft.AspNetCore.Identity
@inject UserManager<AryTickets.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Users";
    Layout = "_Layout";
    var currentUser = await UserManager.GetUserAsync(User);
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
}

@await Html.PartialAsync("_AdminSidebar")

<div class="admin-main">
    <div class="flex items-end justify-between mb-10 flex-wrap gap-3">
        <div>
            <span class="text-[11px] font-sans tracking-[0.3em] uppercase text-gold-400">Audience</span>
            <h1 class="font-serif text-4xl font-semibold text-ivory-100 mt-1">Users</h1>
            <p class="font-garamond italic text-ivory-300/70 mt-1">Registered theatregoers</p>
        </div>
        <span class="inline-flex items-center px-3 py-1 rounded-sm bg-gold-400/12 text-gold-400 border border-gold-400/30 font-sans text-[12px] tracking-widest uppercase">@Model.Count users</span>
    </div>

    <div class="panel overflow-hidden">
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Bookings</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td>
                                <p class="font-serif text-ivory-100">@u.UserName</p>
                                <p class="text-[12px] font-sans text-gold-500/60 mt-0.5">@u.Email</p>
                            </td>
                            <td>
                                @if (u.Roles.Contains("Admin"))
                                {
                                    <span class="badge-confirmed">Administrator</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-sm font-sans text-[10px] tracking-widest uppercase bg-burgundy-800/50 text-ivory-300/70 border border-gold-500/15">Viewer</span>
                                }
                            </td>
                            <td><span class="font-serif text-ivory-100">@u.BookingCount</span></td>
                            <td class="text-right">
                                <div class="inline-flex items-center gap-2">
                                    @if (currentUser == null || u.Id != currentUser.Id)
                                    {
                                        <form asp-action="ToggleAdmin" asp-controller="Admin" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <button type="submit" class="admin-btn-primary" style="padding:0.4rem 0.85rem; font-size:10px;">
                                                @(u.Roles.Contains("Admin") ? "Revoke admin" : "Make admin")
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] font-sans tracking-widest uppercase text-gold-500/50 italic">You</span>
                                    }
                                    <form asp-action="ToggleWorker" asp-controller="Admin" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button type="submit" class="admin-btn-primary" style="padding:0.4rem 0.85rem; font-size:10px;">
                                            @(u.Roles.Contains("Worker") ? "Revoke worker" : "Make worker")
                                        </button>
                                    </form>
                                    @if (currentUser != null && u.Id != currentUser.Id)
                                    {
                                        <form asp-action="DeleteUser" asp-controller="Admin" method="post" class="inline" onsubmit="return confirm('Are you sure? This action cannot be undone.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <button type="submit" class="admin-btn-danger">Delete</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="py-16 text-center font-garamond italic text-ivory-300/60">No users.</div>
        }
    </div>
</div>
