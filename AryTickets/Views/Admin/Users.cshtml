@model List<AryTickets.Controllers.AdminUserViewModel>
@using Microsoft.AspNetCore.Identity
@inject UserManager<AryTickets.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = "User Management";
    Layout = "_Layout";
    var currentUser = await UserManager.GetUserAsync(User);
}

@section Styles {
    <style>
        .admin-sidebar-link {
            color: #71717a;
            transition: all 0.2s ease;
            font-family: 'Outfit', sans-serif;
        }
        .admin-sidebar-link:hover {
            color: #fb7185;
            background: rgba(225, 29, 72, 0.05);
        }
        .admin-sidebar-link.active {
            color: #fb7185;
            background: rgba(225, 29, 72, 0.08);
            border-left: 3px solid #e11d48;
        }
        .users-table tbody tr {
            transition: background 0.15s ease;
        }
        .users-table tbody tr:hover {
            background: rgba(225, 29, 72, 0.03);
        }
        .btn-action {
            font-family: 'Outfit', sans-serif;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.375rem 0.75rem;
            border-radius: 0.5rem;
            transition: all 0.2s ease;
            cursor: pointer;
            border: none;
        }
        .btn-toggle {
            background: rgba(225, 29, 72, 0.1);
            color: #fb7185;
        }
        .btn-toggle:hover {
            background: rgba(225, 29, 72, 0.2);
            color: #e11d48;
        }
        .btn-delete {
            background: rgba(239, 68, 68, 0.1);
            color: #f87171;
        }
        .btn-delete:hover {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
        }
    </style>
}

<div style="background-color: #09090b; min-height: 100vh;">
    <div class="flex pt-20">

        <!-- Admin Sidebar -->
        <aside class="hidden lg:block w-64 fixed left-0 top-20 bottom-0 overflow-y-auto" style="background-color: #141416; border-right: 1px solid rgba(255,255,255,0.05);">
            <div class="p-6">
                <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500 mb-6" style="font-family: 'Outfit', sans-serif;">Admin Panel</h2>
                <nav class="space-y-1">
                    <a asp-action="Index" asp-controller="Admin" class="admin-sidebar-link flex items-center space-x-3 py-3 px-4 rounded-lg">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                        <span>Dashboard</span>
                    </a>
                    <a asp-action="Showtimes" asp-controller="Admin" class="admin-sidebar-link flex items-center space-x-3 py-3 px-4 rounded-lg">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span>Showtimes</span>
                    </a>
                    <a asp-action="Users" asp-controller="Admin" class="admin-sidebar-link active flex items-center space-x-3 py-3 px-4 rounded-lg">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                        <span>Users</span>
                    </a>
                    <a asp-action="Bookings" asp-controller="Admin" class="admin-sidebar-link flex items-center space-x-3 py-3 px-4 rounded-lg">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path></svg>
                        <span>Bookings</span>
                    </a>
                    <a asp-action="Applications" asp-controller="Admin" class="admin-sidebar-link flex items-center space-x-3 py-3 px-4 rounded-lg">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15a2.25 2.25 0 012.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z"></path></svg>
                        <span>Applications</span>
                    </a>
                    <a asp-action="Analytics" asp-controller="Admin" class="admin-sidebar-link flex items-center space-x-3 py-3 px-4 rounded-lg">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
                        <span>Analytics</span>
                    </a>
                </nav>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 lg:ml-64 px-6 md:px-10 py-10">

            <!-- Page Header -->
            <div class="flex items-center space-x-4 mb-8">
                <h1 class="text-3xl font-bold text-white" style="font-family: 'Outfit', sans-serif;">User Management</h1>
                <span class="inline-flex items-center justify-center px-3 py-1 rounded-full text-xs font-bold" style="background: rgba(225, 29, 72, 0.15); color: #fb7185; font-family: 'Outfit', sans-serif;">
                    @Model.Count users
                </span>
            </div>

            <!-- Users Table Panel -->
            <div class="rounded-xl overflow-hidden" style="background-color: #141416; border: 1px solid rgba(255,255,255,0.05);">
                <div class="overflow-x-auto">
                    <table class="users-table w-full text-left">
                        <thead>
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.06);">
                                <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-zinc-500" style="font-family: 'Outfit', sans-serif;">User</th>
                                <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-zinc-500" style="font-family: 'Outfit', sans-serif;">Role</th>
                                <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-zinc-500" style="font-family: 'Outfit', sans-serif;">Email Status</th>
                                <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-zinc-500" style="font-family: 'Outfit', sans-serif;">Bookings</th>
                                <th class="px-6 py-4 text-xs font-semibold uppercase tracking-wider text-zinc-500 text-right" style="font-family: 'Outfit', sans-serif;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.03);">
                                    <!-- User -->
                                    <td class="px-6 py-4">
                                        <div>
                                            <p class="text-sm font-semibold text-white" style="font-family: 'Outfit', sans-serif;">@user.UserName</p>
                                            <p class="text-xs text-zinc-500 mt-0.5" style="font-family: 'Outfit', sans-serif;">@user.Email</p>
                                        </div>
                                    </td>
                                    <!-- Role -->
                                    <td class="px-6 py-4">
                                        @if (user.Roles.Contains("Admin"))
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold" style="background: rgba(225, 29, 72, 0.15); color: #fb7185; font-family: 'Outfit', sans-serif;">Admin</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold" style="background: rgba(113, 113, 122, 0.15); color: #a1a1aa; font-family: 'Outfit', sans-serif;">User</span>
                                        }
                                    </td>
                                    <!-- Email Status -->
                                    <td class="px-6 py-4">
                                        @if (user.EmailConfirmed)
                                        {
                                            <span class="inline-flex items-center space-x-1.5 text-xs" style="font-family: 'Outfit', sans-serif;">
                                                <span class="w-2 h-2 rounded-full inline-block" style="background-color: #22c55e;"></span>
                                                <span class="text-zinc-400">Confirmed</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center space-x-1.5 text-xs" style="font-family: 'Outfit', sans-serif;">
                                                <span class="w-2 h-2 rounded-full inline-block" style="background-color: #eab308;"></span>
                                                <span class="text-zinc-400">Pending</span>
                                            </span>
                                        }
                                    </td>
                                    <!-- Bookings -->
                                    <td class="px-6 py-4">
                                        <span class="text-sm text-zinc-300" style="font-family: 'Outfit', sans-serif;">@user.BookingCount</span>
                                    </td>
                                    <!-- Actions -->
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex items-center justify-end space-x-2">
                                            <form asp-action="ToggleAdmin" asp-controller="Admin" method="post" class="inline">
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn-action btn-toggle">
                                                    @(user.Roles.Contains("Admin") ? "Remove Admin" : "Make Admin")
                                                </button>
                                            </form>
                                            @if (currentUser != null && user.Id != currentUser.Id)
                                            {
                                                <form asp-action="DeleteUser" asp-controller="Admin" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.');">
                                                    <input type="hidden" name="userId" value="@user.Id" />
                                                    <button type="submit" class="btn-action btn-delete">Delete</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!Model.Any())
                {
                    <div class="py-16 text-center">
                        <p class="text-zinc-500 text-sm" style="font-family: 'Outfit', sans-serif;">No users found.</p>
                    </div>
                }
            </div>

        </main>
    </div>
</div>
