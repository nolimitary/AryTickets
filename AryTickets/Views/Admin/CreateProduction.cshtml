@model AryTickets.Models.Production
@{
    ViewData["Title"] = "Нова постановка";
    Layout = "_Layout";
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
}

@await Html.PartialAsync("_AdminSidebar")

<div class="admin-main">
    <div class="mb-10">
        <a href="/Admin/Productions" class="text-[11px] font-sans tracking-wider uppercase text-gold-500/70 hover:text-gold-400">← Назад към постановките</a>
        <h1 class="font-serif text-4xl font-semibold text-ivory-100 mt-3">Нова постановка</h1>
        <p class="font-garamond italic text-ivory-300/70 mt-1">Добавете нова пиеса в репертоара</p>
    </div>

    <form asp-action="CreateProduction" method="post" class="panel p-8 max-w-3xl">
        @Html.AntiForgeryToken()
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label asp-for="Title" class="admin-label">Заглавие</label>
                <input asp-for="Title" class="admin-input" placeholder="Хамлет" required>
            </div>
            <div>
                <label asp-for="TitleOriginal" class="admin-label">Оригинално заглавие</label>
                <input asp-for="TitleOriginal" class="admin-input" placeholder="Hamlet">
            </div>
            <div>
                <label asp-for="Playwright" class="admin-label">Автор / Драматург</label>
                <input asp-for="Playwright" class="admin-input" placeholder="Уилям Шекспир">
            </div>
            <div>
                <label asp-for="Director" class="admin-label">Режисьор</label>
                <input asp-for="Director" class="admin-input" placeholder="Иван Добчев">
            </div>
            <div class="md:col-span-2">
                <label asp-for="Cast" class="admin-label">Актьорски състав (разделени със запетая)</label>
                <input asp-for="Cast" class="admin-input" placeholder="Захари Бахаров, Снежина Петрова, Малин Кръстев">
            </div>
            <div>
                <label asp-for="Genre" class="admin-label">Жанр</label>
                <input asp-for="Genre" class="admin-input" placeholder="Трагедия / Комедия / Драма">
            </div>
            <div>
                <label asp-for="DurationMinutes" class="admin-label">Продължителност (минути)</label>
                <input asp-for="DurationMinutes" type="number" class="admin-input" placeholder="180" min="0">
            </div>
            <div class="md:col-span-2">
                <label asp-for="Synopsis" class="admin-label">Синопсис</label>
                <textarea asp-for="Synopsis" class="admin-input" rows="5" required placeholder="Кратко описание на пиесата…"></textarea>
            </div>
            <div class="md:col-span-2">
                <label asp-for="PosterUrl" class="admin-label">URL на постер</label>
                <input asp-for="PosterUrl" class="admin-input" placeholder="https://…">
            </div>
            <div class="md:col-span-2">
                <label asp-for="BackdropUrl" class="admin-label">URL на фоново изображение</label>
                <input asp-for="BackdropUrl" class="admin-input" placeholder="https://…">
            </div>
            <div>
                <label asp-for="TrailerUrl" class="admin-label">YouTube embed URL (трейлър)</label>
                <input asp-for="TrailerUrl" class="admin-input" placeholder="https://www.youtube.com/embed/…">
            </div>
            <div>
                <label asp-for="PremiereDate" class="admin-label">Премиера</label>
                <input asp-for="PremiereDate" type="date" class="admin-input">
            </div>
            <div>
                <label asp-for="Rating" class="admin-label">Оценка (0–10)</label>
                <input asp-for="Rating" type="number" step="0.1" min="0" max="10" class="admin-input" placeholder="8.5">
            </div>
        </div>

        <div class="flex items-center gap-3 mt-8 pt-6 border-t border-gold-500/15">
            <button type="submit" class="admin-btn-primary">Запази постановката</button>
            <a href="/Admin/Productions" class="text-[11px] font-sans tracking-wider uppercase text-ivory-300/70 hover:text-gold-400">Отказ</a>
        </div>
    </form>
</div>
