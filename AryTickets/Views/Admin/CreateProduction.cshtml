@model AryTickets.Models.Production
@{
    ViewData["Title"] = "New production";
    Layout = "_Layout";
}

@section Styles {
    @await Html.PartialAsync("_AdminStyles")
}

@await Html.PartialAsync("_AdminSidebar")

<div class="admin-main">
    <div class="mb-10">
        <a href="/Admin/Productions" class="text-[11px] font-sans tracking-wider uppercase text-gold-500/70 hover:text-gold-400">← Back to productions</a>
        <h1 class="font-serif text-4xl font-semibold text-ivory-100 mt-3">New production</h1>
        <p class="font-garamond italic text-ivory-300/70 mt-1">Add a new play to the repertoire</p>
    </div>

    <form asp-action="CreateProduction" method="post" class="panel p-8 max-w-3xl">
        @Html.AntiForgeryToken()
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label asp-for="Title" class="admin-label">Title</label>
                <input asp-for="Title" class="admin-input" placeholder="Hamlet" required>
            </div>
            <div>
                <label asp-for="TitleOriginal" class="admin-label">Original title</label>
                <input asp-for="TitleOriginal" class="admin-input" placeholder="Hamlet">
            </div>
            <div>
                <label asp-for="Playwright" class="admin-label">Playwright</label>
                <input asp-for="Playwright" class="admin-input" placeholder="William Shakespeare">
            </div>
            <div>
                <label asp-for="Director" class="admin-label">Director</label>
                <input asp-for="Director" class="admin-input" placeholder="Ivan Dobchev">
            </div>
            <div class="md:col-span-2">
                <label asp-for="Cast" class="admin-label">Cast (comma-separated)</label>
                <input asp-for="Cast" class="admin-input" placeholder="Zachary Baharov, Snezhina Petrova, Malin Krastev">
            </div>
            <div>
                <label asp-for="Genre" class="admin-label">Genre</label>
                <input asp-for="Genre" class="admin-input" placeholder="Tragedy / Comedy / Drama">
            </div>
            <div>
                <label asp-for="DurationMinutes" class="admin-label">Duration (minutes)</label>
                <input asp-for="DurationMinutes" type="number" class="admin-input" placeholder="180" min="0">
            </div>
            <div class="md:col-span-2">
                <label asp-for="Synopsis" class="admin-label">Synopsis</label>
                <textarea asp-for="Synopsis" class="admin-input" rows="5" required placeholder="A short description of the play…"></textarea>
            </div>
            <div class="md:col-span-2">
                <label asp-for="PosterUrl" class="admin-label">Poster URL</label>
                <input asp-for="PosterUrl" class="admin-input" placeholder="https://…">
            </div>
            <div class="md:col-span-2">
                <label asp-for="BackdropUrl" class="admin-label">Backdrop URL</label>
                <input asp-for="BackdropUrl" class="admin-input" placeholder="https://…">
            </div>
            <div>
                <label asp-for="TrailerUrl" class="admin-label">YouTube embed URL (trailer)</label>
                <input asp-for="TrailerUrl" class="admin-input" placeholder="https://www.youtube.com/embed/…">
            </div>
            <div>
                <label asp-for="PremiereDate" class="admin-label">Premiere</label>
                <input asp-for="PremiereDate" type="date" class="admin-input">
            </div>
            <div>
                <label asp-for="Rating" class="admin-label">Rating (0–10)</label>
                <input asp-for="Rating" type="number" step="0.1" min="0" max="10" class="admin-input" placeholder="8.5">
            </div>
        </div>

        <div class="flex items-center gap-3 mt-8 pt-6 border-t border-gold-500/15">
            <button type="submit" class="admin-btn-primary">Save production</button>
            <a href="/Admin/Productions" class="text-[11px] font-sans tracking-wider uppercase text-ivory-300/70 hover:text-gold-400">Cancel</a>
        </div>
    </form>
</div>
