@model List<AryTickets.Models.Movie>
@{
    ViewData["Title"] = "Search Results";
    var query = ViewData["SearchQuery"]?.ToString() ?? "";
}

@section Styles {
    <style>
        .mc {
            border-radius: 12px;
            overflow: hidden;
            background: #141416;
            transition: transform 0.35s ease, box-shadow 0.35s ease;
        }
        .mc:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }
        .mc-img {
            position: relative;
            overflow: hidden;
            aspect-ratio: 2/3;
        }
        .mc-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        .mc:hover .mc-img img { transform: scale(1.05); }

        .mc-rating {
            position: absolute;
            top: 8px;
            right: 8px;
            display: inline-flex;
            align-items: center;
            gap: 3px;
            background: rgba(9,9,11,0.8);
            backdrop-filter: blur(8px);
            padding: 3px 7px;
            border-radius: 6px;
            line-height: 1;
        }
        .mc-rating svg { width: 11px; height: 11px; color: #fbbf24; flex-shrink: 0; }
        .mc-rating span { font-size: 11px; font-weight: 600; color: #fff; line-height: 1; }

        .mc-body {
            padding: 0.75rem 0.85rem;
        }
        .mc-body h3 {
            font-size: 0.9rem;
            font-weight: 600;
            color: #fff;
            line-height: 1.3;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            transition: color 0.25s;
        }
        .mc:hover .mc-body h3 { color: #fb7185; }
        .mc-body .mc-date {
            font-size: 0.7rem;
            color: #52525b;
            margin-top: 0.2rem;
        }

        .fade-in {
            opacity: 0;
            transform: translateY(24px);
            transition: opacity 0.7s ease, transform 0.7s ease;
        }
        .fade-in.vis { opacity: 1; transform: translateY(0); }

        .stagger > * {
            opacity: 0;
            transform: translateY(24px);
            transition: opacity 0.5s ease, transform 0.5s ease;
        }
        .stagger.vis > *:nth-child(1) { opacity:1; transform:translateY(0); transition-delay:.03s; }
        .stagger.vis > *:nth-child(2) { opacity:1; transform:translateY(0); transition-delay:.08s; }
        .stagger.vis > *:nth-child(3) { opacity:1; transform:translateY(0); transition-delay:.13s; }
        .stagger.vis > *:nth-child(4) { opacity:1; transform:translateY(0); transition-delay:.18s; }
        .stagger.vis > *:nth-child(5) { opacity:1; transform:translateY(0); transition-delay:.23s; }
        .stagger.vis > *:nth-child(6) { opacity:1; transform:translateY(0); transition-delay:.28s; }
        .stagger.vis > *:nth-child(7) { opacity:1; transform:translateY(0); transition-delay:.33s; }
        .stagger.vis > *:nth-child(8) { opacity:1; transform:translateY(0); transition-delay:.38s; }
        .stagger.vis > *:nth-child(9) { opacity:1; transform:translateY(0); transition-delay:.43s; }
        .stagger.vis > *:nth-child(10) { opacity:1; transform:translateY(0); transition-delay:.48s; }
        .stagger.vis > *:nth-child(n+11) { opacity:1; transform:translateY(0); transition-delay:.53s; }
    </style>
}

<div class="min-h-screen" style="background-color: #09090b;">
    <div class="max-w-[1360px] mx-auto px-6 pt-32 pb-20">

        <!-- Header -->
        <div class="mb-10 fade-in">
            <p class="text-xs font-medium uppercase tracking-wider mb-1" style="color: #e11d48; font-family: 'Outfit', sans-serif;">Search</p>
            <h1 class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Outfit', sans-serif;">
                Search Results
            </h1>
            @if (!string.IsNullOrEmpty(query))
            {
                <p class="text-zinc-500 mt-2 text-sm" style="font-family: 'Outfit', sans-serif;">
                    Showing results for "<span class="text-zinc-300">@query</span>"
                </p>
            }
        </div>

        @if (Model != null && Model.Any())
        {
            <!-- Results count -->
            <div class="mb-6 fade-in">
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium" style="background: rgba(225, 29, 72, 0.1); color: #fb7185; font-family: 'Outfit', sans-serif;">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
                    @Model.Count movie@(Model.Count != 1 ? "s" : "") found
                </span>
            </div>

            <!-- Results Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 stagger">
                @foreach (var movie in Model)
                {
                    <a asp-controller="Movie" asp-action="Details" asp-route-id="@movie.Id" class="block no-underline">
                        <div class="mc">
                            <div class="mc-img">
                                <img src="@movie.FullPosterPath" alt="@movie.Title" loading="lazy">
                                <div class="mc-rating">
                                    <svg fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                    <span>@movie.VoteAverage.ToString("F1")</span>
                                </div>
                            </div>
                            <div class="mc-body">
                                <h3>@movie.Title</h3>
                                <p class="mc-date">@movie.ReleaseDate</p>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="flex flex-col items-center justify-center py-24 fade-in">
                <div class="w-20 h-20 rounded-full flex items-center justify-center mb-6" style="background: rgba(225, 29, 72, 0.1);">
                    <svg class="w-10 h-10" fill="none" stroke="#e11d48" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-white mb-2" style="font-family: 'Outfit', sans-serif;">No movies found</h2>
                <p class="text-zinc-500 text-sm mb-8" style="font-family: 'Outfit', sans-serif;">
                    No movies found for "<span class="text-zinc-300">@query</span>"
                </p>
                <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold text-white transition-all duration-200" style="background: #e11d48; font-family: 'Outfit', sans-serif;" onmouseover="this.style.background='#be123c'" onmouseout="this.style.background='#e11d48'">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
                    Back to Home
                </a>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const obs = new IntersectionObserver(entries => {
                entries.forEach(e => {
                    if (e.isIntersecting) {
                        e.target.classList.add('vis');
                        obs.unobserve(e.target);
                    }
                });
            }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
            document.querySelectorAll('.fade-in, .stagger').forEach(el => obs.observe(el));
        });
    </script>
}
