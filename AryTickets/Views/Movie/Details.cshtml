@model Movie
@using Microsoft.AspNetCore.Identity
@using AryTickets.Models
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = Model.Title;
    var releaseDate = DateTime.Parse(Model.ReleaseDate);
}

@section Styles {
    <style>
        /* ── Electric Modern: Details ── */

        .movie-hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: flex-end;
            padding-bottom: 4rem;
            overflow: hidden;
        }

        .movie-hero-bg {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center top;
            animation: slowPan 50s ease-in-out infinite alternate;
            will-change: transform;
        }

        @@keyframes slowPan {
            0%   { transform: scale(1.08) translate(1%, -1%); }
            100% { transform: scale(1.15) translate(-1%, 1%); }
        }

        .hero-vignette {
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse at 60% 30%, transparent 0%, rgba(9,9,11,0.5) 55%, #09090b 100%),
                linear-gradient(to top, #09090b 0%, transparent 50%),
                linear-gradient(to right, rgba(9,9,11,0.85) 0%, transparent 60%);
            z-index: 2;
        }

        .hero-content {
            position: relative;
            z-index: 10;
        }

        .hero-glass {
            background: rgba(20, 20, 22, 0.7);
            backdrop-filter: blur(24px) saturate(1.3);
            -webkit-backdrop-filter: blur(24px) saturate(1.3);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 1rem;
            padding: 2.5rem;
        }

        .movie-poster-details {
            border-radius: 0.75rem;
            box-shadow:
                0 20px 60px rgba(0,0,0,0.7),
                0 0 0 1px rgba(255,255,255,0.06);
            transition: transform 0.5s cubic-bezier(.22,.61,.36,1), box-shadow 0.5s ease;
        }

        .movie-poster-details:hover {
            transform: translateY(-6px);
            box-shadow:
                0 30px 80px rgba(0,0,0,0.8),
                0 0 0 1px rgba(225,29,72,0.2);
        }

        .rating-ring {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            background: conic-gradient(#e11d48 @Model.RatingPercentage, rgba(255,255,255,0.08) 0);
            position: relative;
            flex-shrink: 0;
        }

        .rating-ring-inner {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: #09090b;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .rating-placeholder {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #141416;
            border: 2px solid rgba(255,255,255,0.08);
            flex-shrink: 0;
        }

        .showtime-pill {
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #fff;
            font-weight: 600;
            padding: 0.625rem 1.75rem;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
            text-decoration: none;
            font-size: 0.9rem;
            letter-spacing: 0.04em;
            background: transparent;
        }

        .showtime-pill:hover {
            background: #e11d48;
            border-color: #e11d48;
            color: #fff;
            box-shadow: 0 0 24px rgba(225,29,72,0.25);
        }

        .cast-card {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.75rem;
            border-radius: 0.75rem;
            background: #141416;
            border: 1px solid rgba(255,255,255,0.04);
            transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
        }
        .cast-card:hover {
            border-color: rgba(225,29,72,0.2);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
        }
        .cast-photo {
            width: 64px;
            height: 64px;
            object-fit: cover;
            border-radius: 50%;
            flex-shrink: 0;
            border: 2px solid #1a1a1e;
            transition: border-color 0.3s;
        }
        .cast-card:hover .cast-photo {
            border-color: rgba(225,29,72,0.4);
        }

        .tab-button {
            color: #71717a;
            border-bottom: 2px solid transparent;
            transition: all 0.3s ease;
            padding: 0.5rem 1.25rem;
            font-weight: 600;
            font-size: 0.85rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .tab-button:hover {
            color: #e11d48;
        }

        .tab-button.active {
            color: #e11d48;
            border-bottom-color: #e11d48;
            background: transparent;
        }

        .tab-panel {
            display: none;
        }

        .tab-panel.active {
            display: block;
        }

        .review-card {
            background: #141416;
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 0.75rem;
            padding: 1.75rem;
            transition: border-color 0.3s ease, transform 0.3s ease;
        }

        .review-card:hover {
            border-color: rgba(225,29,72,0.15);
            transform: translateY(-1px);
        }

        .reviews-placeholder {
            text-align: center;
            padding: 4rem 2rem;
            background: #141416;
            border-radius: 0.75rem;
            border: 1px dashed rgba(255,255,255,0.08);
        }

        .trailer-modal {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.90);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 100;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.4s ease;
        }

        .trailer-modal.active {
            opacity: 1;
            pointer-events: auto;
        }

        .trailer-modal-content {
            position: relative;
            width: 90%;
            max-width: 960px;
            aspect-ratio: 16 / 9;
        }

        .close-modal {
            position: absolute;
            top: -48px;
            right: 0;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 50%;
            color: #fff;
            font-size: 1.25rem;
            cursor: pointer;
            transition: all 0.3s ease;
            background: #141416;
        }

        .close-modal:hover {
            background: #e11d48;
            border-color: #e11d48;
            color: #fff;
        }

        .action-circle {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255, 255, 255, 0.06);
            background: #141416;
            color: #a1a1aa;
            transition: all 0.3s ease;
        }

        .action-circle:hover {
            background: rgba(225,29,72,0.1);
            border-color: rgba(225,29,72,0.3);
            color: #e11d48;
        }

        .action-circle-active {
            background: #e11d48;
            color: #fff;
            border-color: #e11d48;
        }

        .action-circle-active:hover {
            background: #be123c;
            border-color: #be123c;
            color: #fff;
        }

        .accent-line {
            width: 48px;
            height: 2px;
            background: #e11d48;
            margin-bottom: 1rem;
            border-radius: 1px;
        }
    </style>
}

<!-- ════════════════  HERO  ════════════════ -->
<div class="movie-hero">
    <div class="movie-hero-bg" style="background-image: url('@Model.FullBackdropPath');"></div>
    <div class="hero-vignette"></div>

    <div class="hero-content w-full px-6 lg:px-16">
        <div class="max-w-7xl mx-auto">
            <div class="grid md:grid-cols-12 gap-10 items-end">

                <!-- Poster -->
                <div class="md:col-span-3 reveal-up">
                    <img src="@Model.FullPosterPath"
                         alt="@Model.Title Poster"
                         class="movie-poster-details w-full max-w-[280px] mx-auto md:mx-0" />
                </div>

                <!-- Info panel -->
                <div class="md:col-span-9 reveal-up">
                    <div class="hero-glass">

                        <!-- Title -->
                        <h1 class="font-sans font-semibold text-white text-4xl sm:text-5xl lg:text-6xl leading-tight tracking-tight mb-4">
                            @Model.Title
                        </h1>

                        <!-- Meta line -->
                        <div class="flex items-center flex-wrap gap-3 text-sm text-zinc-400 font-sans mb-6">
                            <span class="text-[#e11d48] font-semibold">@Model.ReleaseDate.Split('-')[0]</span>
                            <span class="text-zinc-600">/</span>
                            <span>@string.Join(", ", Model.Genres.Select(g => g.Name))</span>
                            <span class="text-zinc-600">/</span>
                            <span>@Model.FormattedRuntime</span>
                        </div>

                        <!-- Rating + Trailer -->
                        <div class="flex items-center gap-6 mb-8">
                            @if (releaseDate > DateTime.Now || Model.VoteAverage == 0)
                            {
                                <div class="rating-placeholder" title="Not yet rated">
                                    <span class="text-zinc-500 font-semibold text-sm">N/A</span>
                                </div>
                            }
                            else
                            {
                                <div class="rating-ring" title="@Model.RatingPercentage rating">
                                    <div class="rating-ring-inner">
                                        <span class="text-white font-bold text-sm">@Model.RatingPercentage</span>
                                    </div>
                                </div>
                            }
                            @if (Model.FirstTrailer != null)
                            {
                                <button id="playTrailerBtn"
                                        class="flex items-center gap-2 text-zinc-400 hover:text-[#e11d48] transition-colors duration-300 font-sans font-semibold text-sm tracking-wide">
                                    <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
                                    </svg>
                                    <span>Play Trailer</span>
                                </button>
                            }
                        </div>

                        <!-- Overview -->
                        <div class="mb-8">
                            <p class="text-xs font-medium text-[#e11d48] uppercase tracking-wider mb-2">Overview</p>
                            <p class="text-zinc-400 font-sans leading-relaxed max-w-2xl text-[15px]">@Model.Overview</p>
                        </div>

                        <!-- Action buttons -->
                        <div class="flex items-center gap-4 mb-10">
                            <button class="action-circle" title="Like">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                </svg>
                            </button>

                            @if (SignInManager.IsSignedIn(User))
                            {
                                <form asp-controller="UserFavorites" asp-action="ToggleFavorite" method="post">
                                    <input type="hidden" name="movieId" value="@Model.Id" /> <input type="hidden" name="movieTitle" value="@Model.Title" /> <input type="hidden" name="posterPath" value="@Model.PosterPath" />
                                    @if ((bool)ViewData["IsFavorite"])
                                    {
                                        <button type="submit" class="action-circle action-circle-active" title="Remove from Favorites">
                                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                                            </svg>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="action-circle" title="Add to Favorites">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                                            </svg>
                                        </button>
                                    }
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Register" class="action-circle" title="Add to Favorites">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                                    </svg>
                                </a>
                            }
                        </div>

                        <!-- Showtimes -->
                        <div>
                            <p class="text-xs font-medium text-[#e11d48] uppercase tracking-wider mb-4">Select Showtime</p>
                            @{
                                var showtimes = ViewData["Showtimes"] as List<AryTickets.Models.Showtime>;
                            }
                            @if (showtimes != null && showtimes.Any())
                            {
                                var groupedByDate = showtimes.GroupBy(s => s.ShowDateTime.Date).OrderBy(g => g.Key);
                                <div class="space-y-4">
                                    @foreach (var dateGroup in groupedByDate)
                                    {
                                        <div>
                                            <p class="text-xs text-zinc-500 mb-2">@dateGroup.Key.ToString("dddd, MMM dd")</p>
                                            <div class="flex flex-wrap gap-2">
                                                @foreach (var st in dateGroup.OrderBy(s => s.ShowDateTime))
                                                {
                                                    if (SignInManager.IsSignedIn(User))
                                                    {
                                                        <a asp-controller="Booking" asp-action="SelectSeats" asp-route-showtimeId="@st.Id" class="showtime-pill">
                                                            <span>@st.FormattedTime</span>
                                                            <span class="text-xs text-zinc-500 ml-1">@st.Hall</span>
                                                            <span class="text-xs text-accent-400 ml-1">$@st.Price.ToString("F2")</span>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a asp-controller="Account" asp-action="Register" class="showtime-pill">
                                                            <span>@st.FormattedTime</span>
                                                            <span class="text-xs text-zinc-500 ml-1">@st.Hall</span>
                                                        </a>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <!-- Fallback: hardcoded showtimes for movies without configured showtimes -->
                                <div>
                                    <p class="text-xs text-zinc-500 mb-2">Today</p>
                                    <div class="flex flex-wrap gap-2">
                                        @if (SignInManager.IsSignedIn(User))
                                        {
                                            <a asp-controller="Booking" asp-action="SelectSeats" asp-route-movieId="@Model.Id" asp-route-movieTitle="@Model.Title" asp-route-showtime="Today - 7:00 PM" class="showtime-pill">
                                                <span>7:00 PM</span>
                                                <span class="text-xs text-zinc-500 ml-1">Hall 1</span>
                                                <span class="text-xs text-accent-400 ml-1">$12.50</span>
                                            </a>
                                            <a asp-controller="Booking" asp-action="SelectSeats" asp-route-movieId="@Model.Id" asp-route-movieTitle="@Model.Title" asp-route-showtime="Today - 8:30 PM" class="showtime-pill">
                                                <span>8:30 PM</span>
                                                <span class="text-xs text-zinc-500 ml-1">Hall 1</span>
                                                <span class="text-xs text-accent-400 ml-1">$12.50</span>
                                            </a>
                                            <a asp-controller="Booking" asp-action="SelectSeats" asp-route-movieId="@Model.Id" asp-route-movieTitle="@Model.Title" asp-route-showtime="Today - 9:45 PM" class="showtime-pill">
                                                <span>9:45 PM</span>
                                                <span class="text-xs text-zinc-500 ml-1">Hall 1</span>
                                                <span class="text-xs text-accent-400 ml-1">$12.50</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Account" asp-action="Register" class="showtime-pill">
                                                <span>7:00 PM</span>
                                                <span class="text-xs text-zinc-500 ml-1">Hall 1</span>
                                                <span class="text-xs text-accent-400 ml-1">$12.50</span>
                                            </a>
                                            <a asp-controller="Account" asp-action="Register" class="showtime-pill">
                                                <span>8:30 PM</span>
                                                <span class="text-xs text-zinc-500 ml-1">Hall 1</span>
                                                <span class="text-xs text-accent-400 ml-1">$12.50</span>
                                            </a>
                                            <a asp-controller="Account" asp-action="Register" class="showtime-pill">
                                                <span>9:45 PM</span>
                                                <span class="text-xs text-zinc-500 ml-1">Hall 1</span>
                                                <span class="text-xs text-accent-400 ml-1">$12.50</span>
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- ════════════════  CAST  ════════════════ -->
<section class="py-20 px-6 lg:px-16" style="background: #09090b;">
    <div class="max-w-7xl mx-auto reveal-up">
        <div class="accent-line"></div>
        <p class="text-xs font-medium text-[#e11d48] uppercase tracking-wider mb-2">The Ensemble</p>
        <h2 class="font-sans font-semibold text-white text-3xl mb-10">Top Billed Cast</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            @foreach (var castMember in Model.Credits.Cast.Take(6))
            {
                <div class="cast-card">
                    <img src="@castMember.FullProfilePath"
                         alt="@castMember.Name"
                         class="cast-photo" />
                    <h4 class="font-sans font-medium text-white text-sm">@castMember.Name</h4>
                </div>
            }
        </div>
    </div>
</section>

<!-- ════════════════  REVIEWS  ════════════════ -->
<section class="py-20 px-6 lg:px-16" style="background: #09090b;">
    <div class="max-w-7xl mx-auto reveal-up">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4 mb-10">
            <div>
                <div class="accent-line"></div>
                <p class="text-xs font-medium text-[#e11d48] uppercase tracking-wider mb-2">Audience &amp; Critics</p>
                <h2 class="font-sans font-semibold text-white text-3xl">Reviews</h2>
            </div>
            @if (SignInManager.IsSignedIn(User))
            {
                <a href="#write-review"
                   class="inline-flex items-center justify-center px-6 py-2.5 bg-[#e11d48] text-white text-sm font-semibold rounded-lg hover:bg-[#be123c] transition-colors duration-300 self-start sm:self-auto">
                    Write a Review
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Register"
                   class="inline-flex items-center justify-center px-6 py-2.5 bg-[#e11d48] text-white text-sm font-semibold rounded-lg hover:bg-[#be123c] transition-colors duration-300 self-start sm:self-auto">
                    Write a Review
                </a>
            }
        </div>

        <!-- ── User Reviews ── -->
        @{
            var userReviews = ViewData["UserReviews"] as List<UserReview>;
        }
        @if (userReviews != null && userReviews.Any())
        {
            <div class="mb-10">
                <p class="text-xs font-medium text-zinc-500 uppercase tracking-wider mb-4">Community Reviews</p>
                <div class="space-y-5">
                    @foreach (var ur in userReviews)
                    {
                        <div class="review-card">
                            <div class="flex items-center gap-3 mb-3">
                                <h4 class="font-sans font-semibold text-white">@ur.UserName</h4>
                                @if (ur.IsCritic)
                                {
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-accent-500/10 text-accent-400 border border-accent-500/20 uppercase tracking-wider">Critic</span>
                                }
                                <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-yellow-400/10 text-yellow-400 border border-yellow-400/20">
                                    @ur.Rating / 10
                                </span>
                            </div>
                            <p class="text-zinc-400 font-sans text-sm leading-relaxed">@ur.Content</p>
                            <p class="text-zinc-600 text-xs mt-3">@ur.CreatedAt.ToString("MMM dd, yyyy")</p>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ── Write a Review Form ── -->
        @if (SignInManager.IsSignedIn(User) && !(bool)(ViewData["HasReviewed"] ?? false))
        {
            <div id="write-review" class="mb-10">
                <p class="text-xs font-medium text-zinc-500 uppercase tracking-wider mb-4">Share Your Thoughts</p>
                <div class="review-card">
                    <form asp-controller="Movie" asp-action="SubmitReview" method="post">
                        <input type="hidden" name="movieId" value="@Model.Id" />
                        <input type="hidden" name="movieTitle" value="@Model.Title" />

                        <div class="mb-5">
                            <label class="block text-sm font-medium text-zinc-300 mb-2">Rating</label>
                            <select name="rating" required class="bg-surface-200 border border-white/[0.06] text-white text-sm rounded-lg px-4 py-2.5 focus:border-accent-500/30 focus:outline-none w-full max-w-[200px] appearance-none">
                                <option value="" disabled selected class="text-zinc-600">Select a rating</option>
                                @for (int i = 1; i <= 10; i++)
                                {
                                    <option value="@i">@i / 10</option>
                                }
                            </select>
                        </div>

                        <div class="mb-5">
                            <label class="block text-sm font-medium text-zinc-300 mb-2">Your Review</label>
                            <textarea name="content" required rows="4" placeholder="What did you think of the movie?"
                                      class="w-full bg-surface-200 border border-white/[0.06] text-white text-sm rounded-lg px-4 py-3 focus:border-accent-500/30 focus:outline-none placeholder-zinc-600 resize-none"></textarea>
                        </div>

                        <button type="submit"
                                class="inline-flex items-center justify-center px-6 py-2.5 bg-[#e11d48] text-white text-sm font-semibold rounded-lg hover:bg-[#be123c] transition-colors duration-300">
                            Submit Review
                        </button>
                    </form>
                </div>
            </div>
        }

        @if (releaseDate > DateTime.Now)
        {
            <div class="reviews-placeholder">
                <h3 class="font-sans font-semibold text-white text-2xl mb-2">This movie is coming soon!</h3>
                <p class="text-zinc-500 font-sans">Reviews will be available after the release date. Check back then!</p>
            </div>
        }
        else if (!Model.Reviews.Results.Any())
        {
            <div class="reviews-placeholder">
                <h3 class="font-sans font-semibold text-white text-2xl mb-2">No Reviews Yet</h3>
                <p class="text-zinc-500 font-sans">Be the first one to share your thoughts!</p>
            </div>
        }
        else
        {
            <div class="flex gap-1 border-b border-white/[0.06] mb-8">
                <button class="tab-button active" data-tab="user-reviews">User Reviews</button>
                <button class="tab-button" data-tab="critic-reviews">Critic Reviews</button>
            </div>

            <div id="user-reviews" class="tab-panel active space-y-5">
                @foreach (var review in Model.Reviews.Results.Take(5))
                {
                    <div class="review-card">
                        <div class="flex items-center gap-3 mb-3">
                            <h4 class="font-sans font-semibold text-white">@review.Author</h4>
                            @if (review.AuthorDetails.Rating.HasValue)
                            {
                                <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-yellow-400/10 text-yellow-400 border border-yellow-400/20">
                                    @review.AuthorDetails.Rating / 10
                                </span>
                            }
                        </div>
                        <p class="text-zinc-400 font-sans text-sm leading-relaxed line-clamp-4">@review.Content</p>
                    </div>
                }
            </div>

            <div id="critic-reviews" class="tab-panel">
                <div class="reviews-placeholder">
                    <h3 class="font-sans font-semibold text-white text-2xl mb-2">No Critic Reviews Yet</h3>
                    <p class="text-zinc-500 font-sans">Professional critic reviews will be added as they become available.</p>
                </div>
            </div>
        }
    </div>
</section>

<!-- ════════════════  TRAILER MODAL  ════════════════ -->
@if (Model.FirstTrailer != null)
{
    <div id="trailerModal" class="trailer-modal">
        <div class="trailer-modal-content">
            <span id="closeModalBtn" class="close-modal">&times;</span>
            <iframe id="youtube-player"
                    class="w-full h-full rounded-lg"
                    src=""
                    title="YouTube video player"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
        </div>
    </div>
}

@section Scripts {
    <script>
        // ── Reveal animations ──
        function revealDetails() {
            const reveals = document.querySelectorAll('.reveal-up');
            reveals.forEach(el => {
                const windowHeight = window.innerHeight;
                const elementTop = el.getBoundingClientRect().top;
                const elementVisible = 100;
                if (elementTop < windowHeight - elementVisible) {
                    if (!el.classList.contains('active')) {
                        el.classList.add('active');
                        const castCards = el.querySelectorAll('.cast-card');
                        if (castCards.length > 0) {
                            castCards.forEach((card, index) => {
                                card.style.opacity = '0';
                                card.style.transform = 'translateY(20px)';
                                card.style.transition = `opacity 0.6s ease ${index * 0.08}s, transform 0.6s ease ${index * 0.08}s`;
                                requestAnimationFrame(() => {
                                    card.style.opacity = '1';
                                    card.style.transform = 'translateY(0)';
                                });
                            });
                        }
                    }
                }
            });
        }
        window.addEventListener('scroll', revealDetails);
        document.addEventListener('DOMContentLoaded', revealDetails);

        // ── Trailer modal ──
        const playTrailerBtn = document.getElementById('playTrailerBtn');
        const trailerModal = document.getElementById('trailerModal');
        const closeModalBtn = document.getElementById('closeModalBtn');
        const player = document.getElementById('youtube-player');
        const trailerUrl = "@Model.FirstTrailer?.YouTubeUrl";

        if (playTrailerBtn) {
            playTrailerBtn.addEventListener('click', () => {
                player.src = trailerUrl;
                trailerModal.classList.add('active');
            });
        }

        if (closeModalBtn) {
            const stopVideo = () => {
                trailerModal.classList.remove('active');
                player.src = "";
            }
            closeModalBtn.addEventListener('click', stopVideo);
            trailerModal.addEventListener('click', (e) => {
                if (e.target === trailerModal) stopVideo();
            });
        }

        // ── Review tabs ──
        const tabButtons = document.querySelectorAll('.tab-button');
        const tabPanels = document.querySelectorAll('.tab-panel');
        tabButtons.forEach(button => {
            button.addEventListener('click', () => {
                tabButtons.forEach(btn => btn.classList.remove('active'));
                button.classList.add('active');
                const targetTab = button.getAttribute('data-tab');
                tabPanels.forEach(panel => {
                    if (panel.id === targetTab) {
                        panel.classList.add('active');
                    } else {
                        panel.classList.remove('active');
                    }
                });
            });
        });
    </script>
}
