@model SeatSelectionViewModel
@using AryTickets.Models
@{
    ViewData["Title"] = "Choose seats";
    Layout = "_Layout";

    // Group seats by tier for the side panel / legend.
    var tierMeta = new (SeatTier Tier, string Label, string Color)[]
    {
        (SeatTier.RoyalBox, "Royal Box", "#8b1a1a"),
        (SeatTier.Royal,    "Royal",     "#d4af37"),
        (SeatTier.Premium,  "Premium",   "#b8860b"),
        (SeatTier.Standard, "Standard",  "#c9a961"),
        (SeatTier.Balcony,  "Balcony",   "#8b6914"),
    };
    var byTier = Model.Seats.GroupBy(s => s.Tier).ToDictionary(g => g.Key, g => g.ToList());
}

@section Styles {
    <style>
        .arena-wrap {
            position: relative;
            width: 100%;
            max-width: 1100px;
            margin: 0 auto;
            aspect-ratio: 900 / 620;
            background: radial-gradient(ellipse at 50% 5%, rgba(212,175,55,0.08), transparent 60%),
                        radial-gradient(circle at 50% 100%, rgba(139,26,26,0.18), transparent 70%);
            border: 1px solid rgba(212,175,55,0.18);
            border-radius: 8px;
            overflow: hidden;
        }
        .arena-svg { width: 100%; height: 100%; display: block; }

        /* Stage block — drawn in SVG but styled here for hover affordance. */
        .stage-block { fill: url(#stageGrad); stroke: rgba(212,175,55,0.45); stroke-width: 1.5; }
        .stage-glow  { fill: url(#stageGlow); pointer-events: none; }
        .stage-text {
            fill: #d4af37;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            letter-spacing: 6px;
            text-transform: uppercase;
            text-anchor: middle;
        }

        /* Tier guide arcs — barely visible, give the arrangement structure. */
        .tier-arc { fill: none; stroke: rgba(212,175,55,0.08); stroke-width: 1; stroke-dasharray: 2 4; }

        /* Seat — a rounded square that rotates to face the stage. */
        .seat-svg { cursor: pointer; transition: filter 0.2s ease, transform 0.2s ease; transform-box: fill-box; transform-origin: center; }
        .seat-svg.taken { cursor: not-allowed; opacity: 0.35; }
        .seat-svg:not(.taken):hover { filter: brightness(1.4) drop-shadow(0 0 6px currentColor); }
        .seat-svg.selected { filter: drop-shadow(0 0 8px #d4af37); }

        .seat-shape { rx: 2; ry: 2; transition: fill 0.2s ease; }

        /* Per-tier seat colour (matches legend). */
        .tier-RoyalBox .seat-shape { fill: #8b1a1a; stroke: #d4af37; stroke-width: 0.6; }
        .tier-Royal    .seat-shape { fill: #d4af37; }
        .tier-Premium  .seat-shape { fill: #b8860b; }
        .tier-Standard .seat-shape { fill: #c9a961; }
        .tier-Balcony  .seat-shape { fill: #8b6914; }

        .seat-svg.taken    .seat-shape { fill: #2b0a0a; }
        .seat-svg.selected .seat-shape { fill: #f5e6d3; stroke: #d4af37; stroke-width: 1.2; }

        /* Just-taken pulse from SignalR. */
        .seat-svg.just-taken .seat-shape { fill: #ef4444; }
        .seat-svg.just-taken { animation: seatTaken 0.65s ease-out forwards; }
        @@keyframes seatTaken {
            0%   { filter: drop-shadow(0 0 10px #ef4444); }
            100% { opacity: 0.35; filter: none; }
        }

        /* Tier legend / price card. */
        .tier-card {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            background: rgba(43,10,10,0.55);
            border: 1px solid rgba(212,175,55,0.15);
            border-radius: 4px;
            transition: border-color 0.25s;
        }
        .tier-card:hover { border-color: rgba(212,175,55,0.4); }
        .tier-swatch {
            width: 18px; height: 18px; border-radius: 2px;
            box-shadow: 0 0 0 1px rgba(0,0,0,0.4) inset;
        }
        .tier-label  { font-family: 'Playfair Display', serif; font-size: 15px; color: #f5e6d3; }
        .tier-meta   { font-family: 'Inter', sans-serif; font-size: 10px; letter-spacing: 0.16em; color: rgba(212,175,55,0.7); text-transform: uppercase; margin-top: 2px; }
        .tier-price  { margin-left: auto; font-family: 'Playfair Display', serif; font-size: 16px; color: #d4af37; }

        .booking-bar {
            background: rgba(22,10,12,0.95);
            border-top: 1px solid rgba(212,175,55,0.22);
            backdrop-filter: blur(20px);
        }

        .toast {
            position: fixed; top: 5rem; right: 1.5rem; z-index: 100;
            background: rgba(43,10,10,0.95);
            border: 1px solid rgba(212,175,55,0.4);
            border-radius: 4px;
            padding: 1rem 1.4rem;
            color: #f5e6d3;
            font-family: 'Cormorant Garamond', serif;
            transform: translateX(120%); transition: transform 0.3s ease;
            max-width: 340px;
        }
        .toast.show { transform: translateX(0); }
    </style>
}

<div class="max-w-6xl mx-auto px-6 pt-32 pb-40">
    <div class="text-center mb-10">
        <p class="text-[11px] font-sans tracking-[0.35em] uppercase text-gold-400 mb-4">Seat reservation</p>
        <h1 class="font-serif font-semibold text-ivory-100 text-4xl md:text-5xl mb-2">@Model.ProductionTitle</h1>
        <p class="font-garamond italic text-gold-400 text-xl">@Model.PerformanceDateTime</p>
        @if (!string.IsNullOrEmpty(Model.Stage))
        {
            <p class="mt-2 font-garamond italic text-ivory-300/70">@Model.Stage</p>
        }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <div class="lg:col-span-3">
            <div class="arena-wrap">
                <svg class="arena-svg" viewBox="0 0 900 620" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="stageGrad" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#d4af37" stop-opacity="0.95"/>
                            <stop offset="100%" stop-color="#8b6914" stop-opacity="0.7"/>
                        </linearGradient>
                        <radialGradient id="stageGlow" cx="50%" cy="0%" r="80%">
                            <stop offset="0%" stop-color="#d4af37" stop-opacity="0.25"/>
                            <stop offset="60%" stop-color="#d4af37" stop-opacity="0"/>
                        </radialGradient>
                    </defs>

                    <!-- Stage proscenium arc + label -->
                    <ellipse class="stage-glow" cx="450" cy="20" rx="380" ry="120"/>
                    <path class="stage-block" d="M 200 20 Q 450 -10 700 20 L 700 50 Q 450 30 200 50 Z"/>
                    <text class="stage-text" x="450" y="42">STAGE</text>

                    <!-- Faint tier guide arcs -->
                    <path class="tier-arc" d="M 318 80 A 145 145 0 0 1 582 80"/>
                    <path class="tier-arc" d="M 295 80 A 215 215 0 0 1 605 80"/>
                    <path class="tier-arc" d="M 270 80 A 295 295 0 0 1 630 80"/>
                    <path class="tier-arc" d="M 252 80 A 380 380 0 0 1 648 80"/>

                    <!-- Seats -->
                    <g id="seats">
                        @foreach (var seat in Model.Seats)
                        {
                            var statusClass = seat.Status == SeatStatus.Taken ? "taken" : "available";
                            <g class="seat-svg tier-@seat.Tier @statusClass"
                               transform="translate(@seat.X.ToString("F2", System.Globalization.CultureInfo.InvariantCulture), @seat.Y.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)) rotate(@seat.Rotation.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))"
                               data-seat-number="@seat.SeatNumber"
                               data-price="@seat.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                               data-tier="@seat.Tier">
                                <rect class="seat-shape" x="-7" y="-7" width="14" height="14" rx="2" ry="2"></rect>
                                <title>@seat.SeatNumber — @seat.Tier — @seat.Price.ToString("F2") EUR</title>
                            </g>
                        }
                    </g>
                </svg>
            </div>
        </div>

        <aside class="lg:col-span-1 space-y-3">
            <p class="text-[10px] font-sans tracking-[0.3em] uppercase text-gold-400 mb-1">Tiers</p>
            @foreach (var meta in tierMeta)
            {
                if (!byTier.ContainsKey(meta.Tier)) { continue; }
                var seatsInTier = byTier[meta.Tier];
                var priceLabel = seatsInTier[0].Price.ToString("F2");
                <div class="tier-card">
                    <span class="tier-swatch" style="background:@meta.Color"></span>
                    <div>
                        <div class="tier-label">@meta.Label</div>
                        <div class="tier-meta">@seatsInTier.Count seats</div>
                    </div>
                    <span class="tier-price">@priceLabel €</span>
                </div>
            }

            <div class="tier-card">
                <span class="tier-swatch" style="background:#f5e6d3"></span>
                <div>
                    <div class="tier-label">Selected</div>
                    <div class="tier-meta">your seats</div>
                </div>
            </div>
            <div class="tier-card">
                <span class="tier-swatch" style="background:#2b0a0a; opacity:0.5"></span>
                <div>
                    <div class="tier-label">Taken</div>
                    <div class="tier-meta">unavailable</div>
                </div>
            </div>
        </aside>
    </div>
</div>

<div id="seat-toast" class="toast"></div>

<form asp-action="Checkout" asp-controller="Booking" method="post">
    @Html.AntiForgeryToken()
    <div class="booking-bar fixed bottom-0 left-0 right-0 p-6 z-40">
        <div class="max-w-6xl mx-auto flex justify-between items-center gap-6 flex-wrap">
            <input type="hidden" name="productionTitle" value="@Model.ProductionTitle" />
            <input type="hidden" name="performanceDateTime" value="@Model.PerformanceDateTime" />
            <input type="hidden" name="stage" value="@Model.Stage" />
            <input type="hidden" id="hidden-seats" name="selectedSeats" />
            <input type="hidden" id="hidden-price" name="totalPrice" />
            @if (Model.PerformanceId.HasValue)
            {
                <input type="hidden" name="performanceId" value="@Model.PerformanceId" />
            }

            <div>
                <p class="text-[10px] font-sans tracking-[0.3em] uppercase text-gold-400 mb-1">Selected seats</p>
                <p id="selected-seats" class="font-serif text-ivory-100 text-lg">None</p>
            </div>
            <div class="text-right">
                <p class="text-[10px] font-sans tracking-[0.3em] uppercase text-gold-400 mb-1">Total</p>
                <p id="total-price" class="font-serif text-2xl font-semibold text-gold-400">0.00 EUR</p>
            </div>
            <button id="checkout-button" type="submit" class="btn-gold opacity-40 cursor-not-allowed" disabled>
                <span>Proceed to payment</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"/></svg>
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const arena            = document.getElementById('seats');
            const selectedSeatsEl  = document.getElementById('selected-seats');
            const totalPriceEl     = document.getElementById('total-price');
            const checkoutButton   = document.getElementById('checkout-button');
            const hiddenSeatsInput = document.getElementById('hidden-seats');
            const hiddenPriceInput = document.getElementById('hidden-price');
            const toast            = document.getElementById('seat-toast');
            const performanceId    = @(Model.PerformanceId.HasValue ? Model.PerformanceId.Value.ToString() : "null");

            if (performanceId) {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/seats")
                    .withAutomaticReconnect()
                    .build();

                connection.on("SeatsBooked", (seats) => {
                    let deselectedAny = false;
                    seats.forEach(seatNumber => {
                        const seatEl = arena.querySelector(`.seat-svg[data-seat-number="${seatNumber}"]`);
                        if (!seatEl) return;
                        const wasSelected = seatEl.classList.contains('selected');
                        seatEl.classList.remove('available', 'selected');
                        seatEl.classList.add('taken', 'just-taken');
                        if (wasSelected) deselectedAny = true;
                        setTimeout(() => seatEl.classList.remove('just-taken'), 700);
                    });
                    if (deselectedAny) {
                        updateSummary();
                        showToast(`Seats ${seats.join(', ')} were just taken by another viewer.`);
                    }
                });

                connection.start()
                    .then(() => connection.invoke("JoinPerformance", performanceId))
                    .catch(err => console.warn("SignalR connection failed:", err));
            }

            function showToast(message) {
                toast.textContent = message;
                toast.classList.add('show');
                setTimeout(() => toast.classList.remove('show'), 4000);
            }

            arena.addEventListener('click', e => {
                const seatEl = e.target.closest('.seat-svg');
                if (!seatEl) return;
                if (seatEl.classList.contains('taken')) return;
                seatEl.classList.toggle('selected');
                seatEl.classList.toggle('available');
                updateSummary();
            });

            function updateSummary() {
                const selected = arena.querySelectorAll('.seat-svg.selected');
                const seatNumbers = [...selected].map(s => s.dataset.seatNumber);
                const total = [...selected].reduce((acc, s) => acc + parseFloat(s.dataset.price), 0);

                if (seatNumbers.length > 0) {
                    selectedSeatsEl.textContent = seatNumbers.join(', ');
                    checkoutButton.disabled = false;
                    checkoutButton.classList.remove('opacity-40', 'cursor-not-allowed');
                    hiddenSeatsInput.value = seatNumbers.join(',');
                    hiddenPriceInput.value = total.toFixed(2);
                } else {
                    selectedSeatsEl.textContent = 'None';
                    checkoutButton.disabled = true;
                    checkoutButton.classList.add('opacity-40', 'cursor-not-allowed');
                    hiddenSeatsInput.value = '';
                    hiddenPriceInput.value = 0;
                }
                totalPriceEl.textContent = `${total.toFixed(2)} EUR`;
            }
        });
    </script>
}
