@model SeatSelectionViewModel
@{
    ViewData["Title"] = "Select Seats";
    Layout = "_Layout";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { font-family: 'Outfit', sans-serif; }

        .screen {
            position: relative;
            width: 70%;
            height: 4px;
            background: linear-gradient(90deg, transparent, #e11d48, transparent);
            margin: 0 auto 1.5rem auto;
            border-radius: 4px;
        }

            .screen::before {
                content: '';
                position: absolute;
                top: -12px;
                left: 10%;
                width: 80%;
                height: 24px;
                border-radius: 50%;
                box-shadow: 0 0 30px 8px rgba(225, 29, 72, 0.35);
            }

        .screen-label {
            text-align: center;
            font-family: 'Outfit', sans-serif;
            font-size: 0.7rem;
            letter-spacing: 0.25em;
            text-transform: uppercase;
            color: #e11d48;
            opacity: 0.6;
            margin-bottom: 3rem;
        }

        .seat-grid {
            display: grid;
            grid-template-columns: repeat(14, 1fr);
            gap: 0.5rem;
            perspective: 1000px;
        }

        .seat {
            aspect-ratio: 1 / 1;
            transition: all 0.2s ease-in-out;
            position: relative;
        }

            .seat svg {
                width: 100%;
                height: 100%;
                transition: fill 0.2s, filter 0.2s;
            }

            .seat.available svg {
                fill: #1c1c1f;
                stroke: #333;
                stroke-width: 0.5;
            }

            .seat.available:hover {
                transform: scale(1.2);
                cursor: pointer;
            }

                .seat.available:hover svg {
                    fill: #e11d48;
                    stroke: #e11d48;
                    filter: drop-shadow(0 0 4px rgba(225, 29, 72, 0.3));
                }

            .seat.taken svg {
                fill: #27272a;
                opacity: 0.4;
            }

            .seat.taken {
                cursor: not-allowed;
            }

            .seat.selected {
                transform: scale(1.1);
            }

                .seat.selected svg {
                    fill: #e11d48;
                    filter: drop-shadow(0 0 6px rgba(225, 29, 72, 0.5));
                }

            /* Flash animation when a seat gets taken by another user */
            .seat.just-taken svg {
                fill: #ef4444;
                filter: drop-shadow(0 0 8px rgba(239, 68, 68, 0.6));
                animation: seatTaken 0.6s ease-out forwards;
            }

        @@keyframes seatTaken {
            0% { fill: #ef4444; filter: drop-shadow(0 0 12px rgba(239,68,68,0.8)); }
            100% { fill: #27272a; filter: none; opacity: 0.4; }
        }

        .legend-dot {
            width: 1rem;
            height: 1rem;
            border-radius: 0.25rem;
        }

        .toast {
            position: fixed;
            top: 5rem;
            right: 1.5rem;
            z-index: 100;
            background: #1c1c1f;
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 12px;
            padding: 1rem 1.5rem;
            color: #fca5a5;
            font-size: 0.875rem;
            transform: translateX(120%);
            transition: transform 0.3s ease;
            max-width: 320px;
        }
        .toast.show { transform: translateX(0); }
    </style>
}

<div class="container mx-auto px-6 py-16" style="background-color: #09090b; min-height: 100vh;">
    <div class="pt-24 text-center">
        <h1 class="text-4xl font-extrabold text-white" style="font-family: 'Outfit', sans-serif;">@Model.MovieTitle</h1>
        <p class="mt-2" style="color: #e11d48; font-family: 'Outfit', sans-serif;">@Model.Showtime</p>
        @if (!string.IsNullOrEmpty(Model.Hall))
        {
            <p class="mt-1 text-sm" style="color: #71717a; font-family: 'Outfit', sans-serif;">@Model.Hall &middot; $@Model.TicketPrice.ToString("F2") per seat</p>
        }
    </div>

    <div class="py-12">
        <div class="screen"></div>
        <div class="screen-label">Screen</div>
        <div class="seat-grid max-w-4xl mx-auto">
            @foreach (var row in Model.SeatingChart)
            {
                @foreach (var seat in row)
                {
                    if (seat == null)
                    {
                        <div class="aisle"></div>
                    }
                    else
                    {
                        var statusClass = seat.Status.ToString().ToLower();
                        <div class="seat @statusClass" data-seat-number="@seat.SeatNumber" data-price="@seat.Price">
                            <svg viewBox="0 0 24 24">
                                <path d="M4 18v3h16v-3h-2v-5H6v5H4zM6 6c0-1.1.9-2 2-2h8a2 2 0 012 2v7H6V6z" />
                            </svg>
                        </div>
                    }
                }
            }
        </div>

        <div class="flex justify-center space-x-8 mt-8">
            <div class="flex items-center space-x-2"><div class="legend-dot" style="background-color: #1c1c1f; border: 1px solid #333;"></div><span class="text-sm" style="color: #888; font-family: 'Outfit', sans-serif;">Available</span></div>
            <div class="flex items-center space-x-2"><div class="legend-dot" style="background-color: #e11d48;"></div><span class="text-sm" style="color: #888; font-family: 'Outfit', sans-serif;">Selected</span></div>
            <div class="flex items-center space-x-2"><div class="legend-dot" style="background-color: #27272a; opacity: 0.4;"></div><span class="text-sm" style="color: #888; font-family: 'Outfit', sans-serif;">Taken</span></div>
        </div>
    </div>
</div>

<div id="seat-toast" class="toast"></div>

<form asp-action="Checkout" asp-controller="Booking" method="post">
    @Html.AntiForgeryToken()
    <div class="fixed bottom-0 left-0 right-0 backdrop-filter backdrop-blur-sm p-6" style="background-color: #141416; border-top: 1px solid rgba(255, 255, 255, 0.06);">
        <div class="container mx-auto flex justify-between items-center">

            <input type="hidden" name="movieTitle" value="@Model.MovieTitle" />
            <input type="hidden" name="showtime" value="@Model.Showtime" />
            <input type="hidden" id="hidden-seats" name="selectedSeats" />
            <input type="hidden" id="hidden-price" name="totalPrice" />
            @if (Model.ShowtimeId.HasValue)
            {
                <input type="hidden" name="showtimeId" value="@Model.ShowtimeId" />
            }

            <div>
                <h4 class="font-bold text-white" style="font-family: 'Outfit', sans-serif;">Selected Seats</h4>
                <p id="selected-seats" style="color: #888; font-family: 'Outfit', sans-serif;">None</p>
            </div>
            <div class="text-right">
                <h4 class="font-bold text-white" style="font-family: 'Outfit', sans-serif;">Total Price</h4>
                <p id="total-price" class="text-2xl font-bold" style="color: #e11d48; font-family: 'Outfit', sans-serif;">$0.00</p>
            </div>
            <button id="checkout-button" type="submit" class="font-bold py-3 px-8 rounded-lg text-lg opacity-50 cursor-not-allowed transition-all text-white" style="background-color: #e11d48; font-family: 'Outfit', sans-serif;" disabled>
                Proceed to Checkout
            </button>
        </div>
    </div>
</form>


@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const seatGrid = document.querySelector('.seat-grid');
            const selectedSeatsEl = document.getElementById('selected-seats');
            const totalPriceEl = document.getElementById('total-price');
            const checkoutButton = document.getElementById('checkout-button');
            const hiddenSeatsInput = document.getElementById('hidden-seats');
            const hiddenPriceInput = document.getElementById('hidden-price');
            const toast = document.getElementById('seat-toast');
            const showtimeId = @(Model.ShowtimeId.HasValue ? Model.ShowtimeId.Value.ToString() : "null");

            // --- SignalR real-time connection ---
            if (showtimeId) {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/hubs/seats")
                    .withAutomaticReconnect()
                    .build();

                connection.on("SeatsBooked", (seats) => {
                    let deselectedAny = false;
                    seats.forEach(seatNumber => {
                        const seatDiv = seatGrid.querySelector(`.seat[data-seat-number="${seatNumber}"]`);
                        if (seatDiv) {
                            const wasSelected = seatDiv.classList.contains('selected');
                            seatDiv.classList.remove('available', 'selected');
                            seatDiv.classList.add('taken', 'just-taken');
                            if (wasSelected) deselectedAny = true;
                            setTimeout(() => seatDiv.classList.remove('just-taken'), 600);
                        }
                    });

                    if (deselectedAny) {
                        updateSummary();
                        showToast(`Seats ${seats.join(', ')} were just booked by someone else.`);
                    }
                });

                connection.start()
                    .then(() => connection.invoke("JoinShowtime", showtimeId))
                    .catch(err => console.warn("SignalR connection failed:", err));
            }

            function showToast(message) {
                toast.textContent = message;
                toast.classList.add('show');
                setTimeout(() => toast.classList.remove('show'), 4000);
            }

            // --- Seat selection ---
            seatGrid.addEventListener('click', (e) => {
                const seatDiv = e.target.closest('.seat');
                if (!seatDiv) return;

                if (seatDiv.classList.contains('available')) {
                    seatDiv.classList.toggle('selected');
                    seatDiv.classList.toggle('available');
                    updateSummary();
                } else if (seatDiv.classList.contains('selected')) {
                    seatDiv.classList.toggle('selected');
                    seatDiv.classList.toggle('available');
                    updateSummary();
                }
            });

            function updateSummary() {
                const selectedSeats = document.querySelectorAll('.seat.selected');
                const seatNumbers = [...selectedSeats].map(seat => seat.dataset.seatNumber);
                const totalPrice = [...selectedSeats].reduce((total, seat) => total + parseFloat(seat.dataset.price), 0);

                if (seatNumbers.length > 0) {
                    const seatsText = seatNumbers.join(', ');
                    selectedSeatsEl.innerText = seatsText;
                    checkoutButton.disabled = false;
                    checkoutButton.classList.remove('opacity-50', 'cursor-not-allowed');

                    hiddenSeatsInput.value = seatsText;
                    hiddenPriceInput.value = totalPrice;
                } else {
                    selectedSeatsEl.innerText = 'None';
                    checkoutButton.disabled = true;
                    checkoutButton.classList.add('opacity-50', 'cursor-not-allowed');

                    hiddenSeatsInput.value = "";
                    hiddenPriceInput.value = 0;
                }

                totalPriceEl.innerText = `$${totalPrice.toFixed(2)}`;
            }
        });
    </script>
}
