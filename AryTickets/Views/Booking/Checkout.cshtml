@model CheckoutViewModel
@{
    ViewData["Title"] = "Payment";
    Layout = "_Layout";
    var stripeEnabled = ViewData["StripeEnabled"] is bool b && b;
    var stripePublishableKey = ViewData["StripePublishableKey"] as string ?? string.Empty;
}

@section Styles {
    <style>
        .checkout-panel {
            background: rgba(43, 10, 10, 0.6);
            border: 1px solid rgba(212, 175, 55, 0.18);
            border-radius: 4px;
            padding: 2.25rem;
            backdrop-filter: blur(8px);
        }

        .field-label {
            display: block;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: #d4af37;
            margin-bottom: 0.5rem;
            font-weight: 500;
        }
        .field-input {
            width: 100%;
            background: rgba(26, 6, 6, 0.7);
            border: 1px solid rgba(212, 175, 55, 0.22);
            color: #f5e6d3;
            padding: 0.85rem 1rem;
            border-radius: 2px;
            font-size: 1rem;
            font-family: 'Cormorant Garamond', serif;
            outline: none;
            transition: border-color 0.25s, box-shadow 0.25s;
        }
        .field-input.mono {
            font-family: 'Inter', monospace;
            letter-spacing: 0.12em;
        }
        .field-input:focus {
            border-color: rgba(212, 175, 55, 0.6);
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
        }
        .field-input::placeholder { color: rgba(245, 230, 211, 0.3); }

        .summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.7rem 0;
        }
        .summary-row .label {
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: rgba(245, 230, 211, 0.5);
        }
        .summary-row .value {
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            color: #f5e6d3;
        }
        .gold-line { height: 1px; background: linear-gradient(90deg, transparent, rgba(212,175,55,0.4), transparent); margin: 0.6rem 0; }

        .pay-btn {
            width: 100%;
            padding: 1rem;
            background: linear-gradient(135deg, #d4af37 0%, #b8860b 100%);
            color: #1a0606;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            font-size: 0.85rem;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            border: 1px solid rgba(212, 175, 55, 0.45);
            border-radius: 2px;
            cursor: pointer;
            transition: all 0.3s;
        }
        .pay-btn:hover {
            background: linear-gradient(135deg, #e6c45a 0%, #d4af37 100%);
            box-shadow: 0 8px 28px rgba(212, 175, 55, 0.3);
            transform: translateY(-1px);
        }

        .pay-overlay {
            background: rgba(26, 6, 6, 0.96);
            backdrop-filter: blur(12px);
            transition: opacity 0.4s;
        }

        .spinner {
            width: 56px;
            height: 56px;
            border: 3px solid rgba(212, 175, 55, 0.15);
            border-top-color: #d4af37;
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
            margin: 0 auto;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }

        .checkmark-circle {
            stroke-dasharray: 166;
            stroke-dashoffset: 166;
            animation: cstroke 0.6s cubic-bezier(0.65,0,0.45,1) forwards;
        }
        .checkmark-check {
            transform-origin: 50% 50%;
            stroke-dasharray: 48;
            stroke-dashoffset: 48;
            animation: cstroke 0.3s cubic-bezier(0.65,0,0.45,1) 0.7s forwards;
        }
        @@keyframes cstroke { 100% { stroke-dashoffset: 0; } }

        .card-type {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 11px;
            color: #d4af37;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            pointer-events: none;
        }
    </style>
}

<div class="min-h-screen pt-32 pb-16 px-6">
    <div class="max-w-4xl mx-auto">
        <p class="text-center text-[11px] font-sans tracking-[0.35em] uppercase text-gold-400 mb-4">Final confirmation</p>
        <h1 class="text-center font-serif font-semibold text-ivory-100 text-4xl md:text-5xl mb-2">Payment</h1>
        <p class="text-center font-garamond italic text-ivory-300/70 mb-12">for <span class="text-gold-400">@Model.ProductionTitle</span></p>

        <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
            <div class="md:col-span-2 checkout-panel h-fit">
                <h3 class="font-serif text-xl text-ivory-100 mb-5">Order</h3>
                <div class="summary-row">
                    <span class="label">Production</span>
                    <span class="value">@Model.ProductionTitle</span>
                </div>
                <div class="summary-row">
                    <span class="label">Date / Time</span>
                    <span class="value text-gold-400">@Model.PerformanceDateTime</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Stage))
                {
                    <div class="summary-row">
                        <span class="label">Stage</span>
                        <span class="value italic font-garamond">@Model.Stage</span>
                    </div>
                }
                <div class="summary-row">
                    <span class="label">Seats</span>
                    <span class="value">@Model.SelectedSeats</span>
                </div>
                <div class="gold-line"></div>
                <div class="summary-row">
                    <span class="label" style="font-size: 12px;">Total</span>
                    <span class="text-2xl font-serif font-semibold text-gold-400">@Model.TotalPrice.ToString("F2") EUR</span>
                </div>
            </div>

            <div class="md:col-span-3 checkout-panel">
                <h3 class="font-serif text-xl text-ivory-100 mb-5">Payment details</h3>
                <form id="payment-form" class="space-y-4" data-stripe-enabled="@(stripeEnabled ? "true" : "false")" data-stripe-pk="@stripePublishableKey">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ProductionTitle" />
                    <input type="hidden" asp-for="PerformanceDateTime" />
                    <input type="hidden" asp-for="Stage" />
                    <input type="hidden" asp-for="SelectedSeats" />
                    <input type="hidden" asp-for="TotalPrice" />
                    <input type="hidden" asp-for="PerformanceId" />
                    <input type="hidden" asp-for="StripePaymentIntentId" id="StripePaymentIntentId" />

                    <div>
                        <label class="field-label">Cardholder name</label>
                        <input asp-for="CardHolderName" class="field-input" placeholder="Jane Doe" autocomplete="cc-name">
                    </div>

                    @if (stripeEnabled)
                    {
                        <div>
                            <label class="field-label">Card</label>
                            <div id="stripe-card-element" class="field-input" style="padding: 1rem 1rem; min-height: 50px;"></div>
                            <p id="stripe-card-errors" class="mt-2 text-[12px] font-sans text-red-300" role="alert"></p>
                            <p class="mt-3 text-[11px] font-sans tracking-wider text-gold-500/70">
                                Stripe test card: <span class="font-mono text-gold-400">4242 4242 4242 4242</span> · any future date · any CVC.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="relative">
                            <label class="field-label">Card number</label>
                            <input id="CardNumber" name="CardNumber" class="field-input mono" placeholder="1234 5678 9012 3456" maxlength="19" inputmode="numeric" autocomplete="cc-number">
                            <span id="cardType" class="card-type"></span>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="field-label">Expiry (MM/YY)</label>
                                <input id="ExpiryDate" name="ExpiryDate" class="field-input mono" placeholder="MM/YY" maxlength="5" inputmode="numeric" autocomplete="cc-exp">
                            </div>
                            <div>
                                <label class="field-label">CVC</label>
                                <input id="Cvc" name="Cvc" class="field-input mono" placeholder="123" maxlength="3" inputmode="numeric" autocomplete="cc-csc">
                            </div>
                        </div>
                    }

                    <div class="pt-3">
                        <button type="submit" class="pay-btn">Pay @Model.TotalPrice.ToString("F2") EUR</button>
                    </div>
                    <p class="text-center text-[11px] font-sans tracking-wider uppercase text-gold-500/60 mt-3">
                        <svg class="w-3 h-3 inline-block mr-0.5 -mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg>
                        @(stripeEnabled ? "Secured by Stripe" : "Secure payment")
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="payment-overlay" class="pay-overlay fixed inset-0 z-50 flex flex-col items-center justify-center opacity-0 pointer-events-none">
    <div id="spinner-container" class="text-center">
        <div class="spinner"></div>
        <p class="mt-6 font-serif text-xl text-ivory-100">Processing payment</p>
        <p class="mt-1 font-garamond italic text-sm text-gold-500/70">Please don't close this page</p>
    </div>
    <div id="success-container" class="text-center hidden">
        <svg class="mx-auto" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52" width="84" height="84">
            <circle class="checkmark-circle" cx="26" cy="26" r="24" fill="none" stroke="#d4af37" stroke-width="3" />
            <path class="checkmark-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8" stroke="#e6c45a" stroke-width="4" />
        </svg>
        <h2 class="mt-6 font-serif text-2xl text-ivory-100">Booking confirmed</h2>
        <p class="mt-2 font-garamond italic text-sm text-gold-500/80">We've sent the tickets to your email.</p>
        <div id="qr-section" class="mt-6 hidden">
            <img id="qr-img" src="" alt="QR code" class="mx-auto rounded-sm" width="160" height="160">
            <p id="confirm-code" class="text-[11px] font-sans tracking-[0.25em] text-gold-400 mt-3"></p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="mt-7 inline-block btn-gold">Back to home</a>
    </div>
</div>

@section Scripts {
    @{
        var stripeEnabledJs = (ViewData["StripeEnabled"] is bool sb && sb);
        var stripePkJs = ViewData["StripePublishableKey"] as string ?? string.Empty;
    }
    @if (stripeEnabledJs)
    {
        <script src="https://js.stripe.com/v3/"></script>
    }
    <script>
        const form = document.getElementById('payment-form');
        const overlay = document.getElementById('payment-overlay');
        const spinner = document.getElementById('spinner-container');
        const success = document.getElementById('success-container');
        const stripeEnabled = form.dataset.stripeEnabled === 'true';

        function showOverlay() {
            overlay.classList.remove('opacity-0', 'pointer-events-none');
            spinner.classList.remove('hidden');
            success.classList.add('hidden');
        }
        function hideOverlay() {
            spinner.classList.add('hidden');
            overlay.classList.add('opacity-0', 'pointer-events-none');
        }
        function showSuccess(result) {
            spinner.classList.add('hidden');
            success.classList.remove('hidden');
            if (result.qrCodeUrl) {
                document.getElementById('qr-section').classList.remove('hidden');
                document.getElementById('qr-img').src = result.qrCodeUrl;
                document.getElementById('confirm-code').textContent = 'CODE: ' + result.confirmationCode;
            }
        }

        async function finalizeBooking(formData) {
            const response = await fetch("@Url.Action("ProcessPayment", "Booking")", {
                method: 'POST',
                body: formData,
            });
            if (!response.ok) {
                throw new Error("Payment processing error.");
            }
            return response.json();
        }

        if (stripeEnabled) {
            const stripe = Stripe(form.dataset.stripePk);
            const elements = stripe.elements();
            const card = elements.create('card', {
                style: {
                    base: {
                        color: '#f5e6d3',
                        fontFamily: '"Inter", monospace',
                        fontSize: '16px',
                        letterSpacing: '0.06em',
                        '::placeholder': { color: 'rgba(245, 230, 211, 0.3)' }
                    },
                    invalid: { color: '#fca5a5' }
                }
            });
            card.mount('#stripe-card-element');
            const errEl = document.getElementById('stripe-card-errors');
            card.on('change', e => { errEl.textContent = e.error ? e.error.message : ''; });

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const cardName = form.querySelector("#CardHolderName").value.trim();
                if (!cardName) {
                    alert("Please enter the cardholder name.");
                    return;
                }
                showOverlay();
                try {
                    // 1. Create the PaymentIntent on the server.
                    const intentForm = new FormData();
                    intentForm.set('amount', form.querySelector('input[name="TotalPrice"]').value);
                    intentForm.set('performanceId', form.querySelector('input[name="PerformanceId"]').value || '');
                    intentForm.set('selectedSeats', form.querySelector('input[name="SelectedSeats"]').value || '');
                    intentForm.set('__RequestVerificationToken', form.querySelector('input[name="__RequestVerificationToken"]').value);

                    const intentResp = await fetch("@Url.Action("CreatePaymentIntent", "Booking")", { method: 'POST', body: intentForm });
                    if (!intentResp.ok) {
                        const err = await intentResp.json().catch(() => ({}));
                        throw new Error(err.message || "Stripe did not return a PaymentIntent.");
                    }
                    const { clientSecret, paymentIntentId } = await intentResp.json();

                    // 2. Confirm the card payment with Stripe directly.
                    const confirm = await stripe.confirmCardPayment(clientSecret, {
                        payment_method: { card: card, billing_details: { name: cardName } }
                    });
                    if (confirm.error) throw new Error(confirm.error.message);
                    if (!confirm.paymentIntent || confirm.paymentIntent.status !== 'succeeded') {
                        throw new Error("Stripe did not confirm the payment.");
                    }

                    // 3. Finalize the booking on our backend.
                    document.getElementById('StripePaymentIntentId').value = confirm.paymentIntent.id;
                    const formData = new FormData(form);
                    const result = await finalizeBooking(formData);
                    if (result.success) showSuccess(result);
                    else { hideOverlay(); alert(result.message || "Payment failed."); }
                } catch (err) {
                    console.error('Stripe payment error:', err);
                    hideOverlay();
                    alert(err.message || "An error occurred while processing the payment.");
                }
            });
        } else {
            // Simulated card form — keeps offline / no-Stripe-keys deployments working.
            document.getElementById('CardNumber').addEventListener('input', function (e) {
                let v = e.target.value.replace(/\D/g, '').substring(0, 16);
                e.target.value = v.replace(/(.{4})/g, '$1 ').trim();
                const type = document.getElementById('cardType');
                if (v.startsWith('4')) type.textContent = 'Visa';
                else if (v.startsWith('5') || v.startsWith('2')) type.textContent = 'Mastercard';
                else if (v.startsWith('3')) type.textContent = 'Amex';
                else type.textContent = '';
            });
            document.getElementById('ExpiryDate').addEventListener('input', function (e) {
                let v = e.target.value.replace(/\D/g, '').substring(0, 4);
                if (v.length >= 2) v = v.substring(0, 2) + '/' + v.substring(2);
                e.target.value = v;
            });
            document.getElementById('Cvc').addEventListener('input', function (e) {
                e.target.value = e.target.value.replace(/\D/g, '').substring(0, 3);
            });

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const cardName = form.querySelector("#CardHolderName").value.trim();
                const cardNumber = form.querySelector("#CardNumber").value.replace(/\s/g, '');
                const expiry = form.querySelector("#ExpiryDate").value;
                const cvc = form.querySelector("#Cvc").value;

                if (!cardName || cardNumber.length < 16 || expiry.length < 5 || cvc.length < 3) {
                    alert("Please fill in all fields correctly.");
                    return;
                }
                showOverlay();
                try {
                    const formData = new FormData(form);
                    formData.set('CardNumber', cardNumber);
                    const result = await finalizeBooking(formData);
                    if (result.success) showSuccess(result);
                    else { hideOverlay(); alert(result.message || "Payment failed. Please try again."); }
                } catch (error) {
                    console.error('Payment Error:', error);
                    hideOverlay();
                    alert('An error occurred while processing the payment. Please try again.');
                }
            });
        }
    </script>
}
