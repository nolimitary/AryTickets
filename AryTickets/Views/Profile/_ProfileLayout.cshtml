@{
    Layout = "_Layout";
}
@section Styles {
    <style>
        .profile-sidebar-link {
            color: #71717a;
            transition: all 0.2s ease;
        }
        .profile-sidebar-link:hover {
            color: #fb7185;
            background: rgba(225, 29, 72, 0.05);
        }
        .profile-sidebar-link.active {
            color: #fb7185;
            background: rgba(225, 29, 72, 0.05);
            border-left: 2px solid #e11d48;
        }
    </style>
    @await RenderSectionAsync("PageStyles", required: false)
}
@RenderSection("Styles", required: false)
<div class="container mx-auto px-6 py-16 min-h-screen" style="background-color: #09090b;">
    <div class="pt-24">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">

            <aside class="lg:col-span-1">
                <div class="p-6 bg-[#141416] rounded-2xl shadow-lg text-center">
                    <div class="w-32 h-32 rounded-full mx-auto mb-4 flex items-center justify-center bg-[#09090b]" style="border: 3px solid rgba(225, 29, 72, 0.3);">
                        <svg class="w-20 h-20 text-zinc-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd"></path></svg>
                    </div>
                    <h2 class="text-2xl font-bold text-white" style="font-family: 'Outfit', sans-serif;">@ViewData["Username"]</h2>
                    @if (ViewData["IsCritic"] is true)
                    {
                        <span class="inline-flex items-center gap-1 mt-2 px-3 py-1 rounded-full text-xs font-semibold text-white" style="background-color: #e11d48; font-family: 'Outfit', sans-serif;">
                            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.37 2.448a1 1 0 00-.364 1.118l1.287 3.957c.3.921-.755 1.688-1.54 1.118l-3.37-2.448a1 1 0 00-1.176 0l-3.37 2.448c-.784.57-1.838-.197-1.539-1.118l1.287-3.957a1 1 0 00-.364-1.118L2.063 9.384c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.286-3.957z"></path></svg>
                            Verified Critic
                        </span>
                    }
                    <p class="text-zinc-500 text-sm mt-1" style="font-family: 'Outfit', sans-serif;">@ViewData["Email"]</p>
                    @if (ViewData["MemberSince"] != null)
                    {
                        <p class="text-zinc-600 text-xs mt-1" style="font-family: 'Outfit', sans-serif;">Member since @ViewData["MemberSince"]</p>
                    }
                </div>
                <nav class="mt-6 p-2 bg-[#141416] rounded-2xl shadow-lg">
                    <a asp-action="Index" asp-controller="Profile" class="profile-sidebar-link flex items-center space-x-3 py-3 px-4 rounded-lg" style="font-family: 'Outfit', sans-serif;">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                        <span>Dashboard</span>
                    </a>
                    <a asp-action="Reviews" asp-controller="Profile" class="profile-sidebar-link flex items-center space-x-3 py-3 px-4 rounded-lg" style="font-family: 'Outfit', sans-serif;">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                        <span>My Reviews</span>
                    </a>
                    <a asp-action="Favorites" asp-controller="Profile" class="profile-sidebar-link flex items-center space-x-3 py-3 px-4 rounded-lg" style="font-family: 'Outfit', sans-serif;">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
                        <span>Favorites</span>
                    </a>
                    <a asp-action="Settings" asp-controller="Profile" class="profile-sidebar-link flex items-center space-x-3 py-3 px-4 rounded-lg" style="font-family: 'Outfit', sans-serif;">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.096 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        <span>Settings</span>
                    </a>
                </nav>
            </aside>

            <main class="lg:col-span-3">
                @RenderBody()
            </main>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const links = document.querySelectorAll('.profile-sidebar-link');
            const currentPath = window.location.pathname;

            links.forEach(link => {
                const linkPath = new URL(link.href).pathname;
                if (linkPath === currentPath) {
                    link.classList.add('active');
                    link.classList.remove('text-zinc-500');
                } else {
                    link.classList.remove('active');
                    link.classList.add('text-zinc-500');
                }
            });
        });
    </script>
    @await RenderSectionAsync("PageScripts", required: false)
}
