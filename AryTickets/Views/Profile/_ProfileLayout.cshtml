@{
    Layout = "_Layout";
}
@section Styles {
    <style>
        .profile-card {
            background: rgba(43, 10, 10, 0.6);
            border: 1px solid rgba(212, 175, 55, 0.18);
            border-radius: 4px;
            backdrop-filter: blur(8px);
        }
        .profile-sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 16px;
            color: rgba(245, 230, 211, 0.7);
            font-family: 'Cormorant Garamond', serif;
            font-size: 16px;
            transition: all 0.25s ease;
            border-left: 3px solid transparent;
        }
        .profile-sidebar-link:hover {
            color: #f5e6d3;
            background: rgba(212, 175, 55, 0.04);
        }
        .profile-sidebar-link.active {
            color: #d4af37;
            background: rgba(212, 175, 55, 0.08);
            border-left-color: #d4af37;
        }
        .panel {
            background: rgba(43, 10, 10, 0.5);
            border: 1px solid rgba(212, 175, 55, 0.15);
            border-radius: 4px;
        }
    </style>
    @await RenderSectionAsync("PageStyles", required: false)
}
@RenderSection("Styles", required: false)

<div class="max-w-[1360px] mx-auto px-6 pt-32 pb-16 min-h-screen">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">

        <aside class="lg:col-span-1">
            <div class="profile-card p-6 text-center">
                <div class="w-28 h-28 rounded-full mx-auto mb-4 flex items-center justify-center bg-burgundy-900" style="border: 2px solid rgba(212, 175, 55, 0.45);">
                    <svg class="w-16 h-16 text-gold-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd"></path></svg>
                </div>
                <h2 class="font-serif text-2xl font-semibold text-ivory-100">@ViewData["Username"]</h2>
                @if (ViewData["IsCritic"] is true)
                {
                    <span class="inline-flex items-center gap-1 mt-2 px-3 py-1 rounded-sm text-[10px] font-sans font-medium tracking-widest uppercase text-burgundy-950" style="background: linear-gradient(135deg, #d4af37 0%, #b8860b 100%);">
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.37 2.448a1 1 0 00-.364 1.118l1.287 3.957c.3.921-.755 1.688-1.54 1.118l-3.37-2.448a1 1 0 00-1.176 0l-3.37 2.448c-.784.57-1.838-.197-1.539-1.118l1.287-3.957a1 1 0 00-.364-1.118L2.063 9.384c-.783-.57-.38-1.81.588-1.81h4.162a1 1 0 00.95-.69l1.286-3.957z"></path></svg>
                        Сертифициран критик
                    </span>
                }
                <p class="font-garamond italic text-sm text-gold-500/80 mt-2">@ViewData["Email"]</p>
                @if (ViewData["MemberSince"] != null)
                {
                    <p class="text-[11px] font-sans tracking-wider text-gold-500/60 mt-1 uppercase">Член от @ViewData["MemberSince"]</p>
                }
            </div>
            <nav class="mt-5 profile-card p-2 overflow-hidden">
                <a asp-action="Index" asp-controller="Profile" class="profile-sidebar-link">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
                    <span>Табло</span>
                </a>
                <a asp-action="Reviews" asp-controller="Profile" class="profile-sidebar-link">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                    <span>Моите отзиви</span>
                </a>
                <a asp-action="Favorites" asp-controller="Profile" class="profile-sidebar-link">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
                    <span>Любими</span>
                </a>
                <a asp-action="BookingHistory" asp-controller="Profile" class="profile-sidebar-link">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z"/></svg>
                    <span>История</span>
                </a>
                <a asp-action="Settings" asp-controller="Profile" class="profile-sidebar-link">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.096 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    <span>Настройки</span>
                </a>
            </nav>
        </aside>

        <main class="lg:col-span-3">
            @RenderBody()
        </main>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const links = document.querySelectorAll('.profile-sidebar-link');
            const currentPath = window.location.pathname;
            links.forEach(link => {
                const linkPath = new URL(link.href).pathname;
                if (linkPath === currentPath) link.classList.add('active');
            });
        });
    </script>
    @await RenderSectionAsync("PageScripts", required: false)
}
