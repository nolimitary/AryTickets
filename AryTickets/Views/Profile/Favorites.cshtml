@model IEnumerable<UserFavorite>
@{
    ViewData["Title"] = "Favorite productions";
    Layout = "_ProfileLayout";
}

<div class="p-8 panel">
    <h3 class="font-serif text-2xl font-semibold mb-2 text-ivory-100">Favorite productions</h3>
    <p class="font-garamond italic text-ivory-300/70 mb-8">Productions you've saved for later</p>

    @if (Model.Any())
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
            @foreach (var favorite in Model)
            {
                <a asp-controller="Production" asp-action="Details" asp-route-id="@favorite.ProductionId" class="group block">
                    <div class="rounded-sm overflow-hidden bg-burgundy-900 border border-gold-500/15 transition-all duration-500 group-hover:border-gold-400/50 group-hover:-translate-y-1">
                        <img src="@favorite.FullPosterUrl" alt="@favorite.ProductionTitle" class="w-full h-auto aspect-[2/3] object-cover">
                    </div>
                    <p class="mt-3 font-serif text-ivory-100 group-hover:text-gold-400 transition-colors truncate text-center">@favorite.ProductionTitle</p>
                </a>
            }
        </div>
    }
    else
    {
        <div class="text-center py-16">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center" style="background: rgba(212, 175, 55, 0.12); border: 1px solid rgba(212,175,55,0.3);">
                <svg class="w-8 h-8" fill="none" stroke="#d4af37" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path></svg>
            </div>
            <p class="font-garamond italic text-ivory-300/70">You haven't saved any productions yet.</p>
        </div>
    }
</div>
