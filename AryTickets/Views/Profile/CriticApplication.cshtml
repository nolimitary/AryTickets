@model AryTickets.Models.CriticApplicationViewModel
@{
    ViewData["Title"] = "Critic application";
    Layout = "_ProfileLayout";
}

<div class="space-y-10">
    <div class="panel p-8">
        <h3 class="font-serif text-2xl font-semibold text-ivory-100 mb-1">Critic application</h3>
        <p class="font-garamond italic text-ivory-300/70 mb-8">Tell us about your experience and your motivation to become a certified theatre critic.</p>

        <form asp-action="CriticApplication" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-burgundy-200 text-sm font-garamond italic"></div>

            <div>
                <label class="block text-[10px] font-sans tracking-[0.22em] uppercase text-gold-400 mb-2">Full name</label>
                <input asp-for="FullName" class="w-full px-4 py-2.5 bg-burgundy-950 border border-gold-500/22 rounded-sm text-ivory-100 font-garamond focus:border-gold-400/60 focus:outline-none" placeholder="Jane Doe" />
                <span asp-validation-for="FullName" class="text-burgundy-200 text-xs font-garamond italic mt-1"></span>
            </div>

            <div>
                <label class="block text-[10px] font-sans tracking-[0.22em] uppercase text-gold-400 mb-2">Bio</label>
                <textarea asp-for="Bio" rows="4" class="w-full px-4 py-2.5 bg-burgundy-950 border border-gold-500/22 rounded-sm text-ivory-100 font-garamond focus:border-gold-400/60 focus:outline-none resize-none" placeholder="Tell us about yourself and your experience writing theatre criticism…"></textarea>
                <span asp-validation-for="Bio" class="text-burgundy-200 text-xs font-garamond italic mt-1"></span>
            </div>

            <div>
                <label class="block text-[10px] font-sans tracking-[0.22em] uppercase text-gold-400 mb-2">Years of experience</label>
                <input asp-for="YearsOfExperience" type="number" min="0" max="50" class="w-full px-4 py-2.5 bg-burgundy-950 border border-gold-500/22 rounded-sm text-ivory-100 font-garamond focus:border-gold-400/60 focus:outline-none" placeholder="0" />
                <span asp-validation-for="YearsOfExperience" class="text-burgundy-200 text-xs font-garamond italic mt-1"></span>
            </div>

            <div>
                <label class="block text-[10px] font-sans tracking-[0.22em] uppercase text-gold-400 mb-2">Past employers</label>
                <textarea asp-for="PastEmployers" rows="3" class="w-full px-4 py-2.5 bg-burgundy-950 border border-gold-500/22 rounded-sm text-ivory-100 font-garamond focus:border-gold-400/60 focus:outline-none resize-none" placeholder="Publications, sites or organisations you've written for…"></textarea>
                <span asp-validation-for="PastEmployers" class="text-burgundy-200 text-xs font-garamond italic mt-1"></span>
            </div>

            <div>
                <label class="block text-[10px] font-sans tracking-[0.22em] uppercase text-gold-400 mb-2">Links to published reviews</label>
                <div id="review-links-container" class="space-y-3">
                    <div class="flex items-center gap-2">
                        <input type="url" name="ReviewLinks[0]" class="w-full px-4 py-2.5 bg-burgundy-950 border border-gold-500/22 rounded-sm text-ivory-100 font-garamond focus:border-gold-400/60 focus:outline-none" placeholder="https://example.com/my-review" />
                    </div>
                </div>
                <button type="button" id="add-review-link" class="mt-3 flex items-center gap-2 text-gold-400 hover:text-gold-300 transition-colors text-sm font-garamond italic">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    <span>Add another link</span>
                </button>
            </div>

            <div>
                <label class="block text-[10px] font-sans tracking-[0.22em] uppercase text-gold-400 mb-2">Motivation</label>
                <textarea asp-for="Motivation" rows="4" class="w-full px-4 py-2.5 bg-burgundy-950 border border-gold-500/22 rounded-sm text-ivory-100 font-garamond focus:border-gold-400/60 focus:outline-none resize-none" placeholder="Why do you want to be a certified critic on AryTix?"></textarea>
                <span asp-validation-for="Motivation" class="text-burgundy-200 text-xs font-garamond italic mt-1"></span>
            </div>

            <div class="flex justify-end pt-2">
                <button type="submit" class="btn-gold">Submit application</button>
            </div>
        </form>
    </div>
</div>

@section PageScripts {
    <script>
        (function () {
            let idx = 1;
            const container = document.getElementById('review-links-container');
            const addBtn = document.getElementById('add-review-link');
            addBtn.addEventListener('click', function () {
                const wrapper = document.createElement('div');
                wrapper.className = 'flex items-center gap-2';
                const input = document.createElement('input');
                input.type = 'url';
                input.name = 'ReviewLinks[' + idx + ']';
                input.className = 'w-full px-4 py-2.5 bg-burgundy-950 border border-gold-500/22 rounded-sm text-ivory-100 font-garamond focus:border-gold-400/60 focus:outline-none';
                input.placeholder = 'https://example.com/my-review';
                const removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.className = 'flex-shrink-0 w-9 h-9 flex items-center justify-center rounded-sm bg-burgundy-500/15 text-burgundy-200 hover:bg-burgundy-500/30 transition-colors';
                removeBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>';
                removeBtn.addEventListener('click', function () { wrapper.remove(); });
                wrapper.appendChild(input);
                wrapper.appendChild(removeBtn);
                container.appendChild(wrapper);
                idx++;
            });
        })();
    </script>
}
