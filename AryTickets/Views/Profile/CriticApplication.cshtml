@model AryTickets.Models.CriticApplicationViewModel
@{
    ViewData["Title"] = "Critic Application";
    Layout = "_ProfileLayout";
}

<div class="space-y-10">

    <div class="bg-[#141416] border border-white/[0.06] rounded-2xl p-8">
        <h3 class="text-2xl font-semibold text-white mb-1" style="font-family: 'Outfit', sans-serif;">Critic Application</h3>
        <p class="text-sm text-zinc-400 mb-8" style="font-family: 'Outfit', sans-serif;">Tell us about your experience and why you'd like to become a verified critic.</p>

        <form asp-action="CriticApplication" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm"></div>

            <!-- Full Name -->
            <div>
                <label asp-for="FullName" class="block text-sm text-zinc-400 mb-2" style="font-family: 'Outfit', sans-serif;"></label>
                <input asp-for="FullName" class="block w-full px-4 py-2.5 bg-[#0c0c0e] border border-white/[0.08] rounded-lg text-white text-sm focus:border-[#e11d48]/40 focus:outline-none transition-colors" placeholder="Your full name" />
                <span asp-validation-for="FullName" class="text-red-400 text-xs mt-1"></span>
            </div>

            <!-- Bio -->
            <div>
                <label asp-for="Bio" class="block text-sm text-zinc-400 mb-2" style="font-family: 'Outfit', sans-serif;"></label>
                <textarea asp-for="Bio" rows="4" class="block w-full px-4 py-2.5 bg-[#0c0c0e] border border-white/[0.08] rounded-lg text-white text-sm focus:border-[#e11d48]/40 focus:outline-none transition-colors resize-none" placeholder="Tell us about yourself and your background in film criticism..."></textarea>
                <span asp-validation-for="Bio" class="text-red-400 text-xs mt-1"></span>
            </div>

            <!-- Years of Experience -->
            <div>
                <label asp-for="YearsOfExperience" class="block text-sm text-zinc-400 mb-2" style="font-family: 'Outfit', sans-serif;"></label>
                <input asp-for="YearsOfExperience" type="number" min="0" max="50" class="block w-full px-4 py-2.5 bg-[#0c0c0e] border border-white/[0.08] rounded-lg text-white text-sm focus:border-[#e11d48]/40 focus:outline-none transition-colors" placeholder="0" />
                <span asp-validation-for="YearsOfExperience" class="text-red-400 text-xs mt-1"></span>
            </div>

            <!-- Past Employers -->
            <div>
                <label asp-for="PastEmployers" class="block text-sm text-zinc-400 mb-2" style="font-family: 'Outfit', sans-serif;"></label>
                <textarea asp-for="PastEmployers" rows="3" class="block w-full px-4 py-2.5 bg-[#0c0c0e] border border-white/[0.08] rounded-lg text-white text-sm focus:border-[#e11d48]/40 focus:outline-none transition-colors resize-none" placeholder="Publications, websites, or organizations you've written for..."></textarea>
                <span asp-validation-for="PastEmployers" class="text-red-400 text-xs mt-1"></span>
            </div>

            <!-- Review Links (Dynamic) -->
            <div>
                <label class="block text-sm text-zinc-400 mb-2" style="font-family: 'Outfit', sans-serif;">Links to Past Reviews</label>
                <div id="review-links-container" class="space-y-3">
                    <div class="flex items-center space-x-2">
                        <input type="url" name="ReviewLinks[0]" class="block w-full px-4 py-2.5 bg-[#0c0c0e] border border-white/[0.08] rounded-lg text-white text-sm focus:border-[#e11d48]/40 focus:outline-none transition-colors" placeholder="https://example.com/your-review" />
                    </div>
                </div>
                <button type="button" id="add-review-link" class="mt-3 flex items-center space-x-2 text-[#fb7185] text-sm hover:text-[#e11d48] transition-colors" style="font-family: 'Outfit', sans-serif;">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    <span>Add another link</span>
                </button>
            </div>

            <!-- Motivation -->
            <div>
                <label asp-for="Motivation" class="block text-sm text-zinc-400 mb-2" style="font-family: 'Outfit', sans-serif;"></label>
                <textarea asp-for="Motivation" rows="4" class="block w-full px-4 py-2.5 bg-[#0c0c0e] border border-white/[0.08] rounded-lg text-white text-sm focus:border-[#e11d48]/40 focus:outline-none transition-colors resize-none" placeholder="Why do you want to become a verified critic on AryTickets?"></textarea>
                <span asp-validation-for="Motivation" class="text-red-400 text-xs mt-1"></span>
            </div>

            <!-- Submit -->
            <div class="flex justify-end pt-2">
                <button type="submit" class="px-6 py-2.5 bg-[#e11d48] text-white text-sm font-medium tracking-wide rounded-lg hover:bg-[#be123c] transition-all duration-300" style="font-family: 'Outfit', sans-serif;">Submit Application</button>
            </div>
        </form>
    </div>

</div>

@section PageScripts {
    <script>
        (function () {
            let idx = 1;
            const container = document.getElementById('review-links-container');
            const addBtn = document.getElementById('add-review-link');

            addBtn.addEventListener('click', function () {
                const wrapper = document.createElement('div');
                wrapper.className = 'flex items-center space-x-2';

                const input = document.createElement('input');
                input.type = 'url';
                input.name = 'ReviewLinks[' + idx + ']';
                input.className = 'block w-full px-4 py-2.5 bg-[#0c0c0e] border border-white/[0.08] rounded-lg text-white text-sm focus:border-[#e11d48]/40 focus:outline-none transition-colors';
                input.placeholder = 'https://example.com/your-review';

                const removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.className = 'flex-shrink-0 w-9 h-9 flex items-center justify-center rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 transition-colors';
                removeBtn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>';
                removeBtn.addEventListener('click', function () {
                    wrapper.remove();
                });

                wrapper.appendChild(input);
                wrapper.appendChild(removeBtn);
                container.appendChild(wrapper);
                idx++;
            });
        })();
    </script>
}
