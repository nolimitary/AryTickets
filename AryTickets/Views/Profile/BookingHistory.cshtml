@model List<AryTickets.Models.Booking>
@using AryTickets.Models
@{
    ViewData["Title"] = "Booking History";
    Layout = "_ProfileLayout";
}

@section PageStyles {
    <style>
        .booking-card {
            background: #141416;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.04);
            transition: all 0.3s ease;
        }
        .booking-card:hover {
            border-color: rgba(225, 29, 72, 0.15);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
        }
        .booking-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 8px;
            border-radius: 6px;
            font-size: 0.7rem;
            font-weight: 600;
            background: rgba(225, 29, 72, 0.1);
            color: #fb7185;
        }
        .info-label {
            font-size: 0.65rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #52525b;
            margin-bottom: 2px;
        }
        .info-value {
            font-size: 0.85rem;
            font-weight: 500;
            color: #e4e4e7;
        }
    </style>
}

<div class="p-8 bg-[#141416] rounded-xl shadow-lg">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h3 class="text-2xl font-bold text-white" style="font-family: 'Outfit', sans-serif;">Booking History</h3>
            @if (Model != null && Model.Any())
            {
                <p class="text-zinc-500 text-sm mt-1" style="font-family: 'Outfit', sans-serif;">
                    @Model.Count booking@(Model.Count != 1 ? "s" : "") total
                </p>
            }
        </div>
        <div class="w-10 h-10 rounded-full flex items-center justify-center" style="background: rgba(225, 29, 72, 0.1);">
            <svg class="w-5 h-5" fill="none" stroke="#e11d48" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z"/>
            </svg>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="space-y-4">
            @foreach (var booking in Model.OrderByDescending(b => b.BookedAt))
            {
                <div class="booking-card p-5">
                    <div class="flex flex-col md:flex-row gap-5">

                        <!-- QR Code -->
                        <div class="flex-shrink-0 flex items-start justify-center">
                            <div class="w-24 h-24 rounded-lg overflow-hidden bg-white p-1">
                                <img src="@booking.QrCodeUrl" alt="QR Code" class="w-full h-full object-contain" loading="lazy">
                            </div>
                        </div>

                        <!-- Booking Details -->
                        <div class="flex-1 min-w-0">
                            <!-- Movie title & confirmation -->
                            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-4">
                                <div>
                                    <h4 class="text-lg font-bold text-white leading-tight" style="font-family: 'Outfit', sans-serif;">@booking.MovieTitle</h4>
                                    <div class="mt-1.5">
                                        <span class="booking-badge" style="font-family: 'Outfit', sans-serif;">
                                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                                            Confirmed
                                        </span>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <p class="text-xl font-bold text-white" style="font-family: 'Outfit', sans-serif;">$@booking.TotalPrice.ToString("F2")</p>
                                </div>
                            </div>

                            <!-- Info Grid -->
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                                <div>
                                    <p class="info-label" style="font-family: 'Outfit', sans-serif;">Showtime</p>
                                    <p class="info-value" style="font-family: 'Outfit', sans-serif;">@booking.Showtime</p>
                                </div>
                                <div>
                                    <p class="info-label" style="font-family: 'Outfit', sans-serif;">Seats</p>
                                    <p class="info-value" style="font-family: 'Outfit', sans-serif;">@booking.Seats</p>
                                </div>
                                <div>
                                    <p class="info-label" style="font-family: 'Outfit', sans-serif;">Booked</p>
                                    <p class="info-value" style="font-family: 'Outfit', sans-serif;">@booking.BookedAt.ToString("MMM dd, yyyy")</p>
                                </div>
                                <div>
                                    <p class="info-label" style="font-family: 'Outfit', sans-serif;">Confirmation</p>
                                    <p class="info-value font-mono text-xs" style="color: #fb7185;">@booking.ConfirmationCode</p>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-16">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center" style="background: rgba(225, 29, 72, 0.1);">
                <svg class="w-8 h-8" fill="none" stroke="#e11d48" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z"/>
                </svg>
            </div>
            <p class="text-zinc-500 mb-1" style="font-family: 'Outfit', sans-serif;">No bookings yet</p>
            <p class="text-zinc-600 text-sm" style="font-family: 'Outfit', sans-serif;">Your booking history will appear here once you purchase tickets.</p>
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 mt-6 px-5 py-2.5 rounded-lg text-sm font-semibold text-white transition-all duration-200" style="background: #e11d48; font-family: 'Outfit', sans-serif;" onmouseover="this.style.background='#be123c'" onmouseout="this.style.background='#e11d48'">
                Browse Movies
            </a>
        </div>
    }
</div>
