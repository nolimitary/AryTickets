@model List<AryTickets.Models.BookingHistoryItem>
@using AryTickets.Models
@{
    ViewData["Title"] = "Booking history";
    Layout = "_ProfileLayout";
}

@section PageStyles {
    <style>
        .booking-card {
            background: rgba(43, 10, 10, 0.55);
            border: 1px solid rgba(212, 175, 55, 0.15);
            border-radius: 4px;
            transition: all 0.3s ease;
        }
        .booking-card:hover {
            border-color: rgba(212, 175, 55, 0.4);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.45);
        }
        .booking-card.past { opacity: 0.7; }
        .info-label {
            font-family: 'Inter', sans-serif;
            font-size: 10px;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: #d4af37;
            margin-bottom: 4px;
        }
        .info-value {
            font-family: 'Cormorant Garamond', serif;
            font-size: 15px;
            color: #f5e6d3;
        }
        .badge-past {
            display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px;
            font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 500;
            letter-spacing: 0.1em; text-transform: uppercase;
            background: rgba(139,105,20,0.18); color: #c9a961;
            border: 1px solid rgba(212,175,55,0.25); border-radius: 2px;
        }
    </style>
}

<div class="panel p-8">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h3 class="font-serif text-2xl font-semibold text-ivory-100">Booking history</h3>
            @if (Model != null && Model.Any())
            {
                <p class="font-garamond italic text-ivory-300/70 mt-1">@Model.Count booking@(Model.Count != 1 ? "s" : "") in total</p>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-gold-400/10 border border-gold-400/30 text-gold-400 px-5 py-3.5 rounded-sm mb-6">
            <p class="font-garamond italic">@TempData["SuccessMessage"]</p>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-burgundy-500/20 border border-burgundy-400/40 text-burgundy-200 px-5 py-3.5 rounded-sm mb-6">
            <p class="font-garamond italic">@TempData["ErrorMessage"]</p>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="space-y-4">
            @foreach (var item in Model)
            {
                var booking = item.Booking;
                var cardClass = item.IsPast ? "booking-card past p-5" : "booking-card p-5";
                <div class="@cardClass">
                    <div class="flex flex-col md:flex-row gap-5">
                        <div class="flex-shrink-0 flex items-start justify-center">
                            <div class="w-24 h-24 rounded-sm overflow-hidden bg-ivory-100 p-1.5">
                                <img src="@booking.QrCodeUrl" alt="QR Code" class="w-full h-full object-contain" loading="lazy">
                            </div>
                        </div>

                        <div class="flex-1 min-w-0">
                            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-4">
                                <div>
                                    <h4 class="font-serif text-lg font-semibold text-ivory-100 leading-tight">@booking.ProductionTitle</h4>
                                    <div class="mt-1.5 flex flex-wrap gap-1.5">
                                        @if (item.IsPast)
                                        {
                                            <span class="badge-past">
                                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.828a1 1 0 101.415-1.414L11 9.586V6z" clip-rule="evenodd"/></svg>
                                                Past show
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-sm text-[10px] font-sans font-medium tracking-widest uppercase bg-gold-400/15 text-gold-400 border border-gold-400/35">
                                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                                                Confirmed
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="text-right">
                                    <p class="font-serif text-xl font-semibold text-gold-400">@booking.TotalPrice.ToString("F2") EUR</p>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
                                <div>
                                    <p class="info-label">Performance</p>
                                    <p class="info-value">@booking.PerformanceDateTime</p>
                                </div>
                                <div>
                                    <p class="info-label">Seats</p>
                                    <p class="info-value font-mono">@booking.Seats</p>
                                </div>
                                <div>
                                    <p class="info-label">Booked</p>
                                    <p class="info-value">@booking.BookedAt.ToString("dd MMM yyyy")</p>
                                </div>
                                <div>
                                    <p class="info-label">Code</p>
                                    <p class="info-value font-mono text-[13px] text-gold-300">@booking.ConfirmationCode</p>
                                </div>
                            </div>

                            @if (item.CanCancel)
                            {
                                <form asp-controller="Booking" asp-action="CancelBooking" method="post"
                                      onsubmit="return confirm('Cancel this booking? Your seats will be released back to the pool.');"
                                      class="flex justify-end">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@booking.Id" />
                                    <button type="submit"
                                            class="text-[11px] font-sans tracking-[0.22em] uppercase font-medium px-4 py-2 rounded-sm border border-burgundy-400/40 text-burgundy-200 hover:bg-burgundy-500 hover:text-ivory-100 transition-all">
                                        Cancel booking
                                    </button>
                                </form>
                            }
                            else if (!item.IsPast && item.ShowDateTime.HasValue)
                            {
                                <p class="text-right text-[11px] font-sans italic text-gold-500/60">
                                    Cancellation closed — show is within 2 hours.
                                </p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-16">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center" style="background: rgba(212,175,55,0.12); border: 1px solid rgba(212,175,55,0.3);">
                <svg class="w-8 h-8" fill="none" stroke="#d4af37" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z"/>
                </svg>
            </div>
            <p class="font-serif text-ivory-100 text-lg mb-1">No bookings yet</p>
            <p class="font-garamond italic text-ivory-300/60">Your history will appear here after you book your first tickets.</p>
            <a asp-controller="Home" asp-action="Index" class="btn-gold mt-6">
                Browse productions
            </a>
        </div>
    }
</div>
