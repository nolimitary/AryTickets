@model AryTickets.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Dashboard";
    Layout = "_ProfileLayout";
}

<div class="space-y-10">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 px-5 py-3.5 rounded-lg" role="alert">
            <p class="text-sm" style="font-family: 'Outfit', sans-serif;">@TempData["SuccessMessage"]</p>
        </div>
    }

    @if (Model.IsCritic)
    {
        <div class="flex items-center space-x-3 bg-[#e11d48]/10 border border-[#e11d48]/20 px-5 py-3.5 rounded-xl">
            <svg class="w-5 h-5 text-[#fb7185]" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <span class="text-[#fb7185] text-sm font-semibold tracking-wide" style="font-family: 'Outfit', sans-serif;">Verified Critic</span>
        </div>
    }

    <!-- Stats Row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 bg-[#141416] rounded-xl border border-white/[0.06]" style="border-top: 2px solid #e11d48;">
            <p class="stat-number text-4xl font-bold text-[#e11d48]" data-target="@Model.TicketCount" style="font-family: 'Outfit', sans-serif;">0</p>
            <p class="text-zinc-500 mt-2 text-sm" style="font-family: 'Outfit', sans-serif;">Tickets Purchased</p>
        </div>
        <div class="p-6 bg-[#141416] rounded-xl border border-white/[0.06]" style="border-top: 2px solid #e11d48;">
            <p class="stat-number text-4xl font-bold text-[#e11d48]" data-target="@Model.FavoritesCount" style="font-family: 'Outfit', sans-serif;">0</p>
            <p class="text-zinc-500 mt-2 text-sm" style="font-family: 'Outfit', sans-serif;">Favorites</p>
        </div>
        <div class="p-6 bg-[#141416] rounded-xl border border-white/[0.06]" style="border-top: 2px solid #e11d48;">
            <p class="stat-number text-4xl font-bold text-[#e11d48]" data-target="@Model.ReviewsCount" style="font-family: 'Outfit', sans-serif;">0</p>
            <p class="text-zinc-500 mt-2 text-sm" style="font-family: 'Outfit', sans-serif;">Reviews</p>
        </div>
        <div class="p-6 bg-[#141416] rounded-xl border border-white/[0.06]" style="border-top: 2px solid #e11d48;">
            <p class="stat-number text-4xl font-bold text-[#e11d48]" data-target="@((int)Model.TotalSpent)" data-prefix="$" data-decimals="@Model.TotalSpent.ToString("F2").Split('.')[1]" style="font-family: 'Outfit', sans-serif;">$0.00</p>
            <p class="text-zinc-500 mt-2 text-sm" style="font-family: 'Outfit', sans-serif;">Total Spent</p>
        </div>
    </div>

    <!-- Recent Bookings -->
    <div class="bg-[#141416] border border-white/[0.06] rounded-xl p-8">
        <h3 class="text-2xl font-semibold text-white mb-6" style="font-family: 'Outfit', sans-serif;">Recent Bookings</h3>

        @if (Model.RecentBookings != null && Model.RecentBookings.Count > 0)
        {
            <!-- Desktop Table -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead>
                        <tr class="border-b border-white/[0.06]">
                            <th class="pb-3 text-zinc-500 font-medium" style="font-family: 'Outfit', sans-serif;">Movie</th>
                            <th class="pb-3 text-zinc-500 font-medium" style="font-family: 'Outfit', sans-serif;">Showtime</th>
                            <th class="pb-3 text-zinc-500 font-medium" style="font-family: 'Outfit', sans-serif;">Seats</th>
                            <th class="pb-3 text-zinc-500 font-medium" style="font-family: 'Outfit', sans-serif;">Price</th>
                            <th class="pb-3 text-zinc-500 font-medium" style="font-family: 'Outfit', sans-serif;">Booked</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.RecentBookings.Take(5))
                        {
                            <tr class="border-b border-white/[0.04] hover:bg-white/[0.02] transition-colors">
                                <td class="py-4 text-white font-medium" style="font-family: 'Outfit', sans-serif;">@booking.MovieTitle</td>
                                <td class="py-4 text-zinc-400" style="font-family: 'Outfit', sans-serif;">@booking.Showtime</td>
                                <td class="py-4 text-zinc-400" style="font-family: 'Outfit', sans-serif;">@booking.Seats</td>
                                <td class="py-4 text-[#fb7185] font-medium" style="font-family: 'Outfit', sans-serif;">$@booking.TotalPrice.ToString("F2")</td>
                                <td class="py-4 text-zinc-500 text-xs" style="font-family: 'Outfit', sans-serif;">@booking.BookedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Cards -->
            <div class="md:hidden space-y-4">
                @foreach (var booking in Model.RecentBookings.Take(5))
                {
                    <div class="bg-[#09090b] rounded-lg p-4 border border-white/[0.04]">
                        <p class="text-white font-medium mb-2" style="font-family: 'Outfit', sans-serif;">@booking.MovieTitle</p>
                        <div class="grid grid-cols-2 gap-2 text-sm">
                            <div>
                                <span class="text-zinc-500" style="font-family: 'Outfit', sans-serif;">Showtime</span>
                                <p class="text-zinc-300" style="font-family: 'Outfit', sans-serif;">@booking.Showtime</p>
                            </div>
                            <div>
                                <span class="text-zinc-500" style="font-family: 'Outfit', sans-serif;">Seats</span>
                                <p class="text-zinc-300" style="font-family: 'Outfit', sans-serif;">@booking.Seats</p>
                            </div>
                            <div>
                                <span class="text-zinc-500" style="font-family: 'Outfit', sans-serif;">Price</span>
                                <p class="text-[#fb7185] font-medium" style="font-family: 'Outfit', sans-serif;">$@booking.TotalPrice.ToString("F2")</p>
                            </div>
                            <div>
                                <span class="text-zinc-500" style="font-family: 'Outfit', sans-serif;">Booked</span>
                                <p class="text-zinc-300" style="font-family: 'Outfit', sans-serif;">@booking.BookedAt.ToString("MMM dd, yyyy")</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-12">
                <svg class="w-12 h-12 mx-auto text-zinc-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                </svg>
                <p class="text-zinc-500 text-sm" style="font-family: 'Outfit', sans-serif;">No bookings yet</p>
            </div>
        }
    </div>

    <!-- Become a Critic -->
    @if (!Model.IsCritic && !Model.HasApplication)
    {
        <div class="bg-[#141416] border border-white/[0.06] rounded-xl p-8">
            <div class="flex items-start space-x-4">
                <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-[#e11d48]/10 flex items-center justify-center">
                    <svg class="w-6 h-6 text-[#fb7185]" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                </div>
                <div class="flex-1">
                    <h3 class="text-xl font-semibold text-white mb-2" style="font-family: 'Outfit', sans-serif;">Become a Critic</h3>
                    <p class="text-zinc-400 text-sm mb-6" style="font-family: 'Outfit', sans-serif;">
                        Share your expertise with the community. As a verified critic, your reviews will be highlighted
                        and carry a special badge, helping other moviegoers discover great films.
                    </p>
                    <a asp-action="CriticApplication" asp-controller="Profile" class="inline-block px-6 py-2.5 bg-[#e11d48] text-white text-sm font-medium tracking-wide rounded-lg hover:bg-[#be123c] transition-all duration-300" style="font-family: 'Outfit', sans-serif;">Apply Now</a>
                </div>
            </div>
        </div>
    }
    else if (Model.HasPendingApplication)
    {
        <div class="bg-[#141416] border border-white/[0.06] rounded-xl p-8">
            <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.828a1 1 0 101.415-1.414L11 9.586V6z" clip-rule="evenodd"/>
                </svg>
                <span class="text-yellow-500 text-sm font-semibold tracking-wide" style="font-family: 'Outfit', sans-serif;">Application Pending</span>
            </div>
            <p class="text-zinc-500 text-sm mt-2 ml-8" style="font-family: 'Outfit', sans-serif;">Your critic application is currently under review. We'll notify you once a decision has been made.</p>
        </div>
    }

</div>

@section PageScripts {
    <script>
        function animateValue(obj, start, end, duration) {
            const prefix = obj.getAttribute('data-prefix') || '';
            const decimals = obj.getAttribute('data-decimals') || '';
            let startTimestamp = null;
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                const current = Math.floor(progress * (end - start) + start);
                if (decimals) {
                    obj.innerHTML = prefix + current + '.' + (progress >= 1 ? decimals : '00');
                } else {
                    obj.innerHTML = prefix + current;
                }
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                }
            };
            window.requestAnimationFrame(step);
        }
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const statNumber = entry.target;
                    const target = +statNumber.getAttribute('data-target');
                    animateValue(statNumber, 0, target, 1500);
                    observer.unobserve(statNumber);
                }
            });
        }, { threshold: 0.5 });
        document.querySelectorAll('.stat-number').forEach(num => {
            observer.observe(num);
        });
    </script>
}
