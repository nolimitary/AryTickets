@model AryTickets.Models.HomeViewModel
@{
    ViewData["Title"] = "Home";
    var featuredMovie = Model.NowShowingMovies.FirstOrDefault();
    var secondaryMovies = Model.NowShowingMovies.Skip(1).Take(3).ToList();
    var topRated = Model.NowShowingMovies.OrderByDescending(m => m.VoteAverage).Take(5).ToList();
}

@section Styles {
    <style>
        /* ═══════════════════════════════════════════
           HERO
        ═══════════════════════════════════════════ */
        .hero-section {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: flex-end;
            overflow: hidden;
        }
        .hero-backdrop {
            position: absolute;
            inset: 0;
            z-index: 0;
        }
        .hero-backdrop img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: scale(1.05);
            transition: transform 8s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .hero-section.loaded .hero-backdrop img {
            transform: scale(1);
        }
        .hero-vignette {
            position: absolute;
            inset: 0;
            z-index: 1;
            background:
                linear-gradient(0deg, #0a0a0a 0%, rgba(10,10,10,0.8) 30%, rgba(10,10,10,0.2) 50%, rgba(10,10,10,0.4) 100%),
                linear-gradient(90deg, rgba(10,10,10,0.6) 0%, transparent 50%);
        }
        .hero-content {
            position: relative;
            z-index: 2;
        }

        /* Hero text reveals */
        .hero-label, .hero-title, .hero-desc, .hero-cta, .hero-meta {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .hero-section.loaded .hero-label { opacity: 1; transform: translateY(0); transition-delay: 0.3s; }
        .hero-section.loaded .hero-title { opacity: 1; transform: translateY(0); transition-delay: 0.5s; }
        .hero-section.loaded .hero-desc  { opacity: 1; transform: translateY(0); transition-delay: 0.7s; }
        .hero-section.loaded .hero-meta  { opacity: 1; transform: translateY(0); transition-delay: 0.8s; }
        .hero-section.loaded .hero-cta   { opacity: 1; transform: translateY(0); transition-delay: 0.9s; }

        /* Decorative line */
        .gold-line {
            width: 0;
            height: 1px;
            background: linear-gradient(90deg, #C9A96E, transparent);
            transition: width 1.2s cubic-bezier(0.16, 1, 0.3, 1) 1s;
        }
        .hero-section.loaded .gold-line { width: 120px; }

        /* ═══════════════════════════════════════════
           SECTION REVEALS
        ═══════════════════════════════════════════ */
        .reveal-up {
            opacity: 0;
            transform: translateY(50px);
            transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Stagger children */
        .stagger-children > * {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .stagger-children.visible > *:nth-child(1) { opacity: 1; transform: translateY(0); transition-delay: 0.05s; }
        .stagger-children.visible > *:nth-child(2) { opacity: 1; transform: translateY(0); transition-delay: 0.12s; }
        .stagger-children.visible > *:nth-child(3) { opacity: 1; transform: translateY(0); transition-delay: 0.19s; }
        .stagger-children.visible > *:nth-child(4) { opacity: 1; transform: translateY(0); transition-delay: 0.26s; }
        .stagger-children.visible > *:nth-child(5) { opacity: 1; transform: translateY(0); transition-delay: 0.33s; }
        .stagger-children.visible > *:nth-child(6) { opacity: 1; transform: translateY(0); transition-delay: 0.40s; }
        .stagger-children.visible > *:nth-child(7) { opacity: 1; transform: translateY(0); transition-delay: 0.47s; }
        .stagger-children.visible > *:nth-child(8) { opacity: 1; transform: translateY(0); transition-delay: 0.54s; }
        .stagger-children.visible > *:nth-child(9) { opacity: 1; transform: translateY(0); transition-delay: 0.61s; }
        .stagger-children.visible > *:nth-child(10) { opacity: 1; transform: translateY(0); transition-delay: 0.68s; }
        .stagger-children.visible > *:nth-child(n+11) { opacity: 1; transform: translateY(0); transition-delay: 0.75s; }

        /* ═══════════════════════════════════════════
           MOVIE CARDS
        ═══════════════════════════════════════════ */
        .film-card {
            position: relative;
            overflow: hidden;
            border-radius: 4px;
            background: #111;
            cursor: pointer;
        }
        .film-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), filter 0.7s;
        }
        .film-card:hover img {
            transform: scale(1.08);
            filter: brightness(0.7);
        }
        .film-card .card-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(0deg, rgba(10,10,10,0.95) 0%, rgba(10,10,10,0.3) 40%, transparent 100%);
            opacity: 0;
            transition: opacity 0.5s;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 1.5rem;
        }
        .film-card:hover .card-overlay {
            opacity: 1;
        }
        .film-card .card-overlay h3 {
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            color: #fff;
            font-size: 1.1rem;
            line-height: 1.3;
            margin-bottom: 0.4rem;
        }
        .film-card .card-overlay .card-meta {
            font-size: 0.75rem;
            color: #C9A96E;
            letter-spacing: 0.05em;
        }

        /* Rating ring */
        .rating-ring {
            position: absolute;
            top: 12px;
            right: 12px;
            width: 40px;
            height: 40px;
            z-index: 5;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .film-card:hover .rating-ring {
            opacity: 1;
        }
        .rating-ring svg {
            transform: rotate(-90deg);
        }

        /* ═══════════════════════════════════════════
           CAROUSEL
        ═══════════════════════════════════════════ */
        .scroll-track {
            display: flex;
            gap: 1.25rem;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            scrollbar-width: none;
            scroll-behavior: smooth;
            padding-bottom: 1rem;
        }
        .scroll-track::-webkit-scrollbar { display: none; }
        .scroll-track > * {
            flex: 0 0 calc(100% / 6 - 1.05rem);
            min-width: calc(100% / 6 - 1.05rem);
            scroll-snap-align: start;
        }
        @@media (max-width: 1280px) {
            .scroll-track > * { flex: 0 0 calc(100% / 5 - 1rem); min-width: calc(100% / 5 - 1rem); }
        }
        @@media (max-width: 1024px) {
            .scroll-track > * { flex: 0 0 calc(100% / 4 - 0.94rem); min-width: calc(100% / 4 - 0.94rem); }
        }
        @@media (max-width: 768px) {
            .scroll-track > * { flex: 0 0 calc(100% / 3 - 0.84rem); min-width: calc(100% / 3 - 0.84rem); }
        }
        @@media (max-width: 500px) {
            .scroll-track > * { flex: 0 0 calc(100% / 2 - 0.63rem); min-width: calc(100% / 2 - 0.63rem); }
        }

        .scroll-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 44px;
            height: 44px;
            border-radius: 50%;
            border: 1px solid rgba(201,169,110,0.3);
            background: rgba(10,10,10,0.8);
            backdrop-filter: blur(10px);
            color: #C9A96E;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s;
            z-index: 10;
        }
        .scroll-arrow:hover {
            background: #C9A96E;
            color: #0a0a0a;
            border-color: #C9A96E;
        }
        .scroll-arrow.left { left: -22px; }
        .scroll-arrow.right { right: -22px; }

        /* ═══════════════════════════════════════════
           FEATURED SPOTLIGHT
        ═══════════════════════════════════════════ */
        .spotlight {
            position: relative;
            overflow: hidden;
        }
        .spotlight-bg {
            position: absolute;
            inset: 0;
        }
        .spotlight-bg img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: blur(40px) brightness(0.3) saturate(1.3);
            transform: scale(1.3);
        }
        .spotlight-gradient {
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, #0a0a0a 0%, rgba(10,10,10,0.7) 50%, rgba(10,10,10,0.3) 100%);
        }

        /* ═══════════════════════════════════════════
           TOP RATED BAR
        ═══════════════════════════════════════════ */
        .rank-number {
            font-family: 'Playfair Display', serif;
            font-size: 4rem;
            font-weight: 800;
            line-height: 1;
            color: transparent;
            -webkit-text-stroke: 1px rgba(201,169,110,0.25);
            transition: -webkit-text-stroke-color 0.3s;
        }
        .rank-item:hover .rank-number {
            -webkit-text-stroke-color: rgba(201,169,110,0.6);
        }

        /* ═══════════════════════════════════════════
           COMING SOON GRID
        ═══════════════════════════════════════════ */
        .cs-card {
            position: relative;
            overflow: hidden;
            border-radius: 4px;
            aspect-ratio: 2/3;
        }
        .cs-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .cs-card:hover img {
            transform: scale(1.06);
        }
        .cs-card .cs-info {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 2rem 1.2rem 1.2rem;
            background: linear-gradient(0deg, rgba(10,10,10,0.95) 0%, transparent 100%);
            transform: translateY(10px);
            opacity: 0;
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .cs-card:hover .cs-info {
            transform: translateY(0);
            opacity: 1;
        }
        .cs-card .cs-date {
            position: absolute;
            top: 12px;
            left: 12px;
            background: rgba(10,10,10,0.75);
            backdrop-filter: blur(10px);
            padding: 0.35rem 0.7rem;
            border-radius: 2px;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #C9A96E;
            border: 1px solid rgba(201,169,110,0.15);
        }

        /* ═══════════════════════════════════════════
           SECTION LABEL
        ═══════════════════════════════════════════ */
        .section-label {
            font-size: 0.65rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: #C9A96E;
        }
        .section-title {
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            color: #fff;
        }

        /* Horizontal rule */
        .gold-hr {
            height: 1px;
            background: linear-gradient(90deg, rgba(201,169,110,0.4), transparent);
            border: none;
        }

        /* CTA button */
        .cta-gold {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.85rem 2rem;
            border: 1px solid rgba(201,169,110,0.4);
            color: #C9A96E;
            font-size: 0.8rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            text-decoration: none;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }
        .cta-gold::before {
            content: '';
            position: absolute;
            inset: 0;
            background: #C9A96E;
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: -1;
        }
        .cta-gold:hover {
            color: #0a0a0a;
            border-color: #C9A96E;
        }
        .cta-gold:hover::before {
            transform: scaleX(1);
        }
        .cta-gold svg {
            transition: transform 0.3s;
        }
        .cta-gold:hover svg {
            transform: translateX(4px);
        }
    </style>
}

<!-- ═══════════════════════════════════════════════════
     HERO SECTION
═══════════════════════════════════════════════════ -->
@if (featuredMovie != null)
{
    <section class="hero-section" id="hero">
        <div class="hero-backdrop">
            <img src="@featuredMovie.FullBackdropPath" alt="@featuredMovie.Title">
        </div>
        <div class="hero-vignette"></div>
        <div class="hero-content w-full max-w-[1400px] mx-auto px-8 pb-24 pt-40">
            <div class="max-w-2xl">
                <div class="hero-label flex items-center gap-4 mb-6">
                    <span class="inline-block w-2 h-2 rounded-full bg-gold-500 animate-pulse"></span>
                    <span class="text-[11px] uppercase tracking-[0.3em] text-gold-500">Now in cinemas</span>
                </div>
                <h1 class="hero-title font-display text-5xl md:text-7xl lg:text-8xl font-bold text-white leading-[0.95] mb-6">
                    @featuredMovie.Title
                </h1>
                <div class="gold-line mb-6"></div>
                <p class="hero-desc text-gray-400 text-base md:text-lg leading-relaxed mb-6 max-w-lg">
                    @(featuredMovie.Overview.Length > 180 ? featuredMovie.Overview.Substring(0, 180) + "..." : featuredMovie.Overview)
                </p>
                <div class="hero-meta flex items-center gap-6 mb-8">
                    @if (!string.IsNullOrEmpty(featuredMovie.ReleaseDate))
                    {
                        <span class="text-[12px] uppercase tracking-[0.1em] text-gray-500">@featuredMovie.ReleaseDate</span>
                    }
                    <span class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-gold-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        <span class="text-[13px] text-white font-medium">@featuredMovie.VoteAverage.ToString("F1")</span>
                        <span class="text-[12px] text-gray-600">/ 10</span>
                    </span>
                </div>
                <a asp-controller="Movie" asp-action="Details" asp-route-id="@featuredMovie.Id" class="hero-cta cta-gold">
                    <span>Get Tickets</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"/></svg>
                </a>
            </div>

            <!-- Secondary movies preview (bottom right) -->
            @if (secondaryMovies.Any())
            {
                <div class="hidden lg:flex absolute bottom-24 right-8 gap-4">
                    @foreach (var movie in secondaryMovies)
                    {
                        <a asp-controller="Movie" asp-action="Details" asp-route-id="@movie.Id" class="block w-28 group">
                            <div class="overflow-hidden rounded-sm mb-2">
                                <img src="@movie.FullPosterPath" alt="@movie.Title"
                                     class="w-full aspect-[2/3] object-cover transition-transform duration-500 group-hover:scale-110 opacity-60 group-hover:opacity-100">
                            </div>
                            <p class="text-[11px] text-gray-500 group-hover:text-gray-300 truncate transition-colors">@movie.Title</p>
                        </a>
                    }
                </div>
            }
        </div>

        <!-- Scroll indicator -->
        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2 opacity-50">
            <span class="text-[10px] uppercase tracking-[0.3em] text-gray-500">Scroll</span>
            <div class="w-px h-8 bg-gradient-to-b from-gold-500/50 to-transparent"></div>
        </div>
    </section>
}

<!-- ═══════════════════════════════════════════════════
     TOP RATED THIS WEEK
═══════════════════════════════════════════════════ -->
@if (topRated.Any())
{
    <section class="max-w-[1400px] mx-auto px-8 pt-24 pb-8 reveal-up">
        <div class="flex items-end justify-between mb-10">
            <div>
                <span class="section-label">Audience Favorites</span>
                <h2 class="section-title text-3xl md:text-4xl mt-2">Top Rated</h2>
            </div>
            <hr class="gold-hr flex-1 ml-8 hidden md:block">
        </div>
        <div class="grid gap-0 divide-y divide-gray-800/30 stagger-children">
            @{ var rank = 1; }
            @foreach (var movie in topRated)
            {
                <a asp-controller="Movie" asp-action="Details" asp-route-id="@movie.Id"
                   class="rank-item group flex items-center gap-6 md:gap-10 py-5 md:py-6 hover:bg-white/[0.02] transition-colors px-2 -mx-2 rounded no-underline">
                    <span class="rank-number">@rank</span>
                    <div class="w-12 h-16 md:w-14 md:h-20 rounded-sm overflow-hidden flex-shrink-0">
                        <img src="@movie.FullPosterPath" alt="@movie.Title" class="w-full h-full object-cover">
                    </div>
                    <div class="flex-1 min-w-0">
                        <h3 class="font-display text-lg md:text-xl text-white group-hover:text-gold-500 transition-colors truncate">@movie.Title</h3>
                        <p class="text-[12px] text-gray-600 mt-1">@movie.ReleaseDate</p>
                    </div>
                    <div class="hidden sm:flex items-center gap-2">
                        <svg class="w-4 h-4 text-gold-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        <span class="text-sm text-white font-medium">@movie.VoteAverage.ToString("F1")</span>
                    </div>
                    <svg class="w-5 h-5 text-gray-700 group-hover:text-gold-500 transition-all group-hover:translate-x-1 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                </a>
                rank++;
            }
        </div>
    </section>
}

<!-- ═══════════════════════════════════════════════════
     NOW SHOWING CAROUSEL
═══════════════════════════════════════════════════ -->
<section id="now-showing" class="max-w-[1400px] mx-auto px-8 py-20 reveal-up">
    <div class="flex items-end justify-between mb-10">
        <div>
            <span class="section-label">In Theatres</span>
            <h2 class="section-title text-3xl md:text-4xl mt-2">Now Showing</h2>
        </div>
        <hr class="gold-hr flex-1 ml-8 hidden md:block">
    </div>
    <div class="relative">
        <div id="nowShowingTrack" class="scroll-track">
            @foreach (var movie in Model.NowShowingMovies.Skip(1))
            {
                <a asp-controller="Movie" asp-action="Details" asp-route-id="@movie.Id" class="block no-underline">
                    <div class="film-card aspect-[2/3]">
                        <img src="@movie.FullPosterPath" alt="@movie.Title" loading="lazy">
                        <div class="rating-ring">
                            <svg viewBox="0 0 40 40" width="40" height="40">
                                <circle cx="20" cy="20" r="17" fill="rgba(10,10,10,0.7)" stroke="rgba(201,169,110,0.15)" stroke-width="2"/>
                                <circle cx="20" cy="20" r="17" fill="none" stroke="#C9A96E" stroke-width="2"
                                        stroke-dasharray="@((movie.VoteAverage * 10.68).ToString("F1")) 106.8"
                                        stroke-linecap="round"/>
                            </svg>
                            <span class="absolute inset-0 flex items-center justify-center text-[10px] font-semibold text-white">@movie.VoteAverage.ToString("F1")</span>
                        </div>
                        <div class="card-overlay">
                            <h3>@movie.Title</h3>
                            <span class="card-meta">@movie.ReleaseDate</span>
                        </div>
                    </div>
                </a>
            }
        </div>
        <button id="nowShowingPrev" class="scroll-arrow left hidden md:flex">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
        </button>
        <button id="nowShowingNext" class="scroll-arrow right hidden md:flex">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
        </button>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════
     FEATURED SPOTLIGHT
═══════════════════════════════════════════════════ -->
@if (featuredMovie != null)
{
    var spotlightMovie = Model.NowShowingMovies.Skip(1).FirstOrDefault() ?? featuredMovie;
    <section class="spotlight py-24 md:py-32 reveal-up">
        <div class="spotlight-bg">
            <img src="@spotlightMovie.FullBackdropPath" alt="">
        </div>
        <div class="spotlight-gradient"></div>
        <div class="relative z-10 max-w-[1400px] mx-auto px-8">
            <div class="grid md:grid-cols-5 gap-12 md:gap-16 items-center">
                <div class="md:col-span-2">
                    <div class="max-w-xs mx-auto md:mx-0">
                        <img src="@spotlightMovie.FullPosterPath" alt="@spotlightMovie.Title"
                             class="w-full rounded shadow-2xl shadow-black/50">
                    </div>
                </div>
                <div class="md:col-span-3">
                    <span class="section-label">Featured Film</span>
                    <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white mt-3 mb-4 leading-[1.05]">
                        @spotlightMovie.Title
                    </h2>
                    <div class="flex items-center gap-4 mb-6">
                        <span class="flex items-center gap-2">
                            <svg class="w-4 h-4 text-gold-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                            <span class="text-white font-medium">@spotlightMovie.VoteAverage.ToString("F1")</span>
                        </span>
                        @if (!string.IsNullOrEmpty(spotlightMovie.ReleaseDate))
                        {
                            <span class="text-[12px] text-gray-500 uppercase tracking-wider">@spotlightMovie.ReleaseDate</span>
                        }
                    </div>
                    <p class="text-gray-400 leading-relaxed mb-8 max-w-xl">@spotlightMovie.Overview</p>
                    <a asp-controller="Movie" asp-action="Details" asp-route-id="@spotlightMovie.Id" class="cta-gold">
                        <span>View Details</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"/></svg>
                    </a>
                </div>
            </div>
        </div>
    </section>
}

<!-- ═══════════════════════════════════════════════════
     COMING SOON
═══════════════════════════════════════════════════ -->
<section id="coming-soon" class="max-w-[1400px] mx-auto px-8 py-20">
    <div class="flex items-end justify-between mb-10 reveal-up">
        <div>
            <span class="section-label">On The Horizon</span>
            <h2 class="section-title text-3xl md:text-4xl mt-2">Coming Soon</h2>
        </div>
        <hr class="gold-hr flex-1 ml-8 hidden md:block">
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 md:gap-5 stagger-children">
        @foreach (var movie in Model.ComingSoonMovies)
        {
            <a asp-controller="Movie" asp-action="Details" asp-route-id="@movie.Id" class="block no-underline">
                <div class="cs-card">
                    <img src="@movie.FullPosterPath" alt="@movie.Title" loading="lazy">
                    @if (!string.IsNullOrEmpty(movie.ReleaseDate))
                    {
                        <span class="cs-date">@movie.ReleaseDate</span>
                    }
                    <div class="cs-info">
                        <h3 class="font-display text-sm md:text-base text-white font-medium leading-tight">@movie.Title</h3>
                    </div>
                </div>
            </a>
        }
    </div>
</section>

@section Scripts {
    <script>
        // Hero load animation
        window.addEventListener('load', () => {
            const hero = document.getElementById('hero');
            if (hero) {
                setTimeout(() => hero.classList.add('loaded'), 100);
            }
        });

        // Intersection Observer for reveals
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });

        document.querySelectorAll('.reveal-up, .stagger-children').forEach(el => observer.observe(el));

        // Carousel navigation
        function setupCarousel(trackId, prevId, nextId) {
            const track = document.getElementById(trackId);
            const prev = document.getElementById(prevId);
            const next = document.getElementById(nextId);
            if (!track || !prev || !next) return;

            next.addEventListener('click', () => track.scrollBy({ left: track.clientWidth * 0.8, behavior: 'smooth' }));
            prev.addEventListener('click', () => track.scrollBy({ left: -track.clientWidth * 0.8, behavior: 'smooth' }));
        }
        setupCarousel('nowShowingTrack', 'nowShowingPrev', 'nowShowingNext');
    </script>
}