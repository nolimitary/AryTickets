@model AryTickets.Models.HomeViewModel
@{
    ViewData["Title"] = "Home";
    var featured = Model.NowShowingMovies.FirstOrDefault();
    var heroSecondary = Model.NowShowingMovies.Skip(1).Take(3).ToList();
}

@section Styles {
    <style>
        /* ── HERO ── */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: flex-end;
            overflow: hidden;
        }
        .hero-bg {
            position: absolute;
            inset: 0;
        }
        .hero-bg img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: scale(1.03);
            transition: transform 12s ease-out;
        }
        .hero.loaded .hero-bg img { transform: scale(1); }
        .hero-overlay {
            position: absolute;
            inset: 0;
            background:
                linear-gradient(0deg, #09090b 0%, rgba(9,9,11,0.7) 35%, rgba(9,9,11,0.15) 55%, rgba(9,9,11,0.3) 100%),
                linear-gradient(90deg, rgba(9,9,11,0.7) 0%, transparent 50%);
        }

        .h-anim {
            opacity: 0;
            transform: translateY(24px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }
        .hero.loaded .h-anim { opacity: 1; transform: translateY(0); }
        .hero.loaded .hd1 { transition-delay: 0.15s; }
        .hero.loaded .hd2 { transition-delay: 0.3s; }
        .hero.loaded .hd3 { transition-delay: 0.45s; }
        .hero.loaded .hd4 { transition-delay: 0.6s; }
        .hero.loaded .hd5 { transition-delay: 0.75s; }

        /* ── REVEALS ── */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.7s ease, transform 0.7s ease;
        }
        .reveal.vis { opacity: 1; transform: translateY(0); }

        .stagger > * {
            opacity: 0;
            transform: translateY(24px);
            transition: opacity 0.5s ease, transform 0.5s ease;
        }
        .stagger.vis > *:nth-child(1) { opacity:1; transform:translateY(0); transition-delay:.03s; }
        .stagger.vis > *:nth-child(2) { opacity:1; transform:translateY(0); transition-delay:.08s; }
        .stagger.vis > *:nth-child(3) { opacity:1; transform:translateY(0); transition-delay:.13s; }
        .stagger.vis > *:nth-child(4) { opacity:1; transform:translateY(0); transition-delay:.18s; }
        .stagger.vis > *:nth-child(5) { opacity:1; transform:translateY(0); transition-delay:.23s; }
        .stagger.vis > *:nth-child(6) { opacity:1; transform:translateY(0); transition-delay:.28s; }
        .stagger.vis > *:nth-child(7) { opacity:1; transform:translateY(0); transition-delay:.33s; }
        .stagger.vis > *:nth-child(8) { opacity:1; transform:translateY(0); transition-delay:.38s; }
        .stagger.vis > *:nth-child(9) { opacity:1; transform:translateY(0); transition-delay:.43s; }
        .stagger.vis > *:nth-child(10) { opacity:1; transform:translateY(0); transition-delay:.48s; }
        .stagger.vis > *:nth-child(n+11) { opacity:1; transform:translateY(0); transition-delay:.53s; }

        /* ── MOVIE CARD ── */
        .mc {
            border-radius: 12px;
            overflow: hidden;
            background: #141416;
            transition: transform 0.35s ease, box-shadow 0.35s ease;
        }
        .mc:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }
        .mc-img {
            position: relative;
            overflow: hidden;
            aspect-ratio: 2/3;
        }
        .mc-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        .mc:hover .mc-img img { transform: scale(1.05); }

        .mc-rating {
            position: absolute;
            top: 8px;
            right: 8px;
            display: inline-flex;
            align-items: center;
            gap: 3px;
            background: rgba(9,9,11,0.8);
            backdrop-filter: blur(8px);
            padding: 3px 7px;
            border-radius: 6px;
            line-height: 1;
        }
        .mc-rating svg { width: 11px; height: 11px; color: #fbbf24; flex-shrink: 0; }
        .mc-rating span { font-size: 11px; font-weight: 600; color: #fff; line-height: 1; }

        .mc-body {
            padding: 0.75rem 0.85rem;
        }
        .mc-body h3 {
            font-size: 0.9rem;
            font-weight: 600;
            color: #fff;
            line-height: 1.3;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            transition: color 0.25s;
        }
        .mc:hover .mc-body h3 { color: #fb7185; }
        .mc-body .mc-date {
            font-size: 0.7rem;
            color: #52525b;
            margin-top: 0.2rem;
        }

        /* ── SCROLL TRACK ── */
        .scroll-x {
            display: flex;
            gap: 1rem;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            scrollbar-width: none;
            scroll-behavior: smooth;
        }
        .scroll-x::-webkit-scrollbar { display: none; }
        .scroll-x > * {
            flex: 0 0 200px;
            min-width: 200px;
            scroll-snap-align: start;
        }
        @@media (max-width: 640px) {
            .scroll-x > * { flex: 0 0 160px; min-width: 160px; }
        }

        .s-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(9,9,11,0.85);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255,255,255,0.08);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
            z-index: 10;
        }
        .s-arrow:hover { background: #e11d48; border-color: #e11d48; }
        .s-arrow.l { left: -18px; }
        .s-arrow.r { right: -18px; }

        /* ── SPOTLIGHT ── */
        .spot {
            position: relative;
            overflow: hidden;
        }
        .spot-bg {
            position: absolute;
            inset: 0;
        }
        .spot-bg img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: blur(60px) brightness(0.2) saturate(1.5);
            transform: scale(1.5);
        }
        .spot-fade {
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, #09090b 0%, rgba(9,9,11,0.4) 50%, #09090b 100%);
        }

        /* ── CTA BUTTON ── */
        .btn-accent {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.7rem 1.5rem;
            background: #e11d48;
            color: #fff;
            font-size: 0.85rem;
            font-weight: 600;
            border-radius: 10px;
            text-decoration: none;
            transition: all 0.25s;
        }
        .btn-accent:hover {
            background: #be123c;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(225,29,72,0.3);
        }
        .btn-accent svg { transition: transform 0.2s; }
        .btn-accent:hover svg { transform: translateX(3px); }

        .btn-outline {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.7rem 1.5rem;
            background: transparent;
            border: 1px solid rgba(255,255,255,0.12);
            color: #fff;
            font-size: 0.85rem;
            font-weight: 500;
            border-radius: 10px;
            text-decoration: none;
            transition: all 0.25s;
        }
        .btn-outline:hover {
            background: rgba(255,255,255,0.06);
            border-color: rgba(255,255,255,0.2);
        }
    </style>
}

<!-- ═══ HERO ═══ -->
@if (featured != null)
{
    <section class="hero" id="hero">
        <div class="hero-bg">
            <img src="@featured.FullBackdropPath" alt="@featured.Title">
        </div>
        <div class="hero-overlay"></div>

        <div class="relative z-10 w-full max-w-[1360px] mx-auto px-6 pb-20 pt-48 lg:pb-24">
            <div class="max-w-xl">
                <div class="h-anim hd1 inline-flex items-center gap-2 bg-accent-500/10 border border-accent-500/20 rounded-full px-3.5 py-1.5 mb-5">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent-500 animate-pulse"></span>
                    <span class="text-xs font-medium text-accent-400">Now in cinemas</span>
                </div>
                <h1 class="h-anim hd2 text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-[1.05] mb-4">
                    @featured.Title
                </h1>
                <p class="h-anim hd3 text-zinc-400 text-[15px] leading-relaxed mb-5 max-w-md">
                    @(featured.Overview.Length > 160 ? featured.Overview.Substring(0, 160) + "..." : featured.Overview)
                </p>
                <div class="h-anim hd4 flex items-center gap-4 mb-7">
                    <div class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        <span class="text-sm font-semibold text-white">@featured.VoteAverage.ToString("F1")</span>
                        <span class="text-xs text-zinc-500">/10</span>
                    </div>
                    @if (!string.IsNullOrEmpty(featured.ReleaseDate))
                    {
                        <span class="text-xs text-zinc-600">|</span>
                        <span class="text-sm text-zinc-500">@featured.ReleaseDate</span>
                    }
                </div>
                <div class="h-anim hd5 flex items-center gap-3">
                    <a asp-controller="Movie" asp-action="Details" asp-route-id="@featured.Id" class="btn-accent">
                        <span>Get Tickets</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"/></svg>
                    </a>
                    <a asp-controller="Movie" asp-action="Details" asp-route-id="@featured.Id" class="btn-outline">
                        More Info
                    </a>
                </div>
            </div>

            <!-- Side posters -->
            @if (heroSecondary.Any())
            {
                <div class="hidden lg:flex absolute bottom-24 right-6 gap-3">
                    @foreach (var m in heroSecondary)
                    {
                        <a asp-controller="Movie" asp-action="Details" asp-route-id="@m.Id" class="block group">
                            <div class="w-24 rounded-lg overflow-hidden ring-1 ring-white/[0.06] transition-all duration-300 group-hover:ring-accent-500/40 group-hover:scale-105">
                                <img src="@m.FullPosterPath" alt="@m.Title" class="w-full aspect-[2/3] object-cover opacity-60 group-hover:opacity-100 transition-opacity">
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </section>
}

<!-- ═══ NOW SHOWING ═══ -->
<section id="now-showing" class="max-w-[1360px] mx-auto px-6 pt-20 pb-16">
    <div class="flex items-end justify-between mb-8 reveal">
        <div>
            <p class="text-xs font-medium text-accent-500 uppercase tracking-wider mb-1">In Theatres</p>
            <h2 class="text-2xl md:text-3xl font-bold text-white">Now Showing</h2>
        </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 stagger">
        @foreach (var movie in Model.NowShowingMovies.Skip(1))
        {
            <a asp-controller="Movie" asp-action="Details" asp-route-id="@movie.Id" class="block no-underline">
                <div class="mc">
                    <div class="mc-img">
                        <img src="@movie.FullPosterPath" alt="@movie.Title" loading="lazy">
                        <div class="mc-rating">
                            <svg fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                            <span>@movie.VoteAverage.ToString("F1")</span>
                        </div>
                    </div>
                    <div class="mc-body">
                        <h3>@movie.Title</h3>
                        <p class="mc-date">@movie.ReleaseDate</p>
                    </div>
                </div>
            </a>
        }
    </div>
</section>

<!-- ═══ SPOTLIGHT ═══ -->
@if (featured != null)
{
    var spot = Model.NowShowingMovies.OrderByDescending(m => m.VoteAverage).FirstOrDefault() ?? featured;
    <section class="spot py-20 md:py-28 reveal">
        <div class="spot-bg"><img src="@spot.FullBackdropPath" alt=""></div>
        <div class="spot-fade"></div>
        <div class="relative z-10 max-w-[1360px] mx-auto px-6">
            <div class="flex flex-col md:flex-row gap-10 md:gap-14 items-center">
                <a asp-controller="Movie" asp-action="Details" asp-route-id="@spot.Id" class="block flex-shrink-0 group">
                    <div class="w-48 md:w-56 rounded-xl overflow-hidden ring-1 ring-white/[0.06] transition-all duration-500 group-hover:-translate-y-2 group-hover:shadow-2xl group-hover:shadow-accent-500/10">
                        <img src="@spot.FullPosterPath" alt="@spot.Title" class="w-full aspect-[2/3] object-cover">
                    </div>
                </a>
                <div class="flex-1 text-center md:text-left">
                    <p class="text-xs font-medium text-accent-500 uppercase tracking-wider mb-2">Highest Rated</p>
                    <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4 leading-tight">@spot.Title</h2>
                    <div class="flex items-center gap-3 justify-center md:justify-start mb-5">
                        <div class="flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                            <span class="text-sm font-semibold text-white">@spot.VoteAverage.ToString("F1")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(spot.ReleaseDate))
                        {
                            <span class="text-xs text-zinc-600">|</span>
                            <span class="text-sm text-zinc-500">@spot.ReleaseDate</span>
                        }
                    </div>
                    <p class="text-zinc-400 leading-relaxed mb-7 max-w-xl mx-auto md:mx-0">@spot.Overview</p>
                    <a asp-controller="Movie" asp-action="Details" asp-route-id="@spot.Id" class="btn-accent">
                        <span>View Details</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"/></svg>
                    </a>
                </div>
            </div>
        </div>
    </section>
}

<!-- ═══ COMING SOON ═══ -->
<section id="coming-soon" class="max-w-[1360px] mx-auto px-6 py-20">
    <div class="flex items-end justify-between mb-8 reveal">
        <div>
            <p class="text-xs font-medium text-accent-500 uppercase tracking-wider mb-1">On The Horizon</p>
            <h2 class="text-2xl md:text-3xl font-bold text-white">Coming Soon</h2>
        </div>
    </div>
    <div class="relative reveal">
        <div id="csTrack" class="scroll-x">
            @foreach (var movie in Model.ComingSoonMovies)
            {
                <a asp-controller="Movie" asp-action="Details" asp-route-id="@movie.Id" class="block no-underline">
                    <div class="mc">
                        <div class="mc-img">
                            <img src="@movie.FullPosterPath" alt="@movie.Title" loading="lazy">
                            @if (!string.IsNullOrEmpty(movie.ReleaseDate))
                            {
                                <div class="mc-rating">
                                    <svg class="!text-zinc-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                                    <span>@movie.ReleaseDate</span>
                                </div>
                            }
                        </div>
                        <div class="mc-body">
                            <h3>@movie.Title</h3>
                        </div>
                    </div>
                </a>
            }
        </div>
        <button id="csPrev" class="s-arrow l hidden md:flex">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
        </button>
        <button id="csNext" class="s-arrow r hidden md:flex">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
        </button>
    </div>
</section>

@section Scripts {
    <script>
        window.addEventListener('load', () => {
            const h = document.getElementById('hero');
            if (h) setTimeout(() => h.classList.add('loaded'), 80);
        });

        const obs = new IntersectionObserver(entries => {
            entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('vis'); obs.unobserve(e.target); } });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal, .stagger').forEach(el => obs.observe(el));

        function setupScroll(tId, pId, nId) {
            const t = document.getElementById(tId), p = document.getElementById(pId), n = document.getElementById(nId);
            if (!t || !p || !n) return;
            n.addEventListener('click', () => t.scrollBy({ left: t.clientWidth * 0.7, behavior: 'smooth' }));
            p.addEventListener('click', () => t.scrollBy({ left: -t.clientWidth * 0.7, behavior: 'smooth' }));
        }
        setupScroll('csTrack', 'csPrev', 'csNext');
    </script>
}