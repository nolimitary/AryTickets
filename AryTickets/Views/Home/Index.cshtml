@model AryTickets.Models.HomeViewModel
@{
    ViewData["Title"] = "Home";
    var featured = Model.CurrentRepertoire.FirstOrDefault();
    var secondaryHero = Model.CurrentRepertoire.Skip(1).Take(3).ToList();
}

@section Styles {
    <style>
        /* ── HERO ── */
        .stage-hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: flex-end;
            overflow: hidden;
        }
        .stage-hero-bg {
            position: absolute;
            inset: 0;
        }
        .stage-hero-bg img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: scale(1.06);
            transition: transform 18s ease-out;
            filter: saturate(1.1) contrast(1.05);
        }
        .stage-hero.loaded .stage-hero-bg img { transform: scale(1); }

        .stage-overlay {
            position: absolute;
            inset: 0;
            background:
                linear-gradient(0deg, #1a0606 0%, rgba(26,6,6,0.85) 30%, rgba(26,6,6,0.45) 55%, rgba(26,6,6,0.65) 100%),
                linear-gradient(90deg, rgba(26,6,6,0.75) 0%, transparent 55%),
                radial-gradient(ellipse at 50% 110%, rgba(212,175,55,0.18) 0%, transparent 50%);
        }

        /* Theatrical curtain on the sides */
        .curtain-left, .curtain-right {
            position: absolute;
            top: 0;
            bottom: 0;
            width: 14%;
            pointer-events: none;
            z-index: 2;
        }
        .curtain-left {
            left: 0;
            background:
                linear-gradient(90deg, #2b0a0a 0%, rgba(43,10,10,0.6) 60%, transparent 100%),
                repeating-linear-gradient(90deg, rgba(0,0,0,0.25) 0px, rgba(0,0,0,0.25) 2px, transparent 2px, transparent 28px);
        }
        .curtain-right {
            right: 0;
            background:
                linear-gradient(-90deg, #2b0a0a 0%, rgba(43,10,10,0.6) 60%, transparent 100%),
                repeating-linear-gradient(-90deg, rgba(0,0,0,0.25) 0px, rgba(0,0,0,0.25) 2px, transparent 2px, transparent 28px);
        }

        .h-anim {
            opacity: 0;
            transform: translateY(28px);
            transition: opacity 1s ease, transform 1s ease;
        }
        .stage-hero.loaded .h-anim { opacity: 1; transform: translateY(0); }
        .stage-hero.loaded .hd1 { transition-delay: 0.2s; }
        .stage-hero.loaded .hd2 { transition-delay: 0.4s; }
        .stage-hero.loaded .hd3 { transition-delay: 0.6s; }
        .stage-hero.loaded .hd4 { transition-delay: 0.8s; }
        .stage-hero.loaded .hd5 { transition-delay: 1.0s; }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            color: #d4af37;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.35em;
            text-transform: uppercase;
        }
        .eyebrow::before, .eyebrow::after {
            content: '';
            width: 48px;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(212,175,55,0.5));
        }
        .eyebrow.left-only::after { display: none; }

        /* ── REVEALS ── */
        .reveal {
            opacity: 0;
            transform: translateY(36px);
            transition: opacity 0.9s ease, transform 0.9s ease;
        }
        .reveal.vis { opacity: 1; transform: translateY(0); }

        .stagger > * {
            opacity: 0;
            transform: translateY(28px);
            transition: opacity 0.7s ease, transform 0.7s ease;
        }
        @for (int i = 1; i <= 10; i++)
        {
            <text>.stagger.vis > *:nth-child(@i) { opacity:1; transform:translateY(0); transition-delay:@(i * 0.06)s; }</text>
        }
        .stagger.vis > *:nth-child(n+11) { opacity: 1; transform: translateY(0); transition-delay: .65s; }

        /* ── PRODUCTION CARD ── */
        .pc {
            position: relative;
            border-radius: 6px;
            overflow: hidden;
            background:
                linear-gradient(180deg, rgba(255,255,255,0.015) 0%, transparent 50%),
                #25141a;
            border: 1px solid rgba(212,175,55,0.14);
            box-shadow:
                0 1px 0 rgba(255,255,255,0.025) inset,
                0 12px 30px -22px rgba(0,0,0,0.65);
            transition: transform 0.45s cubic-bezier(.22,.61,.36,1), box-shadow 0.45s ease, border-color 0.45s ease;
        }
        .pc:hover {
            transform: translateY(-5px);
            border-color: rgba(212,175,55,0.38);
            box-shadow:
                0 1px 0 rgba(255,255,255,0.04) inset,
                0 28px 50px -18px rgba(0,0,0,0.75),
                0 0 0 1px rgba(212,175,55,0.18);
        }
        .pc-img {
            position: relative;
            overflow: hidden;
            aspect-ratio: 2/3;
            background: #1c0e11;
        }
        .pc-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.7s ease, filter 0.7s ease;
            filter: saturate(0.95) brightness(0.95);
        }
        .pc:hover .pc-img img {
            transform: scale(1.05);
            filter: saturate(1.05) brightness(1);
        }
        .pc-img::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent 45%, rgba(22,10,12,0.85) 100%);
            pointer-events: none;
        }

        .pc-genre {
            position: absolute;
            top: 12px;
            left: 12px;
            display: inline-flex;
            align-items: center;
            background: rgba(22,10,12,0.88);
            backdrop-filter: blur(4px);
            border: 1px solid rgba(212,175,55,0.32);
            padding: 5px 11px;
            border-radius: 2px;
            font-family: 'Inter', sans-serif;
            font-size: 10px;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: #d4af37;
            line-height: 1;
            z-index: 3;
        }

        .pc-rating {
            position: absolute;
            bottom: 14px;
            right: 14px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-family: 'Playfair Display', serif;
            font-size: 13px;
            color: #f7eede;
            text-shadow: 0 1px 4px rgba(0,0,0,0.7);
            z-index: 3;
        }
        .pc-rating .star {
            color: #d4af37;
            font-size: 14px;
        }

        .pc-body {
            padding: 1.15rem 1.1rem 1.3rem;
            text-align: center;
        }
        .pc-body h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.15rem;
            font-weight: 600;
            color: #f7eede;
            line-height: 1.3;
            margin-bottom: 0.4rem;
            transition: color 0.3s;
            min-height: 2.6em;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .pc:hover .pc-body h3 { color: #e6c45a; }
        .pc-body .pc-author {
            font-family: 'Cormorant Garamond', serif;
            font-style: italic;
            font-size: 0.95rem;
            color: #c9a961;
            opacity: 0.85;
        }

        /* Spotlight section */
        .spotlight {
            position: relative;
            overflow: hidden;
            background:
                radial-gradient(ellipse at 50% 0%, rgba(212,175,55,0.08) 0%, transparent 60%),
                #1a0606;
        }
        .spotlight-bg {
            position: absolute;
            inset: 0;
            opacity: 0.18;
        }
        .spotlight-bg img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: blur(40px) brightness(0.4) saturate(0.6) sepia(0.4);
            transform: scale(1.2);
        }
        .spotlight-fade {
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, #1a0606 0%, rgba(26,6,6,0.5) 50%, #1a0606 100%);
        }

        /* Genre chip */
        .genre-chip {
            display: inline-flex;
            align-items: center;
            padding: 0.5rem 1.2rem;
            background: transparent;
            border: 1px solid rgba(212,175,55,0.25);
            color: #c9a961;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            border-radius: 2px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .genre-chip:hover {
            background: rgba(212,175,55,0.08);
            border-color: #d4af37;
            color: #e6c45a;
        }
        .genre-chip.active {
            background: linear-gradient(135deg, #d4af37 0%, #b8860b 100%);
            border-color: #d4af37;
            color: #1a0606;
        }

        /* Scroll arrows */
        .scroll-x {
            display: flex;
            gap: 1.5rem;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            scrollbar-width: none;
            scroll-behavior: smooth;
        }
        .scroll-x::-webkit-scrollbar { display: none; }
        .scroll-x > * {
            flex: 0 0 230px;
            min-width: 230px;
            scroll-snap-align: start;
        }
        @@media (max-width: 640px) {
            .scroll-x > * { flex: 0 0 180px; min-width: 180px; }
        }

        .s-arrow {
            position: absolute;
            top: 42%;
            transform: translateY(-50%);
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(26,6,6,0.95);
            border: 1px solid rgba(212,175,55,0.35);
            color: #d4af37;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s;
            z-index: 10;
        }
        .s-arrow:hover {
            background: linear-gradient(135deg, #d4af37 0%, #b8860b 100%);
            color: #1a0606;
        }
        .s-arrow.l { left: -22px; }
        .s-arrow.r { right: -22px; }

        /* Section heading */
        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2rem, 3.5vw, 2.75rem);
            font-weight: 600;
            color: #f5e6d3;
            letter-spacing: 0.02em;
        }
        .section-title em {
            font-style: italic;
            color: #d4af37;
            font-weight: 500;
        }
    </style>
}

<!-- ═══ HERO ═══ -->
@if (featured != null)
{
    <section class="stage-hero" id="hero">
        <div class="stage-hero-bg">
            <img src="@featured.FullBackdropUrl" alt="@featured.Title">
        </div>
        <div class="stage-overlay"></div>
        <div class="curtain-left"></div>
        <div class="curtain-right"></div>

        <div class="relative z-10 w-full max-w-[1360px] mx-auto px-6 pb-24 pt-44 lg:pb-28">
            <div class="max-w-2xl">
                <div class="h-anim hd1 mb-7">
                    <span class="eyebrow left-only">In Repertoire · This Week</span>
                </div>
                <h1 class="h-anim hd2 font-serif text-5xl md:text-6xl lg:text-7xl font-semibold text-ivory-100 leading-[1.05] mb-4 tracking-tight">
                    @featured.Title
                </h1>
                @if (!string.IsNullOrEmpty(featured.Playwright))
                {
                    <p class="h-anim hd2 font-garamond text-xl text-gold-400 italic mb-6">by @featured.Playwright</p>
                }
                <p class="h-anim hd3 font-garamond text-[17px] md:text-[18px] text-ivory-200/80 leading-relaxed mb-7 max-w-xl">
                    @(featured.Synopsis.Length > 220 ? featured.Synopsis.Substring(0, 220) + "…" : featured.Synopsis)
                </p>
                <div class="h-anim hd4 flex items-center gap-5 mb-9 text-ivory-300/80">
                    <div class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-gold-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        <span class="font-serif text-base text-ivory-100">@featured.Rating.ToString("F1")</span>
                        <span class="text-sm text-gold-500/70">/10</span>
                    </div>
                    <span class="text-gold-500/30">•</span>
                    <span class="font-garamond text-base italic">@featured.Genre</span>
                    @if (featured.DurationMinutes > 0)
                    {
                        <span class="text-gold-500/30">•</span>
                        <span class="font-garamond text-base">@featured.FormattedDuration</span>
                    }
                </div>
                <div class="h-anim hd5 flex items-center gap-3">
                    <a asp-controller="Production" asp-action="Details" asp-route-id="@featured.Id" class="btn-gold">
                        <span>Book ticket</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"/></svg>
                    </a>
                    <a asp-controller="Production" asp-action="Details" asp-route-id="@featured.Id" class="btn-ghost">
                        Details
                    </a>
                </div>
            </div>

            @if (secondaryHero.Any())
            {
                <div class="hidden lg:flex absolute bottom-24 right-6 gap-4">
                    @foreach (var p in secondaryHero)
                    {
                        <a asp-controller="Production" asp-action="Details" asp-route-id="@p.Id" class="block group">
                            <div class="w-28 rounded-sm overflow-hidden ring-1 ring-gold-500/20 transition-all duration-500 group-hover:ring-gold-400/70 group-hover:-translate-y-1.5">
                                <img src="@p.FullPosterUrl" alt="@p.Title" class="w-full aspect-[2/3] object-cover opacity-65 group-hover:opacity-100 transition-opacity">
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </section>
}

<!-- ═══ GENRE FILTER ═══ -->
@if (Model.AllGenres.Any())
{
    <section class="max-w-[1360px] mx-auto px-6 pt-24 pb-2">
        <div class="flex items-center gap-2.5 flex-wrap reveal justify-center">
            <a asp-controller="Home" asp-action="Index" class="genre-chip @(Model.SelectedGenre == null ? "active" : "")">
                All
            </a>
            @foreach (var g in Model.AllGenres)
            {
                <a asp-controller="Home" asp-action="Index" asp-route-genre="@g" class="genre-chip @(Model.SelectedGenre == g ? "active" : "")">
                    @g
                </a>
            }
        </div>
    </section>
}

<!-- ═══ REPERTOAR ═══ -->
<section id="repertoar" class="max-w-[1360px] mx-auto px-6 pt-14 pb-20">
    <div class="text-center reveal mb-14">
        <span class="eyebrow mb-5">Playbill · On Stage</span>
        <h2 class="section-title mt-4">Current <em>Repertoire</em></h2>
        <p class="font-garamond italic text-lg text-ivory-200/60 mt-3 max-w-xl mx-auto">Classical and contemporary theatre, gathered under one roof for an unforgettable evening.</p>
    </div>

    @if (!Model.CurrentRepertoire.Skip(1).Any())
    {
        <p class="text-center font-garamond italic text-ivory-300/60">New productions coming soon.</p>
    }
    else
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6 stagger">
            @foreach (var production in Model.CurrentRepertoire.Skip(1))
            {
                <a asp-controller="Production" asp-action="Details" asp-route-id="@production.Id" class="block no-underline">
                    <div class="pc">
                        <div class="pc-img">
                            <img src="@production.FullPosterUrl" alt="@production.Title" loading="lazy">
                            @if (!string.IsNullOrEmpty(production.Genre))
                            {
                                <span class="pc-genre">@production.Genre</span>
                            }
                            @if (production.Rating > 0)
                            {
                                <span class="pc-rating">
                                    <span class="star">★</span>
                                    <span>@production.Rating.ToString("F1")</span>
                                </span>
                            }
                        </div>
                        <div class="pc-body">
                            <h3>@production.Title</h3>
                            @if (!string.IsNullOrEmpty(production.Playwright))
                            {
                                <p class="pc-author">@production.Playwright</p>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</section>

<!-- ═══ SPOTLIGHT ═══ -->
@{
    var spot = Model.CurrentRepertoire.OrderByDescending(p => p.Rating).FirstOrDefault();
}
@if (spot != null)
{
    <section class="spotlight py-24 md:py-32 reveal">
        <div class="spotlight-bg"><img src="@spot.FullBackdropUrl" alt=""></div>
        <div class="spotlight-fade"></div>
        <div class="relative z-10 max-w-[1360px] mx-auto px-6">
            <div class="flex flex-col md:flex-row gap-12 md:gap-16 items-center">
                <a asp-controller="Production" asp-action="Details" asp-route-id="@spot.Id" class="block flex-shrink-0 group">
                    <div class="w-52 md:w-64 rounded-sm overflow-hidden ring-1 ring-gold-500/30 transition-all duration-700 group-hover:-translate-y-2 group-hover:shadow-2xl group-hover:shadow-gold-500/15 group-hover:ring-gold-400/70">
                        <img src="@spot.FullPosterUrl" alt="@spot.Title" class="w-full aspect-[2/3] object-cover">
                    </div>
                </a>
                <div class="flex-1 text-center md:text-left">
                    <span class="eyebrow @(true ? "left-only" : "") mb-5">Production of the evening</span>
                    <h2 class="font-serif text-4xl md:text-5xl lg:text-6xl font-semibold text-ivory-100 mt-4 mb-3 leading-tight">@spot.Title</h2>
                    @if (!string.IsNullOrEmpty(spot.Playwright))
                    {
                        <p class="font-garamond italic text-xl text-gold-400 mb-6">by @spot.Playwright</p>
                    }
                    <div class="flex items-center gap-4 justify-center md:justify-start mb-6 text-ivory-200/80">
                        <span class="flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-gold-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                            <span class="font-serif text-base">@spot.Rating.ToString("F1")/10</span>
                        </span>
                        <span class="text-gold-500/30">•</span>
                        <span class="font-garamond italic">@spot.Genre</span>
                    </div>
                    <p class="font-garamond text-[18px] text-ivory-200/80 leading-relaxed mb-8 max-w-xl mx-auto md:mx-0">@spot.Synopsis</p>
                    <a asp-controller="Production" asp-action="Details" asp-route-id="@spot.Id" class="btn-gold">
                        <span>See performances</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"/></svg>
                    </a>
                </div>
            </div>
        </div>
    </section>
}

<!-- ═══ PREMIERI ═══ -->
@if (Model.UpcomingPremieres.Any())
{
    <section id="premieri" class="max-w-[1360px] mx-auto px-6 py-24">
        <div class="text-center reveal mb-14">
            <span class="eyebrow mb-5">Soon On Stage</span>
            <h2 class="section-title mt-4">Upcoming <em>Premieres</em></h2>
            <p class="font-garamond italic text-lg text-ivory-200/60 mt-3 max-w-xl mx-auto">Lifting the curtain on the season's new productions.</p>
        </div>
        <div class="relative reveal">
            <div id="csTrack" class="scroll-x">
                @foreach (var production in Model.UpcomingPremieres)
                {
                    <a asp-controller="Production" asp-action="Details" asp-route-id="@production.Id" class="block no-underline">
                        <div class="pc">
                            <div class="pc-img">
                                <img src="@production.FullPosterUrl" alt="@production.Title" loading="lazy">
                                @if (!string.IsNullOrEmpty(production.Genre))
                                {
                                    <span class="pc-genre">@production.Genre</span>
                                }
                                <span class="pc-rating">
                                    <span class="text-gold-400">◇</span>
                                    <span class="font-garamond italic text-sm">@production.FormattedPremiere</span>
                                </span>
                            </div>
                            <div class="pc-body">
                                <h3>@production.Title</h3>
                                @if (!string.IsNullOrEmpty(production.Playwright))
                                {
                                    <p class="pc-author">@production.Playwright</p>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>
            <button id="csPrev" class="s-arrow l hidden md:flex">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
            </button>
            <button id="csNext" class="s-arrow r hidden md:flex">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
            </button>
        </div>
    </section>
}

@section Scripts {
    <script>
        window.addEventListener('load', () => {
            const h = document.getElementById('hero');
            if (h) setTimeout(() => h.classList.add('loaded'), 80);
        });

        const obs = new IntersectionObserver(entries => {
            entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('vis'); obs.unobserve(e.target); } });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal, .stagger').forEach(el => obs.observe(el));

        function setupScroll(tId, pId, nId) {
            const t = document.getElementById(tId), p = document.getElementById(pId), n = document.getElementById(nId);
            if (!t || !p || !n) return;
            n.addEventListener('click', () => t.scrollBy({ left: t.clientWidth * 0.75, behavior: 'smooth' }));
            p.addEventListener('click', () => t.scrollBy({ left: -t.clientWidth * 0.75, behavior: 'smooth' }));
        }
        setupScroll('csTrack', 'csPrev', 'csNext');
    </script>
}
