@{
    ViewData["Title"] = "Check your email";
    Layout = "_Layout";
}

@section Styles {
    <style>
        @@keyframes fadeUpBlur {
            from { opacity: 0; transform: translateY(24px); filter: blur(6px); }
            to   { opacity: 1; transform: translateY(0); filter: blur(0); }
        }
        .fade-in { animation: fadeUpBlur 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
        .fade-delay-1 { animation-delay: 0.1s; opacity: 0; }
        .fade-delay-2 { animation-delay: 0.25s; opacity: 0; }
        .fade-delay-3 { animation-delay: 0.4s; opacity: 0; }
        .fade-delay-4 { animation-delay: 0.55s; opacity: 0; }
        .fade-delay-5 { animation-delay: 0.7s; opacity: 0; }
    </style>
}

<div class="min-h-screen flex items-center justify-center px-4 pt-24 pb-12">
    <div class="max-w-md w-full p-10 text-center space-y-8" style="background: rgba(43, 10, 10, 0.78); border: 1px solid rgba(212, 175, 55, 0.22); border-radius: 4px; backdrop-filter: blur(20px); box-shadow: 0 24px 48px rgba(0,0,0,0.5);">
        <div class="fade-in fade-delay-1">
            <div class="font-serif text-3xl tracking-wider">
                <span class="text-ivory-100 font-semibold">Ary</span><span class="text-gold-400 font-light italic">Tix</span>
            </div>
            <p class="text-[10px] font-sans tracking-[0.3em] uppercase text-gold-500/70 mt-1">T H E A T R I C A L &nbsp; S T A G E</p>
        </div>

        <div class="fade-in fade-delay-2">
            <div class="mx-auto flex items-center justify-center w-20 h-20 rounded-full border border-gold-400/35 bg-gold-400/10">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-gold-400" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
                </svg>
            </div>
        </div>

        <div class="fade-in fade-delay-3">
            <h1 class="font-serif text-2xl font-semibold text-ivory-100">Check your email</h1>
        </div>

        <p class="font-garamond italic text-ivory-300/80 leading-relaxed fade-in fade-delay-4">
            Thanks for signing up! We've sent a verification code to your email.
            Enter it on the next page to activate your account.
        </p>

        <div class="fade-in fade-delay-5">
            <a asp-action="ConfirmEmail" class="btn-gold">Enter code</a>
        </div>
    </div>
</div>
