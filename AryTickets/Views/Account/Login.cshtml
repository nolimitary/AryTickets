@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --noir-400: #0a0a0a;
            --noir-300: #0f0f0f;
            --noir-100: #1a1a1a;
            --gold-500: #C9A96E;
        }

        .font-display { font-family: 'Playfair Display', serif; }
        .font-body { font-family: 'DM Sans', sans-serif; }

        .bg-noir-400 { background-color: var(--noir-400); }
        .bg-noir-300 { background-color: var(--noir-300); }
        .bg-noir-100 { background-color: var(--noir-100); }
        .text-gold-500 { color: var(--gold-500); }
        .bg-gold-500 { background-color: var(--gold-500); }
        .border-gold-500 { border-color: var(--gold-500); }

        .noir-card {
            animation: fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
            opacity: 0;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .noir-input {
            background-color: var(--noir-300);
            border: 1px solid #2a2a2a;
            color: #fff;
            transition: border-color 0.3s ease;
        }
        .noir-input:focus {
            outline: none;
            border-color: rgba(201, 169, 110, 0.5);
        }
        .noir-input::placeholder {
            color: #555;
        }

        .noir-btn {
            border: 1px solid var(--gold-500);
            color: var(--gold-500);
            background: transparent;
            transition: all 0.3s ease;
        }
        .noir-btn:hover {
            background-color: var(--gold-500);
            color: var(--noir-400);
        }

        .noir-checkbox {
            accent-color: var(--gold-500);
        }

        .noir-link {
            color: #6b7280;
            transition: color 0.3s ease;
        }
        .noir-link:hover {
            color: var(--gold-500);
        }
    </style>
}

<div class="min-h-screen flex items-center justify-center px-4 bg-noir-400 font-body">
    <div class="noir-card w-full max-w-md p-10 bg-noir-100 rounded-sm" style="border: 1px solid rgba(201, 169, 110, 0.2);">

        <!-- Logo -->
        <div class="text-center mb-8">
            <span class="font-display text-3xl tracking-wide">
                <span class="text-white">Ary</span><span class="text-gold-500">Tix</span>
            </span>
        </div>

        <!-- Title -->
        <h2 class="font-display text-center text-2xl text-white mb-3">Welcome Back</h2>
        <div class="w-16 h-px bg-gold-500 mx-auto mb-8"></div>

        <form class="space-y-6" asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

            <!-- Email -->
            <div>
                <label asp-for="Email" class="block text-[12px] uppercase tracking-widest text-gray-500 mb-2">Email address</label>
                <input asp-for="Email" class="noir-input w-full px-4 py-3 rounded-sm text-sm" placeholder="you@example.com">
                <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Password -->
            <div>
                <label asp-for="Password" class="block text-[12px] uppercase tracking-widest text-gray-500 mb-2">Password</label>
                <input asp-for="Password" class="noir-input w-full px-4 py-3 rounded-sm text-sm" placeholder="Enter your password">
                <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- Remember Me -->
            <div class="flex items-center">
                <input asp-for="RememberMe" class="noir-checkbox h-4 w-4 rounded-sm border-gray-700 bg-noir-300">
                <label asp-for="RememberMe" class="ml-2 text-sm text-gray-400">
                    @Html.DisplayNameFor(m => m.RememberMe)
                </label>
            </div>

            <!-- Submit -->
            <div>
                <button type="submit" class="noir-btn w-full py-3 text-sm font-medium uppercase tracking-widest rounded-sm">
                    Sign in
                </button>
            </div>

            <!-- Register Link -->
            <div class="text-center pt-2">
                <a asp-action="Register" class="noir-link text-sm">
                    You aren't registered? Sign up
                </a>
            </div>
        </form>
    </div>
</div>
