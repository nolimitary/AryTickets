@model ConfirmEmailViewModel
@{
    ViewData["Title"] = "Confirm account";
    Layout = "_Layout";
}

@section Styles {
    <style>
        @@keyframes fadeUpBlur {
            from { opacity: 0; transform: translateY(24px); filter: blur(6px); }
            to   { opacity: 1; transform: translateY(0); filter: blur(0); }
        }
        .fade-in { animation: fadeUpBlur 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
        .fade-delay-1 { animation-delay: 0.1s; opacity: 0; }
        .fade-delay-2 { animation-delay: 0.25s; opacity: 0; }
        .fade-delay-3 { animation-delay: 0.4s; opacity: 0; }
        .fade-delay-4 { animation-delay: 0.55s; opacity: 0; }

        .code-input {
            background: rgba(26, 6, 6, 0.7);
            border: 1px solid rgba(212, 175, 55, 0.22);
            color: #d4af37;
            font-family: 'Playfair Display', serif;
            transition: border-color 0.3s;
        }
        .code-input:focus {
            outline: none;
            border-color: rgba(212, 175, 55, 0.6);
        }
        .code-input::placeholder { color: rgba(212, 175, 55, 0.25); }
    </style>
}

<div class="min-h-screen flex items-center justify-center px-4 pt-24 pb-12">
    <div class="max-w-md w-full panel p-10 space-y-8" style="background: rgba(43, 10, 10, 0.78); backdrop-filter: blur(20px); border-color: rgba(212, 175, 55, 0.22);">

        <div class="text-center fade-in fade-delay-1">
            <div class="font-serif text-3xl tracking-wider">
                <span class="text-ivory-100 font-semibold">Ary</span><span class="text-gold-400 font-light italic">Tix</span>
            </div>
            <p class="text-[10px] font-sans tracking-[0.3em] uppercase text-gold-500/70 mt-1">T H E A T R I C A L &nbsp; S T A G E</p>
        </div>

        <div class="text-center fade-in fade-delay-2">
            <h2 class="font-serif text-2xl font-semibold text-ivory-100">Verify your account</h2>
            <p class="mt-4 font-garamond italic text-ivory-300/70">
                We sent a 4-digit code to<br>
                <span class="text-gold-400 not-italic font-medium">@Model.Email</span>
            </p>
        </div>

        @if (TempData["EmailError"] != null)
        {
            <div class="fade-in fade-delay-2 bg-burgundy-500/15 border border-burgundy-400/30 rounded-sm px-4 py-3 text-burgundy-200 font-garamond italic text-center">
                @TempData["EmailError"]
            </div>
        }
        @if (TempData["ResendSuccess"] != null)
        {
            <div class="fade-in fade-delay-2 bg-gold-400/10 border border-gold-400/30 rounded-sm px-4 py-3 text-gold-400 font-garamond italic text-center">
                @TempData["ResendSuccess"]
            </div>
        }

        <form class="space-y-6 fade-in fade-delay-3" asp-action="ConfirmEmail" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-burgundy-200 list-disc pl-5 text-sm font-garamond italic"></div>
            <input type="hidden" asp-for="Email" />

            <div>
                <label asp-for="Code" class="sr-only">Verification code</label>
                <input asp-for="Code"
                       class="code-input w-full px-4 py-4 rounded-sm text-center text-3xl tracking-[1rem]"
                       placeholder="----"
                       maxlength="4"
                       autofocus />
                <span asp-validation-for="Code" class="text-burgundy-200 text-xs pt-1 block font-garamond italic"></span>
            </div>

            <div class="fade-in fade-delay-4">
                <button type="submit" class="btn-gold w-full justify-center">Verify account</button>
            </div>
        </form>

        <form class="fade-in fade-delay-4 text-center" asp-action="ResendCode" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="font-garamond italic text-ivory-300/70 hover:text-gold-400 transition-colors">
                Didn't get the code? <span class="text-gold-400 underline underline-offset-2">Resend</span>
            </button>
        </form>

        <form class="fade-in fade-delay-4 text-center" asp-action="SkipVerification" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="text-[11px] font-sans tracking-widest uppercase text-gold-500/60 hover:text-gold-400 transition-colors">
                Skip for now
            </button>
        </form>
    </div>
</div>
