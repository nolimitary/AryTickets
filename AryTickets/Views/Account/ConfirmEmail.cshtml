@model ConfirmEmailViewModel
@{
    ViewData["Title"] = "Verify Your Account";
    Layout = "_Layout";
}

@section Styles {
    <style>
        @@keyframes fadeUpBlur {
            from {
                opacity: 0;
                transform: translateY(24px);
                filter: blur(6px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
                filter: blur(0);
            }
        }

        .fade-in {
            animation: fadeUpBlur 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        .fade-delay-1 { animation-delay: 0.1s; opacity: 0; }
        .fade-delay-2 { animation-delay: 0.25s; opacity: 0; }
        .fade-delay-3 { animation-delay: 0.4s; opacity: 0; }
        .fade-delay-4 { animation-delay: 0.55s; opacity: 0; }
    </style>
}

<div class="min-h-screen flex items-center justify-center px-4 py-12 bg-surface-400">
    <div class="max-w-md w-full bg-surface-200 border border-white/[0.06] rounded-2xl p-10 space-y-8">

        <!-- Logo -->
        <div class="text-center fade-in fade-delay-1">
            <span class="text-3xl font-bold">
                <span class="text-white">Ary</span><span class="text-accent-500">Tix</span>
            </span>
        </div>

        <!-- Title -->
        <div class="text-center fade-in fade-delay-2">
            <h2 class="text-2xl font-bold text-white">
                Verify Your Account
            </h2>
            <p class="mt-4 text-sm text-zinc-400">
                A 4-digit code was sent to
                <span class="text-white font-medium">@Model.Email</span>
            </p>
        </div>

        <!-- Form -->
        <form class="space-y-6 fade-in fade-delay-3" asp-action="ConfirmEmail" method="post">
            <div asp-validation-summary="All" class="text-red-400 list-disc pl-5 text-sm"></div>
            <input type="hidden" asp-for="Email" />

            <div>
                <label asp-for="Code" class="sr-only">Verification Code</label>
                <input asp-for="Code"
                       class="w-full px-4 py-4 rounded-lg bg-surface-300 border border-white/[0.08] text-center text-2xl text-white tracking-[1rem] placeholder-zinc-600 outline-none focus:border-accent-500/40 transition-colors duration-300"
                       placeholder="----"
                       maxlength="4"
                       autofocus />
                <span asp-validation-for="Code" class="text-red-400 text-xs pt-1 block"></span>
            </div>

            <div class="fade-in fade-delay-4">
                <button type="submit"
                        class="w-full py-3 px-4 rounded-lg text-sm font-semibold tracking-wide uppercase bg-accent-500 text-white hover:bg-accent-600 transition-all duration-300">
                    Verify Account
                </button>
            </div>
        </form>
    </div>
</div>
