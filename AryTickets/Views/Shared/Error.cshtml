@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>500 · Error | AryTix</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Cormorant Garamond', Georgia, serif;
            background-color: #1a0606;
            background-image:
                radial-gradient(ellipse at 50% 20%, rgba(139, 26, 26, 0.3) 0%, transparent 60%),
                radial-gradient(ellipse at 80% 100%, rgba(212, 175, 55, 0.08) 0%, transparent 50%);
            color: #f5e6d3;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .err-card {
            max-width: 480px;
            width: 100%;
            text-align: center;
            background: rgba(43, 10, 10, 0.78);
            border: 1px solid rgba(212, 175, 55, 0.22);
            border-radius: 4px;
            padding: 56px 40px;
            backdrop-filter: blur(16px);
            box-shadow: 0 24px 48px rgba(0,0,0,0.5);
        }
        .logo { font-family: 'Playfair Display', serif; font-size: 28px; letter-spacing: 0.08em; margin-bottom: 8px; }
        .logo .a { color: #f5e6d3; font-weight: 600; }
        .logo .b { color: #d4af37; font-style: italic; font-weight: 400; }
        .sub { font-family: 'Inter', sans-serif; font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; color: rgba(212,175,55,0.7); margin-bottom: 36px; }
        .code { font-family: 'Playfair Display', serif; font-size: 96px; line-height: 1; font-weight: 600; color: #d4af37; margin-bottom: 8px; }
        .title { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 600; color: #f5e6d3; margin-bottom: 12px; }
        .desc { font-style: italic; color: rgba(245, 230, 211, 0.7); line-height: 1.6; margin-bottom: 32px; }
        .btn {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 14px 32px;
            background: linear-gradient(135deg, #d4af37 0%, #b8860b 100%);
            color: #1a0606;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            border: 1px solid rgba(212, 175, 55, 0.45);
            border-radius: 2px;
            text-decoration: none;
            transition: all 0.3s;
        }
        .btn:hover { background: linear-gradient(135deg, #e6c45a 0%, #d4af37 100%); }
        .req-id { font-family: 'Inter', monospace; font-size: 11px; color: rgba(212,175,55,0.6); margin-bottom: 24px; padding: 6px 12px; display: inline-block; background: rgba(26,6,6,0.7); border-radius: 2px; }
        .copy { font-family: 'Inter', sans-serif; font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(212,175,55,0.5); margin-top: 32px; }
    </style>
</head>
<body>
    <div class="err-card">
        <div class="logo"><span class="a">Ary</span><span class="b">Tix</span></div>
        <div class="sub">T H E A T R I C A L &nbsp; S T A G E</div>
        <p class="code">500</p>
        <h1 class="title">Something went wrong</h1>
        <p class="desc">An unexpected error occurred. Please try again later or return to the home page.</p>
        @if (Model?.ShowRequestId ?? false)
        {
            <p class="req-id">Request ID: @Model.RequestId</p><br>
        }
        <a href="/" class="btn">Back to home</a>
        <p class="copy">&copy; @DateTime.Now.Year · AryTix</p>
    </div>
</body>
</html>
