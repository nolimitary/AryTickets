@{
    var active = (ViewContext.RouteData.Values["action"] as string ?? "").ToLowerInvariant();
}
<aside class="admin-sidebar">
    <div class="px-6 mb-8">
        <div class="flex items-center gap-2.5">
            <span class="w-2 h-2 rounded-full bg-gold-400 animate-pulse"></span>
            <span class="font-serif text-[16px] font-semibold text-ivory-100 tracking-tight">Администрация</span>
        </div>
        <p class="text-[10px] font-sans tracking-[0.25em] uppercase text-gold-500/60 mt-1 pl-[18px]">Театрална сцена</p>
    </div>

    <nav class="flex flex-col gap-1">
        <a href="/Admin" class="admin-nav-link @(active == "index" ? "active" : "")">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
            Табло
        </a>
        <a href="/Admin/Productions" class="admin-nav-link @(active == "productions" || active == "createproduction" || active == "editproduction" ? "active" : "")">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h12A2.25 2.25 0 0120.25 6v12A2.25 2.25 0 0118 20.25H6A2.25 2.25 0 013.75 18V6zM7.5 8.25h9M7.5 12h9M7.5 15.75h6"/></svg>
            Постановки
        </a>
        <a href="/Admin/Performances" class="admin-nav-link @(active == "performances" ? "active" : "")">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Представления
        </a>
        <a href="/Admin/Users" class="admin-nav-link @(active == "users" ? "active" : "")">
            <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
