@using Microsoft.AspNetCore.Identity
@using AryTickets.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AryTix</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        accent: {
                            50: '#fff1f2',
                            100: '#ffe4e6',
                            200: '#fecdd3',
                            300: '#fda4af',
                            400: '#fb7185',
                            500: '#e11d48',
                            600: '#be123c',
                            700: '#9f1239',
                        },
                        surface: {
                            50: '#27272a',
                            100: '#1c1c1f',
                            200: '#141416',
                            300: '#0c0c0e',
                            400: '#09090b',
                        }
                    },
                    fontFamily: {
                        sans: ['Outfit', 'system-ui', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    @await RenderSectionAsync("Styles", required: false)
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Outfit', system-ui, sans-serif;
            background-color: #09090b;
            color: #e4e4e7;
            overflow-x: hidden;
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #09090b; }
        ::-webkit-scrollbar-thumb { background: #e11d48; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #fb7185; }

        ::selection { background: rgba(225, 29, 72, 0.3); color: #fff; }
        html { scroll-behavior: smooth; }

        .nav-blur {
            background: rgba(9, 9, 11, 0.5);
            backdrop-filter: blur(0px);
            transition: all 0.4s ease;
            border-bottom: 1px solid transparent;
        }
        .nav-blur.scrolled {
            background: rgba(9, 9, 11, 0.9);
            backdrop-filter: blur(24px);
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .dd-panel {
            opacity: 0;
            transform: translateY(-6px) scale(0.98);
            pointer-events: none;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .dd-panel.open {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: auto;
        }
    </style>
</head>
<body class="bg-surface-400 text-zinc-200">

    <header id="navbar" class="nav-blur fixed top-0 left-0 right-0 z-50">
        <nav class="max-w-[1360px] mx-auto px-6 py-4 flex justify-between items-center">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center gap-0.5">
                <span class="text-[22px] font-bold text-white">Ary</span>
                <span class="text-[22px] font-light text-accent-500">Tix</span>
            </a>

            <div class="hidden md:flex items-center gap-8">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="text-sm text-zinc-400 hover:text-white transition-colors">Home</a>
                <a href="#now-showing" class="text-sm text-zinc-400 hover:text-white transition-colors">Now Showing</a>
                <a href="#coming-soon" class="text-sm text-zinc-400 hover:text-white transition-colors">Coming Soon</a>
            </div>

            <div class="flex items-center gap-4">
                <div class="relative" id="regionDropdownContainer">
                    <button id="regionDropdownButton" class="flex items-center gap-1.5 text-sm text-zinc-500 hover:text-white transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" /></svg>
                        <span id="currentRegionText">@ViewData["CurrentRegion"]</span>
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
                    </button>
                    <div id="regionDropdownMenu" class="dd-panel absolute right-0 mt-2.5 w-44 bg-surface-100 border border-white/[0.06] rounded-xl shadow-2xl overflow-hidden">
                        <a href="/Home/Index?region=US" class="block px-4 py-2.5 text-sm text-zinc-400 hover:text-white hover:bg-white/[0.04] transition-all">United States</a>
                        <a href="/Home/Index?region=GB" class="block px-4 py-2.5 text-sm text-zinc-400 hover:text-white hover:bg-white/[0.04] transition-all">United Kingdom</a>
                        <a href="/Home/Index?region=CA" class="block px-4 py-2.5 text-sm text-zinc-400 hover:text-white hover:bg-white/[0.04] transition-all">Canada</a>
                        <a href="/Home/Index?region=AU" class="block px-4 py-2.5 text-sm text-zinc-400 hover:text-white hover:bg-white/[0.04] transition-all">Australia</a>
                    </div>
                </div>

                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="relative" id="userDropdownContainer">
                        <button id="userDropdownButton" class="w-8 h-8 rounded-full bg-accent-500/10 border border-accent-500/20 flex items-center justify-center hover:bg-accent-500/20 transition-all">
                            <svg class="w-4 h-4 text-accent-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd"></path></svg>
                        </button>
                        <div id="userDropdownMenu" class="dd-panel absolute right-0 mt-2.5 w-52 bg-surface-100 border border-white/[0.06] rounded-xl shadow-2xl overflow-hidden">
                            <div class="px-4 py-3 border-b border-white/[0.06]">
                                <p class="text-[11px] text-zinc-500 mb-0.5">Signed in as</p>
                                <p class="text-sm text-white truncate">@User.Identity?.Name</p>
                            </div>
                            <a asp-controller="Profile" asp-action="Index" class="block px-4 py-2.5 text-sm text-zinc-400 hover:text-white hover:bg-white/[0.04] transition-all">My Profile</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Admin" asp-action="Index" class="block px-4 py-2.5 text-sm text-accent-400 hover:text-accent-300 hover:bg-accent-500/5 transition-all">Admin Panel</a>
                            }
                            <form class="w-full" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="w-full text-left px-4 py-2.5 text-sm text-zinc-400 hover:text-white hover:bg-white/[0.04] transition-all">Sign out</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login"
                       class="text-sm font-medium bg-accent-500 text-white px-5 py-2 rounded-lg hover:bg-accent-600 transition-all duration-200">
                        Sign In
                    </a>
                }
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="border-t border-white/[0.04] mt-24">
        <div class="max-w-[1360px] mx-auto px-6 py-14">
            <div class="grid md:grid-cols-3 gap-10 items-start">
                <div>
                    <div class="flex items-center gap-0.5 mb-3">
                        <span class="text-lg font-bold text-white">Ary</span>
                        <span class="text-lg font-light text-accent-500">Tix</span>
                    </div>
                    <p class="text-sm text-zinc-500 leading-relaxed max-w-xs">
                        Your go-to platform for discovering and booking the latest films.
                    </p>
                </div>
                <div class="flex flex-col gap-2.5">
                    <span class="text-xs font-medium text-zinc-500 uppercase tracking-wider mb-1">Navigate</span>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="text-sm text-zinc-500 hover:text-white transition-colors">Home</a>
                    <a href="#now-showing" class="text-sm text-zinc-500 hover:text-white transition-colors">Now Showing</a>
                    <a href="#coming-soon" class="text-sm text-zinc-500 hover:text-white transition-colors">Coming Soon</a>
                </div>
                <div class="flex flex-col gap-2.5">
                    <span class="text-xs font-medium text-zinc-500 uppercase tracking-wider mb-1">Legal</span>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-sm text-zinc-500 hover:text-white transition-colors">Privacy Policy</a>
                    <a href="#" class="text-sm text-zinc-500 hover:text-white transition-colors">Terms of Service</a>
                </div>
            </div>
            <div class="mt-12 pt-6 border-t border-white/[0.04] text-center">
                <p class="text-xs text-zinc-600">&copy; @DateTime.Now.Year AryTix. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        window.addEventListener('scroll', function () {
            const n = document.getElementById('navbar');
            if (window.scrollY > 50) n.classList.add('scrolled');
            else n.classList.remove('scrolled');
        });
        function setupDropdown(cId, bId, mId) {
            const c = document.getElementById(cId), b = document.getElementById(bId), m = document.getElementById(mId);
            if (!c || !b || !m) return;
            b.addEventListener('click', e => { e.stopPropagation(); m.classList.toggle('open'); });
            window.addEventListener('click', e => { if (!c.contains(e.target)) m.classList.remove('open'); });
        }
        setupDropdown('regionDropdownContainer', 'regionDropdownButton', 'regionDropdownMenu');
        setupDropdown('userDropdownContainer', 'userDropdownButton', 'userDropdownMenu');
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>