@model AryTickets.Models.Production
@using Microsoft.AspNetCore.Identity
@using AryTickets.Models
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = Model.Title;
    var castList = !string.IsNullOrWhiteSpace(Model.Cast)
        ? Model.Cast.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList()
        : new List<string>();
}

@section Styles {
    <style>
        .prod-hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: flex-end;
            padding-bottom: 4rem;
            padding-top: 8rem;
            overflow: hidden;
        }
        .prod-hero-bg {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center top;
            animation: stageSway 55s ease-in-out infinite alternate;
            will-change: transform;
            filter: saturate(0.95) contrast(1.05);
        }
        @@keyframes stageSway {
            0%   { transform: scale(1.1) translate(1%, -1%); }
            100% { transform: scale(1.18) translate(-1%, 1%); }
        }

        .prod-vignette {
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse at 60% 30%, transparent 0%, rgba(26,6,6,0.55) 55%, #1a0606 100%),
                linear-gradient(to top, #1a0606 0%, transparent 50%),
                linear-gradient(to right, rgba(26,6,6,0.88) 0%, transparent 65%);
            z-index: 2;
        }

        .hero-glass {
            background: rgba(43, 10, 10, 0.78);
            backdrop-filter: blur(28px) saturate(1.3);
            -webkit-backdrop-filter: blur(28px) saturate(1.3);
            border: 1px solid rgba(212,175,55,0.22);
            border-radius: 4px;
            padding: 2.5rem;
            box-shadow: 0 24px 48px rgba(0,0,0,0.5);
        }

        .prod-poster {
            border-radius: 4px;
            box-shadow:
                0 24px 70px rgba(0,0,0,0.65),
                0 0 0 1px rgba(212,175,55,0.25);
            transition: transform 0.5s cubic-bezier(.22,.61,.36,1), box-shadow 0.5s ease;
        }
        .prod-poster:hover {
            transform: translateY(-6px);
            box-shadow:
                0 36px 90px rgba(0,0,0,0.75),
                0 0 0 1px rgba(212,175,55,0.5);
        }

        .rating-ring {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            background: conic-gradient(#d4af37 @Model.RatingPercentage, rgba(212,175,55,0.12) 0);
            flex-shrink: 0;
        }
        .rating-ring-inner {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            background: #1a0606;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .performance-pill {
            border: 1px solid rgba(212,175,55,0.3);
            color: #f5e6d3;
            font-family: 'Inter', sans-serif;
            font-weight: 500;
            padding: 0.7rem 1.4rem;
            border-radius: 2px;
            transition: all 0.3s ease;
            text-decoration: none;
            font-size: 0.85rem;
            letter-spacing: 0.06em;
            background: transparent;
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            line-height: 1;
        }
        .performance-pill:hover {
            background: linear-gradient(135deg, #d4af37 0%, #b8860b 100%);
            border-color: #d4af37;
            color: #1a0606;
            box-shadow: 0 0 24px rgba(212,175,55,0.25);
        }
        .performance-pill .time { font-weight: 600; }
        .performance-pill .stage {
            font-size: 11px;
            opacity: 0.7;
            font-style: italic;
            font-family: 'Cormorant Garamond', serif;
        }
        .performance-pill .price {
            font-size: 12px;
            color: #d4af37;
            font-weight: 600;
        }
        .performance-pill:hover .stage,
        .performance-pill:hover .price { color: #1a0606; opacity: 0.9; }

        .cast-card {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.25rem;
            border-radius: 4px;
            background: rgba(43, 10, 10, 0.7);
            border: 1px solid rgba(212,175,55,0.12);
            transition: border-color 0.4s, transform 0.4s, box-shadow 0.4s;
        }
        .cast-card:hover {
            border-color: rgba(212,175,55,0.4);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
        }
        .cast-initial {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: linear-gradient(135deg, #8b1a1a 0%, #3d1414 100%);
            border: 1px solid rgba(212,175,55,0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            font-size: 18px;
            color: #d4af37;
            flex-shrink: 0;
        }

        .review-card {
            background: rgba(43, 10, 10, 0.5);
            border: 1px solid rgba(212,175,55,0.12);
            border-radius: 4px;
            padding: 1.75rem;
            transition: border-color 0.3s ease, transform 0.3s ease;
        }
        .review-card:hover {
            border-color: rgba(212,175,55,0.3);
        }

        .reviews-placeholder {
            text-align: center;
            padding: 3.5rem 2rem;
            background: rgba(43, 10, 10, 0.5);
            border: 1px dashed rgba(212,175,55,0.18);
            border-radius: 4px;
        }

        .trailer-modal {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.92);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 100;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.4s ease;
        }
        .trailer-modal.active {
            opacity: 1;
            pointer-events: auto;
        }
        .trailer-modal-content {
            position: relative;
            width: 90%;
            max-width: 960px;
            aspect-ratio: 16 / 9;
        }
        .close-modal {
            position: absolute;
            top: -52px;
            right: 0;
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(212,175,55,0.35);
            border-radius: 50%;
            color: #d4af37;
            font-size: 1.4rem;
            cursor: pointer;
            transition: all 0.3s ease;
            background: rgba(26,6,6,0.95);
        }
        .close-modal:hover {
            background: #d4af37;
            color: #1a0606;
        }

        .action-circle {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(212,175,55,0.25);
            background: rgba(43, 10, 10, 0.6);
            color: #c9a961;
            transition: all 0.3s ease;
        }
        .action-circle:hover {
            background: rgba(212,175,55,0.12);
            border-color: rgba(212,175,55,0.5);
            color: #d4af37;
        }
        .action-circle-active {
            background: linear-gradient(135deg, #d4af37 0%, #b8860b 100%);
            color: #1a0606;
            border-color: #d4af37;
        }
        .action-circle-active:hover {
            background: linear-gradient(135deg, #e6c45a 0%, #d4af37 100%);
            color: #1a0606;
        }

        .label-gold {
            font-family: 'Inter', sans-serif;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: #d4af37;
        }

        .gold-rule {
            height: 1px;
            width: 64px;
            background: linear-gradient(90deg, #d4af37, transparent);
            margin-bottom: 1rem;
            display: block;
        }
    </style>
}

<!-- ═══ HERO ═══ -->
<div class="prod-hero">
    <div class="prod-hero-bg" style="background-image: url('@Model.FullBackdropUrl');"></div>
    <div class="prod-vignette"></div>

    <div class="relative z-10 w-full px-6 lg:px-16">
        <div class="max-w-7xl mx-auto">
            <div class="grid md:grid-cols-12 gap-10 items-end">
                <div class="md:col-span-3 reveal-up">
                    <img src="@Model.FullPosterUrl" alt="Poster: @Model.Title" class="prod-poster w-full max-w-[280px] mx-auto md:mx-0" />
                </div>

                <div class="md:col-span-9 reveal-up">
                    <div class="hero-glass">
                        <span class="label-gold mb-3 block">@Model.Genre</span>
                        <h1 class="font-serif font-semibold text-ivory-100 text-4xl sm:text-5xl lg:text-6xl leading-[1.05] mb-3 tracking-tight">
                            @Model.Title
                        </h1>
                        @if (!string.IsNullOrEmpty(Model.TitleOriginal) && Model.TitleOriginal != Model.Title)
                        {
                            <p class="font-garamond italic text-ivory-300/60 text-lg mb-3">„@Model.TitleOriginal“</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.Playwright))
                        {
                            <p class="font-garamond italic text-gold-400 text-xl mb-5">by @Model.Playwright</p>
                        }

                        <div class="flex items-center flex-wrap gap-4 text-[15px] font-garamond text-ivory-200/80 mb-7">
                            <span>@Model.FormattedDuration</span>
                            @if (!string.IsNullOrEmpty(Model.Director))
                            {
                                <span class="text-gold-500/30">•</span>
                                <span class="italic">Directed by <span class="text-ivory-100">@Model.Director</span></span>
                            }
                            <span class="text-gold-500/30">•</span>
                            <span>Premiered @Model.FormattedPremiere</span>
                        </div>

                        <div class="flex items-center gap-6 mb-9">
                            <div class="rating-ring" title="@Model.RatingPercentage rating">
                                <div class="rating-ring-inner">
                                    <span class="text-ivory-100 font-serif font-semibold text-base">@Model.Rating.ToString("F1")</span>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.TrailerUrl))
                            {
                                <button id="playTrailerBtn"
                                        class="flex items-center gap-2 text-ivory-200/70 hover:text-gold-400 transition-colors duration-300 font-sans font-medium text-[13px] tracking-[0.18em] uppercase">
                                    <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
                                    </svg>
                                    <span>Watch trailer</span>
                                </button>
                            }
                        </div>

                        <div class="mb-9">
                            <span class="gold-rule"></span>
                            <span class="label-gold mb-3 block">Synopsis</span>
                            <p class="font-garamond text-ivory-200/85 text-[17px] leading-relaxed max-w-3xl">@Model.Synopsis</p>
                        </div>

                        <div class="flex items-center gap-3 mb-10">
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <form asp-controller="UserFavorites" asp-action="ToggleFavorite" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productionId" value="@Model.Id" />
                                    <input type="hidden" name="productionTitle" value="@Model.Title" />
                                    <input type="hidden" name="posterUrl" value="@Model.PosterUrl" />
                                    @if ((bool)ViewData["IsFavorite"])
                                    {
                                        <button type="submit" class="action-circle action-circle-active" title="Remove from favorites">
                                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                                            </svg>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="action-circle" title="Add to favorites">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                                            </svg>
                                        </button>
                                    }
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Register" class="action-circle" title="Add to favorites">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                                    </svg>
                                </a>
                            }

                            <button id="share-btn" class="action-circle" title="Share">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
                                </svg>
                            </button>
                            <span id="share-toast" class="text-xs text-gold-400 opacity-0 transition-opacity duration-300 ml-1 font-garamond italic">Link copied!</span>
                        </div>

                        <div>
                            <span class="gold-rule"></span>
                            <span class="label-gold mb-4 block">Choose a performance</span>
                            @{
                                var performances = ViewData["Performances"] as List<AryTickets.Models.Performance>;
                            }
                            @if (performances != null && performances.Any())
                            {
                                var groupedByDate = performances.GroupBy(p => p.ShowDateTime.Date).OrderBy(g => g.Key).ToList();
                                var visibleCount = 2;
                                var hasMore = groupedByDate.Count > visibleCount;
                                <div class="space-y-5">
                                    @for (int gi = 0; gi < groupedByDate.Count; gi++)
                                    {
                                        var dateGroup = groupedByDate[gi];
                                        var hiddenClass = gi >= visibleCount ? "performance-extra hidden" : "";
                                        <div class="@hiddenClass">
                                            <p class="text-sm font-garamond italic text-gold-500/80 mb-2.5">@dateGroup.Key.ToString("dddd, dd MMMM")</p>
                                            <div class="flex flex-wrap gap-2.5">
                                                @foreach (var p in dateGroup.OrderBy(p => p.ShowDateTime))
                                                {
                                                    if (SignInManager.IsSignedIn(User))
                                                    {
                                                        <a asp-controller="Booking" asp-action="SelectSeats" asp-route-performanceId="@p.Id" class="performance-pill">
                                                            <span class="time">@p.FormattedTime</span>
                                                            <span class="stage">· @p.Stage</span>
                                                            <span class="price">· @p.Price.ToString("F2") BGN</span>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <a asp-controller="Account" asp-action="Login" class="performance-pill">
                                                            <span class="time">@p.FormattedTime</span>
                                                            <span class="stage">· @p.Stage</span>
                                                        </a>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                @if (hasMore)
                                {
                                    <button id="show-more-performances" class="mt-4 w-full text-center text-[11px] tracking-[0.25em] uppercase font-sans text-gold-400 hover:text-gold-300 transition-colors py-2.5 border border-gold-500/20 hover:border-gold-400/50 hover:bg-gold-400/5 rounded-sm">
                                        Show @(groupedByDate.Count - visibleCount) more day@(groupedByDate.Count - visibleCount == 1 ? "" : "s")
                                    </button>
                                }
                            }
                            else
                            {
                                <div class="text-center py-7 border border-dashed border-gold-500/15 rounded-sm">
                                    <p class="font-garamond italic text-ivory-300/60">No performances scheduled at the moment.</p>
                                    <p class="text-[12px] font-sans tracking-widest uppercase text-gold-500/60 mt-2">New dates coming soon</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══ CAST ═══ -->
@if (castList.Any())
{
    <section class="py-20 px-6 lg:px-16">
        <div class="max-w-7xl mx-auto">
            <span class="gold-rule"></span>
            <span class="label-gold">Ensemble</span>
            <h2 class="font-serif font-semibold text-ivory-100 text-3xl md:text-4xl mt-2 mb-10">Cast</h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var actor in castList.Take(9))
                {
                    var initials = string.Join("", actor.Split(' ').Where(s => s.Length > 0).Take(2).Select(s => s[0]));
                    <div class="cast-card">
                        <div class="cast-initial">@initials</div>
                        <div>
                            <p class="font-serif text-ivory-100 text-[17px]">@actor</p>
                            <p class="text-[11px] font-sans uppercase tracking-[0.2em] text-gold-500/70 mt-0.5">Actor</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ═══ REVIEWS ═══ -->
<section class="py-20 px-6 lg:px-16">
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4 mb-12">
            <div>
                <span class="gold-rule"></span>
                <span class="label-gold">Audience & critics</span>
                <h2 class="font-serif font-semibold text-ivory-100 text-3xl md:text-4xl mt-2">Reviews</h2>
            </div>
            @if (SignInManager.IsSignedIn(User))
            {
                <a href="#write-review" class="btn-gold">Write a review</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Register" class="btn-gold">Write a review</a>
            }
        </div>

        @{
            var userReviews = ViewData["UserReviews"] as List<UserReview>;
        }
        @if (userReviews != null && userReviews.Any())
        {
            <div class="mb-10 space-y-5">
                @foreach (var r in userReviews)
                {
                    <div class="review-card">
                        <div class="flex items-center gap-3 mb-3">
                            <h4 class="font-serif font-semibold text-ivory-100 text-lg">@r.UserName</h4>
                            @if (r.IsCritic)
                            {
                                <span class="text-[10px] font-sans font-medium tracking-widest uppercase px-2.5 py-0.5 rounded-sm bg-gold-400/15 text-gold-400 border border-gold-400/30">Critic</span>
                            }
                            <span class="text-xs font-serif px-2.5 py-0.5 rounded-sm bg-burgundy-700/40 text-gold-300 border border-gold-500/25">
                                @r.Rating / 10
                            </span>
                        </div>
                        <p class="font-garamond text-ivory-200/85 text-[16px] leading-relaxed">@r.Content</p>
                        <p class="text-xs font-sans text-gold-500/60 mt-3 tracking-wide">@r.CreatedAt.ToString("dd MMM yyyy")</p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="reviews-placeholder mb-10">
                <h3 class="font-serif text-ivory-100 text-2xl mb-2">No reviews yet</h3>
                <p class="font-garamond italic text-ivory-300/60">Be the first to share your impressions of this production.</p>
            </div>
        }

        @if (SignInManager.IsSignedIn(User) && !(bool)(ViewData["HasReviewed"] ?? false))
        {
            <div id="write-review">
                <span class="gold-rule"></span>
                <span class="label-gold mb-4 block">Share your impressions</span>
                <div class="review-card">
                    <form asp-controller="Production" asp-action="SubmitReview" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productionId" value="@Model.Id" />
                        <input type="hidden" name="productionTitle" value="@Model.Title" />

                        <div class="mb-5">
                            <label class="block text-[13px] font-sans tracking-wider uppercase text-gold-400 mb-2.5">Rating</label>
                            <select name="rating" required class="bg-burgundy-950 border border-gold-500/25 text-ivory-100 font-garamond text-base rounded-sm px-4 py-2.5 focus:border-gold-400/60 focus:outline-none w-full max-w-[220px] appearance-none">
                                <option value="" disabled selected>Select a rating</option>
                                @for (int i = 1; i <= 10; i++)
                                {
                                    <option value="@i">@i / 10</option>
                                }
                            </select>
                        </div>

                        <div class="mb-5">
                            <label class="block text-[13px] font-sans tracking-wider uppercase text-gold-400 mb-2.5">Your review</label>
                            <textarea name="content" required rows="5" placeholder="What did you think of the production?"
                                      class="w-full bg-burgundy-950 border border-gold-500/25 text-ivory-100 font-garamond text-base rounded-sm px-4 py-3 focus:border-gold-400/60 focus:outline-none placeholder-ivory-300/40 resize-none"></textarea>
                        </div>

                        <button type="submit" class="btn-gold">
                            Submit review
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</section>

@if (!string.IsNullOrEmpty(Model.TrailerUrl))
{
    <div id="trailerModal" class="trailer-modal">
        <div class="trailer-modal-content">
            <span id="closeModalBtn" class="close-modal">&times;</span>
            <iframe id="youtube-player"
                    class="w-full h-full rounded-sm"
                    src=""
                    title="Trailer"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
        </div>
    </div>
}

@section Scripts {
    <script>
        function revealDetails() {
            document.querySelectorAll('.reveal-up').forEach(el => {
                const top = el.getBoundingClientRect().top;
                if (top < window.innerHeight - 100 && !el.classList.contains('active')) {
                    el.classList.add('active');
                    el.style.opacity = '1';
                    el.style.transform = 'translateY(0)';
                }
            });
        }
        document.querySelectorAll('.reveal-up').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(28px)';
            el.style.transition = 'opacity 0.9s ease, transform 0.9s ease';
        });
        window.addEventListener('scroll', revealDetails);
        document.addEventListener('DOMContentLoaded', revealDetails);

        const playTrailerBtn = document.getElementById('playTrailerBtn');
        const trailerModal = document.getElementById('trailerModal');
        const closeModalBtn = document.getElementById('closeModalBtn');
        const player = document.getElementById('youtube-player');
        const trailerUrl = "@Model.TrailerUrl";

        if (playTrailerBtn) {
            playTrailerBtn.addEventListener('click', () => {
                player.src = trailerUrl;
                trailerModal.classList.add('active');
            });
        }
        if (closeModalBtn) {
            const stopVideo = () => {
                trailerModal.classList.remove('active');
                player.src = "";
            };
            closeModalBtn.addEventListener('click', stopVideo);
            trailerModal.addEventListener('click', e => { if (e.target === trailerModal) stopVideo(); });
        }

        const shareBtn = document.getElementById('share-btn');
        const shareToast = document.getElementById('share-toast');
        if (shareBtn) {
            shareBtn.addEventListener('click', () => {
                navigator.clipboard.writeText(window.location.href).then(() => {
                    shareToast.style.opacity = '1';
                    setTimeout(() => shareToast.style.opacity = '0', 2000);
                });
            });
        }

        const showMoreBtn = document.getElementById('show-more-performances');
        if (showMoreBtn) {
            let expanded = false;
            const originalText = showMoreBtn.textContent.trim();
            showMoreBtn.addEventListener('click', () => {
                expanded = !expanded;
                document.querySelectorAll('.performance-extra').forEach(el => {
                    el.classList.toggle('hidden', !expanded);
                });
                showMoreBtn.textContent = expanded ? 'Hide' : originalText;
            });
        }
    </script>
}
